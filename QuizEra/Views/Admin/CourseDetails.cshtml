@model QuizEra.BLL.ModelVM.Course.CourseVM

@{
    ViewData["Title"] = "Course Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">

    <!-- Navigation -->
    <div class="mb-4 d-flex gap-2">

        <a asp-controller="Admin"
           asp-action="Courses"
           class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i>
            Back to Courses
        </a>

        @if (!Model.IsDeleted)
        {
            <a asp-controller="Admin"
               asp-action="EditCourse"
               asp-route-id="@Model.Id"
               class="btn btn-outline-primary btn-sm">
                <i class="fa-solid fa-pen-to-square me-1"></i>
                Edit Course
            </a>
        }

    </div>

    <div class="card border-0 shadow-sm rounded-3">

        <div class="card-body p-4 p-md-5">

            <div class="d-flex justify-content-between align-items-start mb-4">

                <div>
                    <span class="badge bg-primary bg-opacity-10 text-primary mb-3">
                        <i class="fa-solid fa-book me-1"></i>
                        Course
                    </span>

                    <h2 class="fw-bold mb-2">
                        @Model.CourseName
                    </h2>

                    <span class="badge bg-light text-dark border">
                        Code: @Model.CourseCode
                    </span>
                </div>

                @if (Model.IsDeleted)
                {
                    <span class="badge bg-danger fs-6">
                        <i class="fa-solid fa-trash-can me-1"></i>
                        Deleted
                    </span>
                }
                else
                {
                    <span class="badge bg-success fs-6">
                        <i class="fa-solid fa-circle-check me-1"></i>
                        Active
                    </span>
                }

            </div>

            <hr />

            <div class="row g-4 mt-2">

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted d-block mb-1">
                            Course Level
                        </small>

                        <span class="fw-semibold">
                            @Model.CourseLevel
                        </span>
                    </div>
                </div>

                <div class="col-md-8">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted d-block mb-1">
                            Course Code
                        </small>

                        <span class="fw-semibold">
                            @Model.CourseCode
                        </span>
                    </div>
                </div>

                <div class="col-12">
                    <div class="p-3 bg-light rounded-3">
                        <small class="text-muted d-block mb-2">
                            Description
                        </small>

                        <p class="mb-0">
                            @(string.IsNullOrWhiteSpace(Model.CourseDescription)
                                ? "No description available."
                                : Model.CourseDescription)
                        </p>
                    </div>
                </div>

            </div>

            <div class="mt-4 d-flex justify-content-end">

                @if (Model.IsDeleted)
                {
                    <form asp-controller="Admin"
                          asp-action="RestoreCourse"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-success">
                            <i class="fa-solid fa-trash-arrow-up me-1"></i>
                            Restore Course
                        </button>

                    </form>
                }
                else
                {
                    <form asp-controller="Admin"
                          asp-action="DeleteCourse"
                          asp-route-id="@Model.Id"
                          method="post"
                          onsubmit="return confirm('Are you sure you want to delete this course?');">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="btn btn-outline-danger">
                            <i class="fa-solid fa-trash-can me-1"></i>
                            Delete Course
                        </button>

                    </form>
                }

            </div>

        </div>
    </div>

</div>
