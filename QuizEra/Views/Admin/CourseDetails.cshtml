@model QuizEra.BLL.ModelVM.Course.CourseVM

@{
    ViewData["Title"] = "Course Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    :root {
        --qz-purple: #4D2197;
        --qz-dark-text: #1B2559;
        --qz-sub-text: #707EAE;
        --qz-bg-light: #F4F7FE;
        --qz-border-color: #E9EFFC;
    }

    .qz-admin-card {
        background: #FFFFFF;
        border-radius: 16px;
        padding: 30px;
        border: 1px solid var(--qz-border-color);
        box-shadow: 0px 10px 30px rgba(112, 144, 176, 0.08);
    }

    .qz-header-title {
        color: var(--qz-dark-text);
        font-weight: 800;
        font-size: 1.6rem;
    }

    .qz-detail-item {
        background-color: var(--qz-bg-light);
        border-radius: 12px;
        padding: 16px;
        height: 100%;
    }

    .qz-detail-label {
        color: var(--qz-sub-text);
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 6px;
        display: block;
    }

    .qz-detail-value {
        color: var(--qz-dark-text);
        font-weight: 700;
        font-size: 1rem;
    }

    .qz-badge-code {
        background-color: #E9EFFC;
        color: var(--qz-purple);
        font-weight: 700;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 0.85rem;
    }

    .qz-badge-active {
        background-color: #E6F9F5;
        color: #05CD99;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 20px;
    }

    .qz-badge-deleted {
        background-color: #FFEAE6;
        color: #EE5D50;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 20px;
    }

    .qz-btn-back {
        background: #FFFFFF;
        color: var(--qz-dark-text);
        border: 1px solid var(--qz-border-color);
        border-radius: 10px;
        font-weight: 600;
        padding: 8px 16px;
        transition: all 0.2s;
    }

        .qz-btn-back:hover {
            background: var(--qz-bg-light);
            color: var(--qz-purple);
        }

    .qz-btn-edit {
        background: rgba(77, 33, 151, 0.1);
        color: var(--qz-purple);
        border: none;
        border-radius: 10px;
        font-weight: 700;
        padding: 8px 16px;
        transition: all 0.2s;
    }

        .qz-btn-edit:hover {
            background: var(--qz-purple);
            color: #FFFFFF;
        }
</style>

<div class="container-fluid py-4">

    <!-- Top Bar Navigation -->
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <a asp-controller="Admin" asp-action="Courses" class="btn qz-btn-back">
            <i class="fa-solid fa-arrow-left me-2"></i>Back to Courses
        </a>

        @if (!Model.IsDeleted)
        {
            <a asp-controller="Admin" asp-action="EditCourse" asp-route-id="@Model.Id" class="btn qz-btn-edit">
                <i class="fa-solid fa-pen-to-square me-2"></i>Edit Course
            </a>
        }
    </div>

    <!-- Main Details Card -->
    <div class="qz-admin-card">

        <!-- Header Info -->
        <div class="d-flex justify-content-between align-items-start mb-4">
            <div>
                <span class="badge bg-light text-primary border mb-2 px-3 py-2 rounded-pill fw-bold">
                    <i class="fa-solid fa-book me-1"></i> Course Overview
                </span>
                <h2 class="qz-header-title mt-2 mb-2">@Model.CourseName</h2>
                <span class="qz-badge-code">
                    <i class="fa-solid fa-hashtag me-1"></i>@Model.CourseCode
                </span>
            </div>

            <div>
                @if (Model.IsDeleted)
                {
                    <span class="qz-badge-deleted">
                        <i class="fa-solid fa-trash-can me-1"></i> Deleted
                    </span>
                }
                else
                {
                    <span class="qz-badge-active">
                        <i class="fa-solid fa-circle-check me-1"></i> Active
                    </span>
                }
            </div>
        </div>

        <hr style="border-color: var(--qz-border-color);" class="my-4" />

        <!-- Info Grid -->
        <div class="row g-3">
            <div class="col-md-4">
                <div class="qz-detail-item">
                    <span class="qz-detail-label">Course Level</span>
                    <span class="qz-detail-value">
                        <i class="fa-solid fa-layer-group text-primary me-2"></i>@Model.CourseLevel
                    </span>
                </div>
            </div>

            <div class="col-md-8">
                <div class="qz-detail-item">
                    <span class="qz-detail-label">Course Code</span>
                    <span class="qz-detail-value">
                        <i class="fa-solid fa-barcode text-primary me-2"></i>@Model.CourseCode
                    </span>
                </div>
            </div>

            <div class="col-12">
                <div class="qz-detail-item">
                    <span class="qz-detail-label">Description</span>
                    <p class="qz-detail-value mb-0 fw-normal" style="line-height: 1.6;">
                        @(string.IsNullOrWhiteSpace(Model.CourseDescription) ? "No description available." : Model.CourseDescription)
                    </p>
                </div>
            </div>
        </div>

        <!-- Footer Actions -->
        <div class="mt-4 pt-3 d-flex justify-content-end">
            @if (Model.IsDeleted)
            {
                <form asp-controller="Admin" asp-action="RestoreCourse" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success rounded-3 fw-bold px-4 py-2">
                        <i class="fa-solid fa-trash-arrow-up me-2"></i>Restore Course
                    </button>
                </form>
            }
            else
            {
                <form asp-controller="Admin" asp-action="DeleteCourse" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this course?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger rounded-3 fw-bold px-4 py-2">
                        <i class="fa-solid fa-trash-can me-2"></i>Delete Course
                    </button>
                </form>
            }
        </div>

    </div>
</div>