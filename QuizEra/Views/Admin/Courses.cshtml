@model IEnumerable<QuizEra.BLL.ModelVM.Course.CourseVM>

@{
    ViewData["Title"] = "Courses";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Courses</h2>
            <p class="text-muted small mb-0">
                Manage all courses in the system.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="CreateCourse"
           class="btn btn-primary fw-semibold">
            <i class="fa-solid fa-plus me-1"></i>
            Add Course
        </a>
    </div>

    <!-- Back -->
    <div class="mb-3">
        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i>
            Back to Dashboard
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-0">

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="px-4">Course</th>
                                <th>Code</th>
                                <th>Level</th>
                                <th>Status</th>
                                <th class="text-end px-4">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var course in Model)
                            {
                                <tr class="@(course.IsDeleted ? "table-secondary" : "")">

                                    <td class="px-4">
                                        <div>
                                            <div class="fw-semibold">
                                                @course.CourseName
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(course.CourseDescription))
                                            {
                                                <small class="text-muted">
                                                    @(course.CourseDescription.Length > 70
                                                        ? course.CourseDescription.Substring(0, 70) + "..."
                                                        : course.CourseDescription)
                                                </small>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @course.CourseCode
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-primary">
                                            @course.CourseLevel
                                        </span>
                                    </td>

                                    <td>
                                        @if (course.IsDeleted)
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fa-solid fa-trash-can me-1"></i>
                                                Deleted
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                <i class="fa-solid fa-circle-check me-1"></i>
                                                Active
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end px-4">

                                        <div class="d-flex justify-content-end gap-2">

                                            <a asp-controller="Admin"
                                               asp-action="CourseDetails"
                                               asp-route-id="@course.Id"
                                               class="btn btn-sm btn-light text-secondary"
                                               title="Details">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>

                                            @if (!course.IsDeleted)
                                            {
                                                <a asp-controller="Admin"
                                                   asp-action="EditCourse"
                                                   asp-route-id="@course.Id"
                                                   class="btn btn-sm btn-light text-primary"
                                                   title="Edit">
                                                    <i class="fa-solid fa-pen-to-square"></i>
                                                </a>

                                                <form asp-controller="Admin"
                                                      asp-action="DeleteCourse"
                                                      asp-route-id="@course.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Are you sure you want to delete this course?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-light text-danger"
                                                            title="Delete">
                                                        <i class="fa-solid fa-trash-can"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-controller="Admin"
                                                      asp-action="RestoreCourse"
                                                      asp-route-id="@course.Id"
                                                      method="post"
                                                      class="d-inline">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-light text-success"
                                                            title="Restore">
                                                        <i class="fa-solid fa-trash-arrow-up"></i>
                                                    </button>
                                                </form>
                                            }

                                        </div>

                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm text-center py-5">
            <div class="card-body">

                <i class="fa-solid fa-book-open text-muted fs-1 mb-3"></i>

                <h4 class="fw-bold">
                    No Courses Yet
                </h4>

                <p class="text-muted">
                    There are no courses in the system.
                </p>

                <a asp-controller="Admin"
                   asp-action="CreateCourse"
                   class="btn btn-primary">
                    <i class="fa-solid fa-plus me-1"></i>
                    Create First Course
                </a>

            </div>
        </div>
    }

</div>
