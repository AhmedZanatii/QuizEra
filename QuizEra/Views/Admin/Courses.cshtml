@model IEnumerable<QuizEra.BLL.ModelVM.Course.CourseVM>

@{
    ViewData["Title"] = "Courses";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-dark mb-1">
                Courses
            </h2>

            <p class="text-muted small mb-0">
                Manage all courses in QuizEra.
            </p>
        </div>

        <a asp-controller="Course"
           asp-action="Create"
           class="btn btn-primary">

            <i class="fa-solid fa-plus me-2"></i>
            Create Course

        </a>

    </div>


    <!-- Courses Table -->
    <div class="card dashboard-card border-0 shadow-sm">

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <i class="fa-solid fa-book-open fs-1 text-muted mb-3"></i>

                    <h5 class="fw-bold">
                        No Courses Found
                    </h5>

                    <p class="text-muted small">
                        There are no courses in the system yet.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="px-4">
                                    Course Name
                                </th>

                                <th>
                                    Course Code
                                </th>

                                <th>
                                    Level
                                </th>

                                <th>
                                    Description
                                </th>

                                <th class="text-end px-4">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var course in Model)
                            {
                                <tr>

                                    <td class="px-4">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-3">

                                                <i class="fa-solid fa-book-open"></i>

                                            </div>

                                            <div>

                                                <div class="fw-semibold text-dark">
                                                    @course.CourseName
                                                </div>

                                            </div>

                                        </div>

                                    </td>


                                    <td>

                                        <span class="badge bg-light text-dark border">
                                            @course.CourseCode
                                        </span>

                                    </td>


                                    <td>

                                        <span class="badge bg-primary bg-opacity-10 text-primary">
                                            @course.CourseLevel
                                        </span>

                                    </td>


                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(course.CourseDescription))
                                        {
                                            <span class="text-muted small">
                                                @course.CourseDescription
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                No description
                                            </span>
                                        }

                                    </td>


                                    <td class="text-end px-4">

                                        <div class="d-flex justify-content-end gap-2">

                                            <!-- Details -->
                                            <a asp-controller="Course"
                                               asp-action="Details"
                                               asp-route-id="@course.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="View">

                                                <i class="fa-solid fa-eye"></i>

                                            </a>


                                            <!-- Edit -->
                                            <a asp-controller="Course"
                                               asp-action="Edit"
                                               asp-route-id="@course.Id"
                                               class="btn btn-sm btn-outline-warning"
                                               title="Edit">

                                                <i class="fa-solid fa-pen"></i>

                                            </a>


                                            <!-- Delete -->
                                            <form asp-controller="Course"
                                                  asp-action="Delete"
                                                  asp-route-id="@course.Id"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete"
                                                        onclick="return confirm('Are you sure you want to delete this course?');">

                                                    <i class="fa-solid fa-trash"></i>

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>


<style>

    .dashboard-card {
        border-radius: 12px;
        border: 1px solid #e9ecef !important;
        overflow: hidden;
    }

    .icon-shape {
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    table th {
        font-size: 0.85rem;
        font-weight: 600;
        color: #6c757d;
    }

    table td {
        font-size: 0.9rem;
    }

</style>