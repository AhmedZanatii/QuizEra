@model QuizEra.BLL.ModelVM.Questions.QuestionVM

@{
    ViewData["Title"] = "Create Question";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .qz-form-card {
        background: #FFFFFF;
        border: 1px solid var(--qz-border-color);
        border-radius: 20px;
        box-shadow: var(--qz-card-shadow);
    }

    .form-control:focus, .form-select:focus {
        border-color: var(--qz-purple);
        box-shadow: 0 0 0 0.25rem rgba(77, 33, 151, 0.12);
    }

    .input-group-text {
        background-color: #F4F7FE;
        border-color: #E0E5F2;
        color: #A3AED0;
    }

    .form-control, .form-select {
        background-color: #F4F7FE;
        border-color: #E0E5F2;
        color: #1B2559;
        font-weight: 500;
        border-radius: 12px;
    }

    .btn-qz-primary {
        background-color: var(--qz-purple);
        color: #FFFFFF;
        border: none;
        border-radius: 12px;
        font-weight: 700;
        padding: 10px 24px;
        transition: all 0.2s ease;
    }

        .btn-qz-primary:hover {
            background-color: var(--qz-purple-hover);
            color: #FFFFFF;
            box-shadow: 0px 8px 20px rgba(77, 33, 151, 0.25);
        }

    .btn-qz-outline {
        border: 1px solid var(--qz-border-color);
        background: #FFFFFF;
        color: var(--qz-dark-text);
        border-radius: 12px;
        font-weight: 600;
        padding: 8px 18px;
    }

        .btn-qz-outline:hover {
            background: #F4F7FE;
            color: var(--qz-purple);
        }

    .qz-section-title {
        color: var(--qz-purple);
        font-weight: 800;
        font-size: 0.95rem;
        letter-spacing: 0.5px;
    }

    .option-row {
        background-color: #F4F7FE;
        border: 1px solid #E0E5F2;
        border-radius: 14px;
        padding: 6px;
    }
</style>

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h3 class="fw-bold m-0" style="color: #1B2559;">Create Question</h3>
        <p class="text-muted small m-0 mt-1">Add a new question to the assessment question bank.</p>
    </div>
    <a asp-controller="Admin" asp-action="Questions" class="btn btn-qz-outline text-decoration-none">
        <i class="fa-solid fa-arrow-left me-2"></i>Back to Bank
    </a>
</div>

<div class="qz-form-card p-4 p-md-5">
    <form asp-controller="Admin" asp-action="CreateQuestion" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 mb-4" role="alert"></div>

        <div class="qz-section-title mb-3">
            <i class="fa-solid fa-layer-group me-2"></i>Classification
        </div>
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <label class="form-label fw-bold small text-uppercase" style="color: #A3AED0;">Course</label>
                <select id="courseSelect" class="form-select">
                    <option value="">-- Select Course --</option>
                    @if (ViewBag.Courses != null)
                    {
                        foreach (var course in ViewBag.Courses)
                        {
                            if (!course.IsDeleted)
                            {
                                <option value="@course.Id">@course.CourseName</option>
                            }
                        }
                    }
                </select>
            </div>

            <div class="col-md-6">
                <label asp-for="TopicID" class="form-label fw-bold small text-uppercase" style="color: #A3AED0;">Topic</label>
                <select asp-for="TopicID" id="topicSelect" class="form-select" disabled>
                    <option value="">-- Select Course First --</option>
                    @if (ViewBag.Topics != null)
                    {
                        foreach (var topic in ViewBag.Topics)
                        {
                            <option value="@topic.Id" data-course-id="@topic.CourseId">@topic.Name</option>
                        }
                    }
                </select>
                <span asp-validation-for="TopicID" class="text-danger small mt-1 d-block"></span>
            </div>
        </div>

        <hr class="my-4" style="border-color: var(--qz-border-color);" />

        <div class="qz-section-title mb-3">
            <i class="fa-solid fa-file-pen me-2"></i>Question Details
        </div>
        <div class="row g-4 mb-4">
            <div class="col-12">
                <label asp-for="QuestionText" class="form-label fw-bold small text-uppercase" style="color: #A3AED0;">Question Body</label>
                <textarea asp-for="QuestionText" class="form-control" rows="3" placeholder="Write your question here..."></textarea>
                <span asp-validation-for="QuestionText" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="QuestionFormat" class="form-label fw-bold small text-uppercase" style="color: #A3AED0;">Format</label>
                <select asp-for="QuestionFormat" class="form-select" asp-items="Html.GetEnumSelectList<QuizEra.DAL.Entities.Enums.QuestionFormat>()">
                    <option value="">-- Select Format --</option>
                </select>
                <span asp-validation-for="QuestionFormat" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="DifficultyLevel" class="form-label fw-bold small text-uppercase" style="color: #A3AED0;">Difficulty Level</label>
                <select asp-for="DifficultyLevel" class="form-select" asp-items="Html.GetEnumSelectList<QuizEra.DAL.Entities.Enums.DifficultyLevel>()">
                    <option value="">-- Select Difficulty --</option>
                </select>
                <span asp-validation-for="DifficultyLevel" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-12">
                <label asp-for="QuestionAnswer" class="form-label fw-bold small text-uppercase" style="color: #A3AED0;">Model Answer / Explanation</label>
                <textarea asp-for="QuestionAnswer" class="form-control" rows="2" placeholder="Enter the correct answer or explanation..."></textarea>
                <span asp-validation-for="QuestionAnswer" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-12">
                <label asp-for="Photo" class="form-label fw-bold small text-uppercase" style="color: #A3AED0;">Image Attachment (URL)</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0 rounded-start-3"><i class="fa-solid fa-link"></i></span>
                    <input asp-for="Photo" class="form-control border-start-0 rounded-end-3" placeholder="https://example.com/image.png (optional)" />
                </div>
                <span asp-validation-for="Photo" class="text-danger small mt-1 d-block"></span>
            </div>
        </div>

        <hr class="my-4" style="border-color: var(--qz-border-color);" />

        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="qz-section-title mb-0">
                <i class="fa-solid fa-list-check me-2"></i>Multiple Choice Options
            </div>
            <button type="button" class="btn btn-qz-outline btn-sm px-3" id="addOption">
                <i class="fa-solid fa-plus me-1"></i> Add Option
            </button>
        </div>

        <div id="optionsContainer" class="d-flex flex-column gap-3 mb-4">
            @for (int i = 0; i < Model.Options.Count; i++)
            {
                <div class="option-row">
                    <div class="input-group">
                        <input asp-for="Options[i].OptionText" class="form-control border-0 bg-white" placeholder="Enter option text..." style="border-radius: 10px 0 0 10px;" />
                        <div class="input-group-text bg-white border-0 px-3 border-start">
                            <input asp-for="Options[i].IsCorrect" class="form-check-input mt-0 me-2" type="checkbox" />
                            <span class="small fw-bold text-success">Correct</span>
                        </div>
                        <button type="button" class="btn btn-outline-danger border-0 remove-option" style="border-radius: 0 10px 10px 0;">
                            <i class="fa-solid fa-trash-can"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Options[i].OptionText" class="text-danger small ms-2 mt-1 d-block"></span>
                </div>
            }
        </div>

        <div class="d-flex justify-content-end gap-3 mt-5 pt-4 border-top">
            <a asp-controller="Admin" asp-action="Questions" class="btn btn-qz-outline text-decoration-none px-4">Cancel</a>
            <button type="submit" class="btn btn-qz-primary px-4">
                <i class="fa-solid fa-plus me-2"></i> Save Question
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const courseSelect = document.getElementById("courseSelect");
        const topicSelect = document.getElementById("topicSelect");

        const allTopics = Array.from(
            topicSelect.querySelectorAll("option[data-course-id]")
        ).map(option => ({
            value: option.value,
            text: option.textContent,
            courseId: option.dataset.courseId
        }));

        courseSelect.addEventListener("change", function() {
            const courseId = this.value;
            topicSelect.innerHTML = "";

            if (!courseId) {
                topicSelect.disabled = true;
                topicSelect.innerHTML = '<option value="">-- Select Course First --</option>';
                return;
            }

            topicSelect.innerHTML = '<option value="">-- Select Topic --</option>';

            const filteredTopics = allTopics.filter(topic => {
                const tNum = Number(topic.courseId);
                const cNum = Number(courseId);

                if (!isNaN(tNum) && !isNaN(cNum)) return tNum === cNum;
                return String(topic.courseId).trim() === String(courseId).trim();
            });

            if (filteredTopics.length === 0) {
                topicSelect.innerHTML = '<option value="">No topics found</option>';
                topicSelect.disabled = true;
                return;
            }

            filteredTopics.forEach(topic => {
                const option = document.createElement("option");
                option.value = topic.value;
                option.textContent = topic.text;
                topicSelect.appendChild(option);
            });

            topicSelect.disabled = false;
        });

        let optionIndex = @Model.Options.Count;

        document.getElementById("addOption").addEventListener("click", function() {
            const container = document.getElementById("optionsContainer");
            const div = document.createElement("div");
            div.className = "option-row";

            div.innerHTML = `
                        <div class="input-group">
                            <input name="Options[${optionIndex}].OptionText" class="form-control border-0 bg-white" placeholder="Enter option text..." style="border-radius: 10px 0 0 10px;" />
                            <div class="input-group-text bg-white border-0 px-3 border-start">
                                <input name="Options[${optionIndex}].IsCorrect" value="true" type="checkbox" class="form-check-input mt-0 me-2" />
                                <span class="small fw-bold text-success">Correct</span>
                            </div>
                            <button type="button" class="btn btn-outline-danger border-0 remove-option" style="border-radius: 0 10px 10px 0;">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    `;

            container.appendChild(div);
            optionIndex++;
        });

        document.addEventListener("click", function(e) {
            const button = e.target.closest(".remove-option");
            if (!button) return;
            button.closest(".option-row").remove();
        });
    </script>
}