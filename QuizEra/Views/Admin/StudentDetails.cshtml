@model QuizEra.BLL.ModelVM.Administration.StudentModelVM

@{
    ViewData["Title"] = "Student Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4">
    <h3 class="fw-bold text-dark m-0">Student Details</h3>
</div>

<div class="card dashboard-card p-4">
    <div class="row g-3">
        <div class="col-sm-3 text-muted fw-medium">First Name</div>
        <div class="col-sm-9 fw-bold">@Model.FirstName</div>

        <div class="col-sm-3 text-muted fw-medium">Last Name</div>
        <div class="col-sm-9 fw-bold">@Model.LastName</div>

        <div class="col-sm-3 text-muted fw-medium">Email</div>
        <div class="col-sm-9">@Model.Email</div>

        <div class="col-sm-3 text-muted fw-medium">Phone</div>
        <div class="col-sm-9">@Model.PhoneNumber</div>

        <div class="col-sm-3 text-muted fw-medium">Status</div>
        <div class="col-sm-9">
            @if (Model.IsActive)
            {
                <span class="badge bg-success bg-opacity-10 text-success">Active</span>
            }
            else
            {
                <span class="badge bg-secondary bg-opacity-10 text-secondary">Inactive</span>
            }
        </div>
    </div>

    <div class="mt-4 pt-3 border-top">
        <a asp-action="EditStudent" asp-route-id="@Model.Id" class="btn btn-warning px-4">Edit</a>
        <a asp-action="Students" class="btn btn-outline-secondary px-4 ms-2">Back</a>
    </div>
</div>