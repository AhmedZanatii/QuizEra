@model QuizEra.BLL.ModelVM.Administration.AdminDashboardVM

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="mb-4">
        <h2 class="fw-bold text-dark m-0">Admin Dashboard</h2>
        <p class="text-muted small">
            Overview and real-time statistics of QuizEra system.
        </p>
    </div>

    <!-- Dashboard Cards -->
    <div class="row g-4 mb-4">

        <!-- ================= STUDENTS ================= -->
        <div class="col-12 col-sm-6 col-xl-4">
            <a asp-controller="Admin"
               asp-action="Students"
               class="text-decoration-none">

                <div class="card dashboard-card h-100 p-3 shadow-sm border-0">

                    <div class="card-body d-flex flex-column justify-content-between p-0">

                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <span class="text-muted fw-semibold small text-uppercase">
                                    Total Students
                                </span>

                                <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-3 p-2">
                                    <i class="fa-solid fa-user-graduate fs-5"></i>
                                </div>

                            </div>

                            <h2 class="fw-bold text-dark mb-3">
                                @Model.TotalStudents
                            </h2>
                        </div>

                        <div class="pt-2 border-top d-flex gap-3 small fw-medium">

                            <span class="text-success">
                                <i class="fa-solid fa-circle-check me-1"></i>
                                @Model.ActiveStudents Active
                            </span>

                            <span class="text-danger">
                                <i class="fa-solid fa-circle-xmark me-1"></i>
                                @Model.DeactivatedStudents Inactive
                            </span>

                        </div>

                    </div>

                </div>

            </a>
        </div>


        <!-- ================= INSTRUCTORS ================= -->
        <div class="col-12 col-sm-6 col-xl-4">
            <a asp-controller="Admin"
               asp-action="Instructors"
               class="text-decoration-none">

                <div class="card dashboard-card h-100 p-3 shadow-sm border-0">

                    <div class="card-body d-flex flex-column justify-content-between p-0">

                        <div>

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <span class="text-muted fw-semibold small text-uppercase">
                                    Total Instructors
                                </span>

                                <div class="icon-shape bg-info bg-opacity-10 text-info rounded-3 p-2">
                                    <i class="fa-solid fa-chalkboard-user fs-5"></i>
                                </div>

                            </div>

                            <h2 class="fw-bold text-dark mb-3">
                                @Model.TotalInstructors
                            </h2>

                        </div>

                        <div class="pt-2 border-top d-flex gap-3 small fw-medium">

                            <span class="text-success">
                                <i class="fa-solid fa-circle-check me-1"></i>
                                @Model.ActiveInstructors Active
                            </span>

                            <span class="text-danger">
                                <i class="fa-solid fa-circle-xmark me-1"></i>
                                @Model.DeactivatedInstructors Inactive
                            </span>

                        </div>

                    </div>

                </div>

            </a>
        </div>

        <!-- ================= COURSES ================= -->
        <div class="col-12 col-sm-6 col-xl-4">
            <a asp-controller="Admin"
               asp-action="Courses"
               class="text-decoration-none">

                <div class="card dashboard-card h-100 p-3 shadow-sm border-0">

                    <div class="card-body d-flex flex-column justify-content-between p-0">

                        <div>

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <span class="text-muted fw-semibold small text-uppercase">
                                    Total Courses
                                </span>

                                <div class="icon-shape bg-warning bg-opacity-10 text-warning rounded-3 p-2">
                                    <i class="fa-solid fa-book-open fs-5"></i>
                                </div>

                            </div>

                            <h2 class="fw-bold text-dark mb-3">
                                @Model.TotalCourses
                            </h2>

                        </div>

                        <div class="pt-2 border-top d-flex gap-3 small fw-medium">

                            <span class="text-success">
                                <i class="fa-solid fa-circle-check me-1"></i>
                                @Model.ActiveCourses Active
                            </span>

                            <span class="text-danger">
                                <i class="fa-solid fa-circle-xmark me-1"></i>
                                @Model.DeletedCourses Deleted
                            </span>

                        </div>

                    </div>

                </div>

            </a>
        </div>


        <!-- ================= TOPICS ================= -->
        <div class="col-12 col-sm-6 col-xl-4">
            <a asp-controller="Admin"
               asp-action="Topics"
               class="text-decoration-none">

                <div class="card dashboard-card h-100 p-3 shadow-sm border-0">

                    <div class="card-body d-flex flex-column justify-content-between p-0">

                        <div>

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <span class="text-muted fw-semibold small text-uppercase">
                                    Total Topics
                                </span>

                                <div class="icon-shape bg-secondary bg-opacity-10 text-secondary rounded-3 p-2">
                                    <i class="fa-solid fa-folder-tree fs-5"></i>
                                </div>

                            </div>

                            <h2 class="fw-bold text-dark mb-3">
                                @Model.TotalTopics
                            </h2>

                        </div>

                        <div class="pt-2 border-top d-flex gap-3 small fw-medium">

                            <span class="text-success">
                                <i class="fa-solid fa-circle-check me-1"></i>
                                @Model.ActiveTopics Active
                            </span>

                            <span class="text-danger">
                                <i class="fa-solid fa-circle-xmark me-1"></i>
                                @Model.DeletedTopics Deleted
                            </span>

                        </div>

                    </div>

                </div>

            </a>
        </div>


        <!-- ================= QUESTIONS ================= -->
        <div class="col-12 col-sm-6 col-xl-4">
            <a asp-controller="Admin"
               asp-action="Questions"
               class="text-decoration-none">

                <div class="card dashboard-card h-100 p-3 shadow-sm border-0">

                    <div class="card-body d-flex flex-column justify-content-between p-0">

                        <div>

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <span class="text-muted fw-semibold small text-uppercase">
                                    Total Questions
                                </span>

                                <div class="icon-shape bg-purple bg-opacity-10 text-purple rounded-3 p-2">
                                    <i class="fa-solid fa-circle-question fs-5"></i>
                                </div>

                            </div>

                            <h2 class="fw-bold text-dark mb-3">
                                @Model.TotalQuestions
                            </h2>

                        </div>

                        <div class="pt-2 border-top d-flex gap-3 small fw-medium">

                            <span class="text-success">
                                <i class="fa-solid fa-circle-check me-1"></i>
                                @Model.ActiveQuestions Active
                            </span>

                            <span class="text-danger">
                                <i class="fa-solid fa-circle-xmark me-1"></i>
                                @Model.DeletedQuestions Deleted
                            </span>

                        </div>

                    </div>

                </div>

            </a>
        </div>

        <!-- ================= EXAMS ================= -->
        <div class="col-12 col-sm-6 col-xl-4">
            <a asp-controller="Admin"
               asp-action="Exams"
               class="text-decoration-none">

                <div class="card dashboard-card h-100 p-3 shadow-sm border-0">

                    <div class="card-body d-flex flex-column justify-content-between p-0">

                        <div>

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <span class="text-muted fw-semibold small text-uppercase">
                                    Total Exams
                                </span>

                                <div class="icon-shape bg-success bg-opacity-10 text-success rounded-3 p-2">
                                    <i class="fa-solid fa-file-pen fs-5"></i>
                                </div>

                            </div>

                            <h2 class="fw-bold text-dark mb-3">
                                @Model.TotalExams
                            </h2>

                        </div>

                        <div class="pt-2 border-top d-flex gap-3 small fw-medium">

                            <span class="text-success">
                                <i class="fa-solid fa-circle-check me-1"></i>
                                @Model.ActiveExams Active
                            </span>

                            <span class="text-danger">
                                <i class="fa-solid fa-circle-xmark me-1"></i>
                                @Model.DeletedExams Deleted
                            </span>

                        </div>

                    </div>

                </div>

            </a>
        </div>

    </div>

</div>


<style>

    .dashboard-card {
        border-radius: 12px;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 1px solid #e9ecef !important;
    }

        .dashboard-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08) !important;
        }

            .dashboard-card:hover h2 {
                color: #0d6efd !important;
            }

    .icon-shape {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .bg-purple {
        background-color: rgba(111, 66, 193, 0.1) !important;
    }

    .text-purple {
        color: #6f42c1 !important;
    }

</style>