@model QuizEra.BLL.ModelVM.Administration.AdminDashboardVM

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .qz-card-dashboard {
        background: #FFFFFF;
        border: 1px solid var(--qz-border-color);
        border-radius: 20px;
        padding: 24px;
        box-shadow: var(--qz-card-shadow);
        position: relative;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        /* Top Accent Stripe on Hover */
        .qz-card-dashboard::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, #4D2197, #7B42E1);
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .qz-card-dashboard:hover {
            transform: translateY(-6px);
            box-shadow: 0px 24px 48px rgba(77, 33, 151, 0.16);
            border-color: rgba(77, 33, 151, 0.2);
        }

            .qz-card-dashboard:hover::before {
                opacity: 1;
            }

    .qz-card-icon {
        width: 54px;
        height: 54px;
        border-radius: 16px;
        background: #F4F0FD;
        color: #4D2197;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
    }

    .qz-card-title {
        color: #A3AED0;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.8px;
    }

    .qz-card-number {
        color: #1B2559;
        font-size: 2.2rem;
        font-weight: 800;
        line-height: 1;
        margin: 12px 0 18px 0;
    }

    /* Status Pills */
    .qz-pill {
        padding: 5px 12px;
        border-radius: 30px;
        font-size: 0.78rem;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .qz-pill-success {
        background: #E6F7F0;
        color: #05CD99;
    }

    .qz-pill-danger {
        background: #FEEFEE;
        color: #EE5D50;
    }
</style>

<div class="mb-4">
    <h3 class="fw-bold m-0" style="color: #1B2559;">System Overview</h3>
    <p class="text-muted small m-0">Real-time statistics and summary of QuizEra platform.</p>
</div>

<div class="row g-4">

    <!-- STUDENTS -->
    <div class="col-12 col-sm-6 col-xl-4">
        <a asp-controller="Admin" asp-action="Students" class="text-decoration-none">
            <div class="qz-card-dashboard">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="qz-card-title text-uppercase">Total Students</span>
                        <div class="qz-card-number">@Model.TotalStudents</div>
                    </div>
                    <div class="qz-card-icon">
                        <i class="fa-solid fa-user-graduate"></i>
                    </div>
                </div>
                <div class="pt-3 border-top d-flex gap-2 align-items-center">
                    <span class="qz-pill qz-pill-success"><i class="fa-solid fa-circle-check"></i> @Model.ActiveStudents Active</span>
                    <span class="qz-pill qz-pill-danger"><i class="fa-solid fa-circle-xmark"></i> @Model.DeactivatedStudents Inactive</span>
                </div>
            </div>
        </a>
    </div>

    <!-- INSTRUCTORS -->
    <div class="col-12 col-sm-6 col-xl-4">
        <a asp-controller="Admin" asp-action="Instructors" class="text-decoration-none">
            <div class="qz-card-dashboard">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="qz-card-title text-uppercase">Total Instructors</span>
                        <div class="qz-card-number">@Model.TotalInstructors</div>
                    </div>
                    <div class="qz-card-icon">
                        <i class="fa-solid fa-chalkboard-user"></i>
                    </div>
                </div>
                <div class="pt-3 border-top d-flex gap-2 align-items-center">
                    <span class="qz-pill qz-pill-success"><i class="fa-solid fa-circle-check"></i> @Model.ActiveInstructors Active</span>
                    <span class="qz-pill qz-pill-danger"><i class="fa-solid fa-circle-xmark"></i> @Model.DeactivatedInstructors Inactive</span>
                </div>
            </div>
        </a>
    </div>

    <!-- COURSES -->
    <div class="col-12 col-sm-6 col-xl-4">
        <a asp-controller="Admin" asp-action="Courses" class="text-decoration-none">
            <div class="qz-card-dashboard">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="qz-card-title text-uppercase">Total Courses</span>
                        <div class="qz-card-number">@Model.TotalCourses</div>
                    </div>
                    <div class="qz-card-icon">
                        <i class="fa-solid fa-book-open"></i>
                    </div>
                </div>
                <div class="pt-3 border-top d-flex gap-2 align-items-center">
                    <span class="qz-pill qz-pill-success"><i class="fa-solid fa-circle-check"></i> @Model.ActiveCourses Active</span>
                    <span class="qz-pill qz-pill-danger"><i class="fa-solid fa-circle-xmark"></i> @Model.DeletedCourses Deleted</span>
                </div>
            </div>
        </a>
    </div>

    <!-- TOPICS -->
    <div class="col-12 col-sm-6 col-xl-4">
        <a asp-controller="Admin" asp-action="Topics" class="text-decoration-none">
            <div class="qz-card-dashboard">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="qz-card-title text-uppercase">Total Topics</span>
                        <div class="qz-card-number">@Model.TotalTopics</div>
                    </div>
                    <div class="qz-card-icon">
                        <i class="fa-solid fa-folder-tree"></i>
                    </div>
                </div>
                <div class="pt-3 border-top d-flex gap-2 align-items-center">
                    <span class="qz-pill qz-pill-success"><i class="fa-solid fa-circle-check"></i> @Model.ActiveTopics Active</span>
                    <span class="qz-pill qz-pill-danger"><i class="fa-solid fa-circle-xmark"></i> @Model.DeletedTopics Deleted</span>
                </div>
            </div>
        </a>
    </div>

    <!-- QUESTIONS -->
    <div class="col-12 col-sm-6 col-xl-4">
        <a asp-controller="Admin" asp-action="Questions" class="text-decoration-none">
            <div class="qz-card-dashboard">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="qz-card-title text-uppercase">Total Questions</span>
                        <div class="qz-card-number">@Model.TotalQuestions</div>
                    </div>
                    <div class="qz-card-icon">
                        <i class="fa-solid fa-circle-question"></i>
                    </div>
                </div>
                <div class="pt-3 border-top d-flex gap-2 align-items-center">
                    <span class="qz-pill qz-pill-success"><i class="fa-solid fa-circle-check"></i> @Model.ActiveQuestions Active</span>
                    <span class="qz-pill qz-pill-danger"><i class="fa-solid fa-circle-xmark"></i> @Model.DeletedQuestions Deleted</span>
                </div>
            </div>
        </a>
    </div>

    <!-- EXAMS -->
    <div class="col-12 col-sm-6 col-xl-4">
        <a asp-controller="Admin" asp-action="Exams" class="text-decoration-none">
            <div class="qz-card-dashboard">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <span class="qz-card-title text-uppercase">Total Exams</span>
                        <div class="qz-card-number">@Model.TotalExams</div>
                    </div>
                    <div class="qz-card-icon">
                        <i class="fa-solid fa-file-pen"></i>
                    </div>
                </div>
                <div class="pt-3 border-top d-flex gap-2 align-items-center">
                    <span class="qz-pill qz-pill-success"><i class="fa-solid fa-circle-check"></i> @Model.ActiveExams Active</span>
                    <span class="qz-pill qz-pill-danger"><i class="fa-solid fa-circle-xmark"></i> @Model.DeletedExams Deleted</span>
                </div>
            </div>
        </a>
    </div>

</div>