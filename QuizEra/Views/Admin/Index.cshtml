@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4">
    <h2 class="fw-bold text-dark m-0">Admin Dashboard</h2>
    <p class="text-muted">Manage users, instructors, and system settings.</p>
</div>

<div class="row g-4">
    <!-- Manage Students Card -->
    <div class="col-12 col-md-6">
        <div class="card dashboard-card p-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold text-dark m-0">Students</h5>
                        <p class="text-muted small mb-0">Manage student accounts and records.</p>
                    </div>
                    <div class="icon-shape bg-primary bg-opacity-10 text-primary">
                        <i class="fa-solid fa-user-graduate"></i>
                    </div>
                </div>
                <a asp-controller="Admin" asp-action="Students" class="btn btn-primary btn-sm px-3 fw-medium">
                    Manage Students <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Manage Instructors Card -->
    <div class="col-12 col-md-6">
        <div class="card dashboard-card p-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-bold text-dark m-0">Instructors</h5>
                        <p class="text-muted small mb-0">Manage instructor accounts and permissions.</p>
                    </div>
                    <div class="icon-shape bg-success bg-opacity-10 text-success">
                        <i class="fa-solid fa-chalkboard-user"></i>
                    </div>
                </div>
                <a asp-controller="Admin" asp-action="Instructors" class="btn btn-success btn-sm px-3 fw-medium text-white">
                    Manage Instructors <i class="fa-solid fa-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>
</div>