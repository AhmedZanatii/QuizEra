@model QuizEra.BLL.ModelVM.Administration.InstructorModelVM

@{
    ViewData["Title"] = "Edit Instructor";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .qz-form-card {
        background: #FFFFFF;
        border: 1px solid var(--qz-border-color);
        border-radius: 20px;
        box-shadow: var(--qz-card-shadow);
    }

    .form-control:focus, .form-select:focus {
        border-color: var(--qz-purple);
        box-shadow: 0 0 0 0.25rem rgba(77, 33, 151, 0.12);
    }

    .input-group-text {
        background-color: #F4F7FE;
        border-color: #E0E5F2;
        color: #A3AED0;
    }

    .form-control, .form-select {
        background-color: #F4F7FE;
        border-color: #E0E5F2;
        color: #1B2559;
        font-weight: 500;
        border-radius: 12px;
    }

    .btn-qz-primary {
        background-color: var(--qz-purple);
        color: #FFFFFF;
        border: none;
        border-radius: 12px;
        font-weight: 700;
        padding: 10px 24px;
        transition: all 0.2s ease;
    }

        .btn-qz-primary:hover {
            background-color: var(--qz-purple-hover);
            color: #FFFFFF;
            box-shadow: 0px 8px 20px rgba(77, 33, 151, 0.25);
        }

    .btn-qz-outline {
        border: 1px solid var(--qz-border-color);
        background: #FFFFFF;
        color: var(--qz-dark-text);
        border-radius: 12px;
        font-weight: 600;
        padding: 8px 18px;
    }

        .btn-qz-outline:hover {
            background: #F4F7FE;
            color: var(--qz-purple);
        }

    .badge-active {
        background-color: rgba(5, 205, 153, 0.1);
        color: #05CD99;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 8px;
    }

    .badge-inactive {
        background-color: rgba(238, 93, 80, 0.1);
        color: #EE5D50;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 8px;
    }
</style>

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h3 class="fw-bold m-0" style="color: #1B2559;">Edit Instructor</h3>
        <p class="text-muted small m-0 mt-1">Update personal details and manage account details for the instructor.</p>
    </div>
    <a asp-action="Instructors" class="btn btn-qz-outline text-decoration-none">
        <i class="fa-solid fa-arrow-left me-2"></i>Back to Instructors
    </a>
</div>

<div class="qz-form-card p-4 p-md-5">
    <form asp-action="EditInstructor" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="AppUserId" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 rounded-3 mb-4" role="alert"></div>

        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label fw-bold small text-uppercase" style="color: #A3AED0; letter-spacing: 0.5px;">First Name</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0 rounded-start-3"><i class="fa-regular fa-user"></i></span>
                    <input asp-for="FirstName" class="form-control border-start-0 rounded-end-3" placeholder="First Name" />
                </div>
                <span asp-validation-for="FirstName" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="LastName" class="form-label fw-bold small text-uppercase" style="color: #A3AED0; letter-spacing: 0.5px;">Last Name</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0 rounded-start-3"><i class="fa-regular fa-user"></i></span>
                    <input asp-for="LastName" class="form-control border-start-0 rounded-end-3" placeholder="Last Name" />
                </div>
                <span asp-validation-for="LastName" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="Email" class="form-label fw-bold small text-uppercase" style="color: #A3AED0; letter-spacing: 0.5px;">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text border-end-0 rounded-start-3"><i class="fa-regular fa-envelope"></i></span>
                    <input asp-for="Email" type="email" class="form-control border-start-0 rounded-end-3" placeholder="Email" />
                </div>
                <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold small text-uppercase" style="color: #A3AED0; letter-spacing: 0.5px;">Account Status</label>
                <div class="pt-2">
                    @if (Model.IsActive)
                    {
                        <span class="badge-active"><i class="fa-solid fa-circle-check me-1"></i> Active</span>
                    }
                    else
                    {
                        <span class="badge-inactive"><i class="fa-solid fa-circle-xmark me-1"></i> Inactive</span>
                    }
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 mt-5 pt-4 border-top">
            <a asp-action="Instructors" class="btn btn-qz-outline text-decoration-none px-4">Cancel</a>
            <button type="submit" class="btn btn-qz-primary px-4">
                <i class="fa-solid fa-floppy-disk me-2"></i>Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}