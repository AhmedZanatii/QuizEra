@model IEnumerable<QuizEra.BLL.ModelVM.Topic.TopicVM>

@{
    ViewData["Title"] = "Topics";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="mb-4">
    <h3 class="fw-bold">Topics</h3>
    <p class="text-muted small">List of all topics in the system.</p>
</div>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-light">No topics found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Course ID</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.Id</td>
                        <td>@t.Name</td>
                        <td>@t.CourseId</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
