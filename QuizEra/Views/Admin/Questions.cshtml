@model IEnumerable<QuizEra.BLL.ModelVM.Questions.QuestionVM>

@{
    ViewData["Title"] = "Questions";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .qz-card {
        background: #FFFFFF;
        border: 1px solid var(--qz-border-color);
        border-radius: 20px;
        box-shadow: var(--qz-card-shadow);
    }

    .btn-qz-outline {
        border: 1px solid var(--qz-border-color);
        background: #FFFFFF;
        color: var(--qz-dark-text);
        border-radius: 12px;
        font-weight: 600;
        padding: 8px 18px;
    }

        .btn-qz-outline:hover {
            background: #F4F7FE;
            color: var(--qz-purple);
        }

    .btn-qz-primary {
        background-color: var(--qz-purple);
        color: #FFFFFF;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        padding: 10px 20px;
        transition: all 0.2s ease;
    }

        .btn-qz-primary:hover {
            background-color: var(--qz-purple-hover);
            color: #FFFFFF;
            box-shadow: 0px 6px 16px rgba(77, 33, 151, 0.25);
        }

    .badge-status-active {
        background-color: rgba(5, 205, 153, 0.1);
        color: #05CD99;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 8px;
        font-size: 0.8rem;
    }

    .badge-status-deleted {
        background-color: rgba(238, 93, 80, 0.1);
        color: #EE5D50;
        font-weight: 700;
        padding: 5px 12px;
        border-radius: 8px;
        font-size: 0.8rem;
    }

    .qz-table th {
        background-color: #F4F7FE;
        color: #A3AED0;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-weight: 700;
        padding: 16px;
        border: none;
    }

    .qz-table td {
        padding: 16px;
        color: #1B2559;
        border-bottom: 1px solid #F4F7FE;
    }

    .qz-table tr:last-child td {
        border-bottom: none;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #E0E5F2;
        background-color: #FFFFFF;
        color: #1B2559;
        transition: all 0.2s ease;
    }

        .action-btn:hover {
            background-color: #F4F7FE;
            color: var(--qz-purple);
        }

    .action-btn-danger:hover {
        background-color: rgba(238, 93, 80, 0.1);
        color: #EE5D50;
        border-color: rgba(238, 93, 80, 0.2);
    }

    .action-btn-success:hover {
        background-color: rgba(5, 205, 153, 0.1);
        color: #05CD99;
        border-color: rgba(5, 205, 153, 0.2);
    }
</style>

<!-- Header -->
<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h3 class="fw-bold m-0" style="color: #1B2559;">Questions Bank</h3>
        <p class="text-muted small m-0 mt-1">Manage assessment questions, formats, and difficulty levels.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Admin" asp-action="Index" class="btn btn-qz-outline text-decoration-none">
            <i class="fa-solid fa-arrow-left me-2"></i>Back to Dashboard
        </a>
        <a asp-controller="Admin" asp-action="CreateQuestion" class="btn btn-qz-primary text-decoration-none">
            <i class="fa-solid fa-plus me-2"></i>Add Question
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 rounded-3 shadow-sm mb-4 d-flex align-items-center alert-dismissible fade show" role="alert" style="background-color: rgba(5, 205, 153, 0.1); color: #05CD99;">
        <i class="fa-solid fa-circle-check me-2"></i>
        <div>@TempData["Success"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 rounded-3 shadow-sm mb-4 d-flex align-items-center alert-dismissible fade show" role="alert" style="background-color: rgba(238, 93, 80, 0.1); color: #EE5D50;">
        <i class="fa-solid fa-circle-exclamation me-2"></i>
        <div>@TempData["Error"]</div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="qz-card overflow-hidden">
    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5 px-4">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px; background-color: #F4F7FE; color: #A3AED0;">
                <i class="fa-solid fa-circle-question fs-2"></i>
            </div>
            <h5 class="fw-bold" style="color: #1B2559;">No Questions Found</h5>
            <p class="text-muted small m-0">There are currently no questions available in the question bank.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table qz-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Course</th>
                        <th>Topic</th>
                        <th>Question</th>
                        <th>Type</th>
                        <th>Difficulty</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var q in Model)
                    {
                        <tr style="@(q.IsDeleted ? "opacity: 0.65;" : "")">
                            <td class="ps-4 fw-bold">
                                @(string.IsNullOrEmpty(q.CourseName) ? "-" : q.CourseName)
                            </td>
                            <td>
                                <span class="badge px-2 py-1 rounded-2" style="background-color: #F4F7FE; color: var(--qz-purple); font-weight: 600;">
                                    @(string.IsNullOrEmpty(q.TopicName) ? "-" : q.TopicName)
                                </span>
                            </td>
                            <td style="max-width: 300px;">
                                <div class="fw-bold text-truncate" title="@q.QuestionText">
                                    @q.QuestionText
                                </div>
                            </td>
                            <td>
                                <span class="small fw-semibold text-secondary">@q.QuestionFormat</span>
                            </td>
                            <td>
                                <span class="small fw-semibold" style="color: #1B2559;">@q.DifficultyLevel</span>
                            </td>
                            <td>
                                @if (q.IsDeleted)
                                {
                                    <span class="badge-status-deleted d-inline-flex align-items-center gap-1">
                                        <i class="fa-solid fa-circle" style="font-size: 0.4rem;"></i> Deleted
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status-active d-inline-flex align-items-center gap-1">
                                        <i class="fa-solid fa-circle" style="font-size: 0.4rem;"></i> Active
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-1">
                                    <a asp-controller="Admin" asp-action="QuestionDetails" asp-route-id="@q.Id" class="action-btn text-decoration-none" title="Details">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>

                                    @if (!q.IsDeleted)
                                    {
                                        <a asp-controller="Admin" asp-action="EditQuestion" asp-route-id="@q.Id" class="action-btn text-decoration-none" title="Edit">
                                            <i class="fa-solid fa-pen"></i>
                                        </a>

                                        <form asp-controller="Admin" asp-action="DeleteQuestionConfirmed" asp-route-id="@q.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this question?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-btn action-btn-danger" title="Delete">
                                                <i class="fa-solid fa-trash-can"></i>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Admin" asp-action="RestoreQuestion" asp-route-id="@q.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to restore this question?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="action-btn action-btn-success" title="Restore">
                                                <i class="fa-solid fa-rotate-left"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>