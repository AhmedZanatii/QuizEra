@model IEnumerable<QuizEra.BLL.ModelVM.Questions.QuestionVM>

@{
    ViewData["Title"] = "Questions";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold text-dark mb-1">
                Questions
            </h2>

            <p class="text-muted small mb-0">
                Manage question bank.
            </p>
        </div>

        <a asp-controller="Admin"
           asp-action="CreateQuestion"
           class="btn btn-primary fw-semibold">

            <i class="fa-solid fa-plus me-1"></i>
            Add Question

        </a>

    </div>


    <div class="mb-3">

        <a asp-controller="Admin"
           asp-action="Index"
           class="btn btn-outline-secondary btn-sm">

            <i class="fa-solid fa-arrow-left me-1"></i>
            Back to Dashboard

        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    @if (Model != null && Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-3">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    Course
                                </th>

                                <th>
                                    Topic
                                </th>

                                <th>
                                    Question
                                </th>

                                <th>
                                    Type
                                </th>

                                <th>
                                    Difficulty
                                </th>

                                <th>
                                    Status
                                </th>

                                <th class="text-end px-4">
                                    Actions
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var q in Model)
                            {
                                <tr class="@(q.IsDeleted ? "table-secondary" : "")">

                                


                                    <td>
                                        @(string.IsNullOrEmpty(q.CourseName)
                                            ? "-"
                                            : q.CourseName)
                                    </td>

                                    <td>
                                        @(string.IsNullOrEmpty(q.TopicName)
                                            ? "-"
                                            : q.TopicName)
                                    </td>


                                    <td>

                                        <div class="fw-semibold">

                                            @(q.QuestionText != null &&
                                              q.QuestionText.Length > 80
                                                ? q.QuestionText.Substring(0, 80) + "..."
                                                : q.QuestionText)

                                        </div>

                                    </td>


                                    <td>
                                        @q.QuestionFormat
                                    </td>


                                    <td>
                                        @q.DifficultyLevel
                                    </td>


                                    <td>

                                        @if (q.IsDeleted)
                                        {
                                            <span class="badge bg-danger">
                                                Deleted
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }

                                    </td>


                                    <td class="text-end px-4">

                                        <div class="d-flex justify-content-end gap-2">

                                            <!-- Details -->

                                            <a asp-controller="Admin"
                                               asp-action="QuestionDetails"
                                               asp-route-id="@q.Id"
                                               class="btn btn-sm btn-light text-secondary"
                                               title="Details">

                                                <i class="fa-solid fa-eye"></i>

                                            </a>


                                            @if (!q.IsDeleted)
                                            {
                                                <!-- Edit -->

                                                <a asp-controller="Admin"
                                                   asp-action="EditQuestion"
                                                   asp-route-id="@q.Id"
                                                   class="btn btn-sm btn-light text-primary"
                                                   title="Edit">

                                                    <i class="fa-solid fa-pen-to-square"></i>

                                                </a>


                                                <!-- Delete -->

                                                <form asp-controller="Admin"
                                                      asp-action="DeleteQuestionConfirmed"
                                                      asp-route-id="@q.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Are you sure you want to delete this question?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-light text-danger"
                                                            title="Delete">

                                                        <i class="fa-solid fa-trash-can"></i>

                                                    </button>

                                                </form>
                                            }
                                            else
                                            {
                                                <!-- Restore -->

                                                <form asp-controller="Admin"
                                                      asp-action="RestoreQuestion"
                                                      asp-route-id="@q.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirm('Are you sure you want to restore this question?');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-light text-success"
                                                            title="Restore">

                                                        <i class="fa-solid fa-rotate-left"></i>

                                                    </button>

                                                </form>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }
    else
    {
        <div class="alert alert-light">
            No questions found.
        </div>
    }

</div>