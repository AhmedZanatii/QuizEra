@model QuizEra.BLL.ModelVM.Questions.QuestionVM

@{
    ViewData["Title"] = "Question Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold text-dark mb-1">
                Question Details
            </h2>

            <p class="text-muted small mb-0">
                Details for the selected question.
            </p>

        </div>

        <a asp-controller="Admin"
           asp-action="Questions"
           class="btn btn-outline-secondary btn-sm">

            <i class="fa-solid fa-arrow-left me-1"></i>
            Back to Questions

        </a>

    </div>


    <div class="card border-0 shadow-sm rounded-3">

        <div class="card-body p-4">

            <!-- Topic -->

            <div class="mb-3">

                <label class="fw-semibold text-muted">
                    Topic
                </label>

                <div class="fs-5">
                    @(string.IsNullOrEmpty(Model.TopicName)
                        ? "-"
                        : Model.TopicName)
                </div>

            </div>


            <hr />


            <!-- Question -->

            <div class="mb-4">

                <label class="fw-semibold text-muted">
                    Question
                </label>

                <div class="fs-5 fw-semibold">
                    @Model.QuestionText
                </div>

            </div>


            <!-- Type / Difficulty -->

            <div class="row mb-4">

                <div class="col-md-6">

                    <label class="fw-semibold text-muted">
                        Question Format
                    </label>

                    <div>
                        <span class="badge bg-primary">
                            @Model.QuestionFormat
                        </span>
                    </div>

                </div>


                <div class="col-md-6">

                    <label class="fw-semibold text-muted">
                        Difficulty
                    </label>

                    <div>
                        <span class="badge bg-secondary">
                            @Model.DifficultyLevel
                        </span>
                    </div>

                </div>

            </div>


            <!-- Answer -->
            @if (!string.IsNullOrEmpty(Model.QuestionAnswer))
            {
                <div class="mb-4">

                    <label class="fw-semibold text-muted">
                        Answer
                    </label>

                    <div class="alert alert-light border">
                        @Model.QuestionAnswer
                    </div>

                </div>
            }


            <!-- Photo -->
            @if (!string.IsNullOrEmpty(Model.Photo))
            {
                <div class="mb-4">

                    <label class="fw-semibold text-muted">
                        Question Image
                    </label>

                    <div class="mt-2">

                        <img src="@Model.Photo"
                             alt="Question Image"
                             class="img-fluid rounded"
                             style="max-height: 300px;" />

                    </div>

                </div>
            }


            <!-- Options -->
            @if (Model.Options != null &&
                             Model.Options.Any())
            {
                <div class="mb-4">

                    <h5 class="fw-semibold mb-3">
                        Options
                    </h5>

                    <div class="list-group">

                        @foreach (var option in Model.Options)
                        {
                            <div class="list-group-item d-flex justify-content-between align-items-center">

                                <span>
                                    @option.OptionText
                                </span>

                                @if (option.IsCorrect)
                                {
                                    <span class="badge bg-success">
                                        Correct
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Incorrect
                                    </span>
                                }

                            </div>
                        }

                    </div>

                </div>
            }


            <!-- Actions -->

            <div class="d-flex justify-content-end gap-2">

                <a asp-controller="Admin"
                   asp-action="Questions"
                   class="btn btn-light">

                    Back

                </a>

                @if (!Model.IsDeleted)
                {
                    <a asp-controller="Admin"
                       asp-action="EditQuestion"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">

                        <i class="fa-solid fa-pen-to-square me-1"></i>
                        Edit

                    </a>
                }

            </div>

        </div>

    </div>

</div>