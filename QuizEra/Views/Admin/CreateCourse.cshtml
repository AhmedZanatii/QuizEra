@model QuizEra.BLL.ModelVM.Course.CreateCourseVM

@{
    ViewData["Title"] = "Create Course";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    :root {
        --qz-purple: #4D2197;
        --qz-dark-text: #1B2559;
        --qz-sub-text: #707EAE;
        --qz-bg-light: #F4F7FE;
        --qz-border-color: #E9EFFC;
        --qz-error-red: #EE5D50;
    }

    .qz-admin-card {
        background: #FFFFFF;
        border-radius: 16px;
        padding: 35px;
        border: 1px solid var(--qz-border-color);
        box-shadow: 0px 10px 30px rgba(112, 144, 176, 0.08);
        max-width: 800px;
        margin: 0 auto;
    }

    .qz-title {
        color: var(--qz-dark-text);
        font-weight: 800;
        font-size: 1.5rem;
    }

    .qz-label {
        color: var(--qz-dark-text);
        font-weight: 700;
        font-size: 0.85rem;
        margin-bottom: 6px;
    }

    .qz-input, .qz-select {
        width: 100%;
        padding: 12px 14px;
        border-radius: 10px;
        border: 1.5px solid var(--qz-border-color);
        background-color: #FFFFFF;
        font-size: 0.9rem;
        color: var(--qz-dark-text);
        outline: none;
        transition: border-color 0.2s;
    }

        .qz-input:focus, .qz-select:focus {
            border-color: var(--qz-purple);
        }

    .qz-btn-primary {
        background: var(--qz-purple);
        color: #FFFFFF;
        border-radius: 10px;
        font-weight: 700;
        padding: 11px 24px;
        border: none;
        transition: opacity 0.2s;
    }

        .qz-btn-primary:hover {
            opacity: 0.9;
            color: #FFFFFF;
        }

    .qz-btn-cancel {
        background: var(--qz-bg-light);
        color: var(--qz-sub-text);
        border-radius: 10px;
        font-weight: 600;
        padding: 11px 20px;
        text-decoration: none;
        transition: all 0.2s;
    }

        .qz-btn-cancel:hover {
            background: #E2E8F0;
            color: var(--qz-dark-text);
        }
</style>

<div class="container-fluid py-4">

    <!-- Top Navigation -->
    <div class="mb-4 max-w-800 mx-auto" style="max-width: 800px;">
        <a asp-controller="Admin" asp-action="Courses" class="btn btn-sm btn-outline-secondary rounded-2">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Courses
        </a>
    </div>

    <!-- Form Card -->
    <div class="qz-admin-card">

        <div class="mb-4">
            <h3 class="qz-title mb-1">Create New Course</h3>
            <p class="text-muted small mb-0">Fill in the course details below to publish it to the platform.</p>
        </div>

        <form asp-controller="Admin" asp-action="CreateCourse" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 text-sm mb-3"></div>

            <!-- Instructor Dropdown -->
            <div class="mb-3">
                <label asp-for="InstructorId" class="qz-label">Assign Instructor</label>
                <select asp-for="InstructorId" class="qz-select">
                    <option value="">-- Select Instructor --</option>
                    @if (ViewBag.Instructors != null)
                    {
                        @foreach (var instructor in ViewBag.Instructors)
                        {
                            <option value="@instructor.AppUserId">
                                @instructor.FirstName @instructor.LastName (@instructor.Email)
                            </option>
                        }
                    }
                </select>
                <span asp-validation-for="InstructorId" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Course Name -->
            <div class="mb-3">
                <label asp-for="CourseName" class="qz-label">Course Name</label>
                <input asp-for="CourseName" class="qz-input" placeholder="e.g. Advanced C# Programming" />
                <span asp-validation-for="CourseName" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Course Level -->
            <div class="mb-3">
                <label asp-for="CourseLevel" class="qz-label">Course Level</label>
                <select asp-for="CourseLevel" class="qz-select">
                    <option value="">-- Select Course Level --</option>
                    <option value="Beginner">Beginner</option>
                    <option value="Intermediate">Intermediate</option>
                    <option value="Advanced">Advanced</option>
                </select>
                <span asp-validation-for="CourseLevel" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Description -->
            <div class="mb-4">
                <label asp-for="CourseDescription" class="qz-label">Course Description</label>
                <textarea asp-for="CourseDescription" class="qz-input" rows="4" placeholder="Brief explanation about course goals..."></textarea>
                <span asp-validation-for="CourseDescription" class="text-danger small mt-1 d-block"></span>
            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-end gap-2 pt-2">
                <a asp-controller="Admin" asp-action="Courses" class="qz-btn-cancel">
                    Cancel
                </a>
                <button type="submit" class="qz-btn-primary">
                    <i class="fa-solid fa-plus me-1"></i> Create Course
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}