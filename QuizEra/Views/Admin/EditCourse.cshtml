@model QuizEra.BLL.ModelVM.Course.UpdateCourseVM

@{
    ViewData["Title"] = "Edit Course";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .qz-form-card {
        background: #FFFFFF;
        border: 1px solid var(--qz-border-color);
        border-radius: 20px;
        box-shadow: var(--qz-card-shadow);
    }

    .form-control:focus, .form-select:focus {
        border-color: var(--qz-purple);
        box-shadow: 0 0 0 0.25rem rgba(77, 33, 151, 0.12);
    }

    .form-control, .form-select {
        background-color: #F4F7FE;
        border-color: #E0E5F2;
        color: #1B2559;
        font-weight: 500;
        border-radius: 12px;
    }

    .btn-qz-primary {
        background-color: var(--qz-purple);
        color: #FFFFFF;
        border: none;
        border-radius: 12px;
        font-weight: 700;
        padding: 10px 24px;
        transition: all 0.2s ease;
    }

        .btn-qz-primary:hover {
            background-color: var(--qz-purple-hover);
            color: #FFFFFF;
            box-shadow: 0px 8px 20px rgba(77, 33, 151, 0.25);
        }

    .btn-qz-outline {
        border: 1px solid var(--qz-border-color);
        background: #FFFFFF;
        color: var(--qz-dark-text);
        border-radius: 12px;
        font-weight: 600;
        padding: 8px 18px;
    }

        .btn-qz-outline:hover {
            background: #F4F7FE;
            color: var(--qz-purple);
        }
</style>

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h3 class="fw-bold m-0" style="color: #1B2559;">Edit Course</h3>
        <p class="text-muted small m-0 mt-1">Update course information and assign an instructor.</p>
    </div>
    <a asp-controller="Admin" asp-action="Courses" class="btn btn-qz-outline text-decoration-none">
        <i class="fa-solid fa-arrow-left me-2"></i>Back to Courses
    </a>
</div>

<div class="qz-form-card p-4 p-md-5">
    <form asp-controller="Admin" asp-action="EditCourse" method="post">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />

        <div class="row g-4">
            <div class="col-md-6">
                <label asp-for="InstructorId" class="form-label fw-bold small text-uppercase" style="color: #A3AED0; letter-spacing: 0.5px;">Instructor</label>
                <select asp-for="InstructorId" class="form-select">
                    <option value="">-- Select Instructor --</option>
                    @foreach (var instructor in ViewBag.Instructors)
                    {
                        <option value="@instructor.AppUserId">
                            @instructor.FirstName @instructor.LastName - @instructor.Email
                        </option>
                    }
                </select>
                <span asp-validation-for="InstructorId" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="CourseName" class="form-label fw-bold small text-uppercase" style="color: #A3AED0; letter-spacing: 0.5px;">Course Name</label>
                <input asp-for="CourseName" class="form-control" placeholder="e.g. Advanced C# Programming" />
                <span asp-validation-for="CourseName" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-md-12">
                <label asp-for="CourseLevel" class="form-label fw-bold small text-uppercase" style="color: #A3AED0; letter-spacing: 0.5px;">Course Level</label>
                <select asp-for="CourseLevel" class="form-select">
                    <option value="">-- Select Course Level --</option>
                    <option value="Beginner">Beginner</option>
                    <option value="Intermediate">Intermediate</option>
                    <option value="Advanced">Advanced</option>
                </select>
                <span asp-validation-for="CourseLevel" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="col-12">
                <label asp-for="CourseDescription" class="form-label fw-bold small text-uppercase" style="color: #A3AED0; letter-spacing: 0.5px;">Course Description</label>
                <textarea asp-for="CourseDescription" class="form-control" rows="5" placeholder="Write a summary about this course..."></textarea>
                <span asp-validation-for="CourseDescription" class="text-danger small mt-1 d-block"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 mt-5 pt-4 border-top">
            <a asp-controller="Admin" asp-action="Courses" class="btn btn-qz-outline text-decoration-none px-4">Cancel</a>
            <button type="submit" class="btn btn-qz-primary px-4">
                <i class="fa-solid fa-floppy-disk me-2"></i>Save Changes
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}