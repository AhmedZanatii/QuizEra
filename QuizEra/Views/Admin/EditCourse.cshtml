@model QuizEra.BLL.ModelVM.Course.UpdateCourseVM

@{
    ViewData["Title"] = "Edit Course";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">

    <div class="mb-4">
        <a asp-controller="Admin"
           asp-action="Courses"
           class="btn btn-outline-secondary btn-sm">
            <i class="fa-solid fa-arrow-left me-1"></i>
            Back to Courses
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-3">

        <div class="card-header bg-white border-0 p-4">
            <h3 class="fw-bold mb-1">
                Edit Course
            </h3>

            <p class="text-muted small mb-0">
                Update course information and assign an instructor.
            </p>
        </div>

        <div class="card-body p-4">

            <form asp-controller="Admin"
                  asp-action="EditCourse"
                  method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                

                <!-- Instructor -->
                <div class="mb-3">

                    <label asp-for="InstructorId"
                           class="form-label fw-semibold">
                        Instructor
                    </label>

                    <select asp-for="InstructorId"
                            class="form-select">

                        <option value="">
                            -- Select Instructor --
                        </option>

                        @foreach (var instructor in ViewBag.Instructors)
                        {
                            <option value="@instructor.AppUserId">
                                @instructor.FirstName @instructor.LastName
                                - @instructor.Email
                            </option>
                        }

                    </select>

                    <span asp-validation-for="InstructorId"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Course Name -->
                <div class="mb-3">

                    <label asp-for="CourseName"
                           class="form-label fw-semibold">
                        Course Name
                    </label>

                    <input asp-for="CourseName"
                           class="form-control" />

                    <span asp-validation-for="CourseName"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Course Level -->
                <div class="mb-3">

                    <label asp-for="CourseLevel"
                           class="form-label fw-semibold">
                        Course Level
                    </label>

                    <select asp-for="CourseLevel"
                            class="form-select">

                        <option value="">
                            -- Select Course Level --
                        </option>

                        <option value="Beginner">
                            Beginner
                        </option>

                        <option value="Intermediate">
                            Intermediate
                        </option>

                        <option value="Advanced">
                            Advanced
                        </option>

                    </select>

                    <span asp-validation-for="CourseLevel"
                          class="text-danger small">
                    </span>

                </div>

                <!-- Description -->
                <div class="mb-4">

                    <label asp-for="CourseDescription"
                           class="form-label fw-semibold">
                        Course Description
                    </label>

                    <textarea asp-for="CourseDescription"
                              class="form-control"
                              rows="5"></textarea>

                    <span asp-validation-for="CourseDescription"
                          class="text-danger small">
                    </span>

                </div>

                <div class="d-flex justify-content-end gap-2">

                    <a asp-controller="Admin"
                       asp-action="Courses"
                       class="btn btn-light">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary px-4">
                        <i class="fa-solid fa-floppy-disk me-1"></i>
                        Save Changes
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}