@using Microsoft.AspNetCore.Mvc.Rendering
@model QuizEra.BLL.ModelVM.Topic.CreateTopicVM

@{
    ViewData["Title"] = "Create Topic";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="mb-4">
        <h3 class="fw-bold text-dark m-0">Create Topic</h3>
        <p class="text-muted small mb-0">Create a new topic and assign it to a course.</p>
    </div>

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form asp-controller="Admin" asp-action="CreateTopic" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="CourseId" class="form-label fw-semibold">
                        Course
                    </label>

                    <select asp-for="CourseId"
                            class="form-select"
                            asp-items="@(new SelectList(ViewBag.Courses, "Id", "CourseName"))">

                        <option value="">-- Select Course --</option>

                    </select>

                    <span asp-validation-for="CourseId"
                          class="text-danger small">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold">Topic Name</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Topics" class="btn btn-light">Cancel</a>
                    <button type="submit" class="btn btn-primary">Create Topic</button>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
