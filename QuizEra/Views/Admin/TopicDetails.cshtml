@model QuizEra.BLL.ModelVM.Topic.TopicDetailsVM

@{
    ViewData["Title"] = "Topic Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .qz-card {
        background: #FFFFFF;
        border: 1px solid var(--qz-border-color);
        border-radius: 20px;
        box-shadow: var(--qz-card-shadow);
    }

    .btn-qz-outline {
        border: 1px solid var(--qz-border-color);
        background: #FFFFFF;
        color: var(--qz-dark-text);
        border-radius: 12px;
        font-weight: 600;
        padding: 8px 18px;
    }

        .btn-qz-outline:hover {
            background: #F4F7FE;
            color: var(--qz-purple);
        }

    .btn-qz-primary {
        background-color: var(--qz-purple);
        color: #FFFFFF;
        border: none;
        border-radius: 12px;
        font-weight: 600;
        padding: 8px 18px;
        transition: all 0.2s ease;
    }

        .btn-qz-primary:hover {
            background-color: var(--qz-purple-hover);
            color: #FFFFFF;
            box-shadow: 0px 6px 16px rgba(77, 33, 151, 0.25);
        }

    .question-item {
        background-color: #FFFFFF;
        border: 1px solid var(--qz-border-color);
        border-radius: 14px;
        padding: 16px 20px;
        transition: all 0.2s ease;
    }

        .question-item:hover {
            background-color: #F8F9FF;
            border-color: rgba(112, 85, 230, 0.2);
        }

    .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #E0E5F2;
        background-color: #FFFFFF;
        color: #1B2559;
        transition: all 0.2s ease;
    }

        .action-btn:hover {
            background-color: #F4F7FE;
            color: var(--qz-purple);
        }
</style>

<!-- Header -->
<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h3 class="fw-bold m-0" style="color: #1B2559;">Topic Details</h3>
        <p class="text-muted small m-0 mt-1">Overview of topic info and associated questions.</p>
    </div>
    <a asp-controller="Admin" asp-action="Topics" class="btn btn-qz-outline text-decoration-none">
        <i class="fa-solid fa-arrow-left me-2"></i>Back to Topics
    </a>
</div>

<div class="qz-card p-4 p-md-5">
    <!-- Topic Header Info -->
    <div class="d-flex align-items-center justify-content-between mb-4 pb-4 border-bottom" style="border-color: #F4F7FE !important;">
        <div class="d-flex align-items-center gap-3">
            <div class="rounded-circle d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; background-color: #F4F7FE; color: var(--qz-purple);">
                <i class="fa-solid fa-folder-tree fs-4"></i>
            </div>
            <div>
                <h4 class="fw-bold m-0" style="color: #1B2559;">@Model.Name</h4>
                <span class="text-muted small">Course ID: #@Model.CourseId</span>
            </div>
        </div>
        <a asp-controller="Admin" asp-action="EditTopic" asp-route-id="@Model.Id" class="btn btn-qz-primary text-decoration-none">
            <i class="fa-solid fa-pen-to-square me-2"></i>Edit Topic
        </a>
    </div>

    <!-- Questions Section -->
    <div>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="fw-bold m-0" style="color: #1B2559;">Associated Questions</h6>
            <span class="badge rounded-pill px-3 py-2" style="background-color: #F4F7FE; color: var(--qz-purple); font-weight: 700;">
                @(Model.Questions != null ? Model.Questions.Count() : 0) Questions
            </span>
        </div>

        @if (Model.Questions != null && Model.Questions.Any())
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var q in Model.Questions)
                {
                    <div class="question-item d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                        <div>
                            <div class="fw-bold mb-1" style="color: #1B2559;">
                                @q.QuestionText
                            </div>
                            <div class="d-flex gap-2 align-items-center text-muted small">
                                <span><i class="fa-solid fa-layer-group me-1"></i>Format: <strong>@q.QuestionFormat</strong></span>
                                <span>•</span>
                                <span><i class="fa-solid fa-gauge-high me-1"></i>Difficulty: <strong>@q.DifficultyLevel</strong></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-controller="Admin" asp-action="QuestionDetails" asp-route-id="@q.Id" class="action-btn text-decoration-none" title="Details">
                                <i class="fa-solid fa-eye"></i>
                            </a>

                            @if (!q.IsDeleted)
                            {
                                <a asp-controller="Admin" asp-action="EditQuestion" asp-route-id="@q.Id" class="action-btn text-decoration-none" title="Edit">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 rounded-4" style="background-color: #F4F7FE;">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 60px; height: 60px; background-color: #FFFFFF; color: #A3AED0;">
                    <i class="fa-solid fa-circle-question fs-3"></i>
                </div>
                <h6 class="fw-bold" style="color: #1B2559;">No Questions Found</h6>
                <p class="text-muted small m-0">There are no questions assigned to this topic yet.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}