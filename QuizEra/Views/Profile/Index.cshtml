@model QuizEra.BLL.ModelVM.Profile.ProfileVM

@{
    ViewData["Title"] = "My Profile";

    Layout = Model.Role?.ToLower() == "instructor"
        ? "_InstructorLayout"
        : "_StudentLayout";

    string roleBadgeClass = Model.Role?.ToLower() == "instructor"
        ? "bg-success bg-opacity-10 text-success border-success-subtle"
        : "badge-qe-purple border-purple-subtle";

    string headerGradient = "linear-gradient(135deg, #0d0a27 0%, #5031b8 100%)";
}

<style>
    .btn-qe-primary {
        background-color: var(--qe-primary-purple);
        border-color: var(--qe-primary-purple);
        color: #ffffff;
    }

        .btn-qe-primary:hover {
            background-color: var(--qe-active-bg);
            border-color: var(--qe-active-bg);
            color: #ffffff;
            box-shadow: 0 4px 15px rgba(80, 49, 184, 0.3);
        }

    .badge-qe-purple {
        background-color: var(--qe-primary-soft);
        color: var(--qe-primary-purple);
    }

    .text-qe-purple {
        color: var(--qe-primary-purple) !important;
    }
</style>

<div class="container-fluid py-2">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <div class="card dashboard-card border-0 shadow-sm overflow-hidden">
                <div class="py-5 text-center position-relative" style="background: @headerGradient; min-height: 140px;">
                    <div class="position-absolute start-50 translate-middle-x" style="bottom: -50px;">
                        @if (!string.IsNullOrEmpty(Model.ProfileImage))
                        {
                            <img src="@Model.ProfileImage"
                                 alt="Profile Image"
                                 class="rounded-circle border border-4 border-white shadow-sm"
                                 style="width:120px; height:120px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="rounded-circle bg-white text-qe-purple border border-4 border-white shadow-sm d-flex align-items-center justify-content-center fw-bold mx-auto"
                                 style="width:120px; height:120px; font-size:42px;">
                                @(string.IsNullOrEmpty(Model.FirstName) ? "U" : Model.FirstName.Substring(0, 1).ToUpper())
                            </div>
                        }
                    </div>
                </div>

                <div class="card-body pt-5 px-4 px-md-5 text-center mt-3">

                    <h3 class="fw-bold text-dark mb-1">@Model.FullName</h3>
                    <span class="badge border rounded-pill px-3 py-2 fw-semibold fs-6 mb-4 @roleBadgeClass">
                        <i class="fa-solid fa-user-shield me-1"></i> @Model.Role
                    </span>

                    <hr class="my-4 opacity-10" />

                    <div class="row g-3 text-start mb-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border-0">
                                <span class="text-muted extra-small d-block fw-bold text-uppercase mb-1">
                                    <i class="fa-regular fa-envelope text-qe-purple me-2"></i>Email Address
                                </span>
                                <span class="fw-semibold text-dark small">@Model.Email</span>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="p-3 bg-light rounded-3 border-0">
                                <span class="text-muted extra-small d-block fw-bold text-uppercase mb-1">
                                    <i class="fa-solid fa-phone text-qe-purple me-2"></i>Phone Number
                                </span>
                                <span class="fw-semibold text-dark small">
                                    @(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-center gap-3 pt-2 pb-3">
                        <a asp-action="Edit" class="btn btn-qe-primary px-4 py-2 fw-bold rounded-3">
                            <i class="fa-solid fa-pen-to-square me-2"></i>Edit Profile
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>