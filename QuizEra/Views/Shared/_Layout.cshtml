@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Console</title>

    <!-- Local Bootstrap CSS from wwwroot -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <!-- Custom External Layout CSS -->
    <link rel="stylesheet" href="~/css/LayoutStyle.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QuizEra.styles.css" asp-append-version="true" />

</head>
<body class="d-flex">

    <!-- Sidebar -->
    <aside class="sidebar d-flex flex-column p-3">
        <!-- Logo -->
        <div class="d-flex align-items-center mb-4 px-2">
            <i class="bi bi-mortarboard-fill text-primary fs-3 me-2"></i>
            <div>
                <h6 class="fw-bold mb-0 text-primary">QuizEra</h6>
                <small class="text-muted fs-7">Exam Management</small>
            </div>
        </div>

        <!-- Primary Action Button -->
        <button class="btn btn-sidebar-primary w-100 mb-4 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2">
            <i class="bi bi-plus-lg"></i> Create New Exam
        </button>

        <!-- Navigation Links -->
        <partial name="_NavigationLinks" />
    </aside>

    <!-- Main Content Area -->
    <div class="main-wrapper">
        <!-- Top Navbar -->
        <header class="top-navbar d-flex align-items-center justify-content-between px-4">
            <h6 class="fw-semibold mb-0">Course Management</h6>
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-light btn-sm rounded-circle" type="button"><i class="bi bi-bell"></i></button>
                <button class="btn btn-light btn-sm rounded-circle" type="button"><i class="bi bi-question-circle"></i></button>
                <button class="btn btn-light btn-sm rounded-circle" type="button"><i class="bi bi-gear"></i></button>
                <img src="https://i.pravatar.cc/40" class="rounded-circle ms-2" width="32" height="32" alt="Profile" />
            </div>
        </header>

        <!-- Dynamic View Content -->
        <main class="p-4">
            @RenderBody()
        </main>
    </div>

    <!-- Local Bootstrap JS Bundle from wwwroot -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
