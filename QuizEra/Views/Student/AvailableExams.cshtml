@model IEnumerable<QuizEra.BLL.ModelVM.Exam.ExamVM>

@{
    ViewData["Title"] = "Available Exams";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    var exams = Model ?? Enumerable.Empty<QuizEra.BLL.ModelVM.Exam.ExamVM>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1">Available Exams</h3>
        <p class="text-muted small mb-0">Exams currently open for you to take.</p>
    </div>
    <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2">@exams.Count() exams</span>
</div>

@if (!exams.Any())
{
    <div class="card dashboard-card border-0 p-5 text-center">
        <i class="fa-solid fa-file-circle-check fs-1 text-secondary opacity-50 mb-3"></i>
        <h5 class="fw-bold">No Available Exams</h5>
        <p class="text-muted small mb-0">There are no open exams at the moment.</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var exam in exams)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card dashboard-card border h-100">
                    <div class="card-body p-4 d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div class="icon-shape bg-primary bg-opacity-10 text-primary">
                                <i class="fa-solid fa-file-pen"></i>
                            </div>
                            <span class="badge bg-light text-dark">@exam.Duration min</span>
                        </div>
                        <h5 class="fw-bold mb-1">@exam.Title</h5>
                        <p class="text-muted small mb-3">@exam.CourseName</p>
                        <div class="small text-muted mb-4">
                            @if (exam.TopicNames?.Any() == true)
                            {
                                <div><i class="fa-solid fa-layer-group me-2 text-primary"></i>
                                    @string.Join(", ", exam.TopicNames)
                                </div>
                            }
                            <div class="mt-2"><i class="fa-solid fa-calendar-days me-2 text-primary"></i>Closes @exam.EndDate.ToString("dd MMM yyyy")</div>
                        </div>
                        <a asp-controller="TakeExam" asp-action="StartExam" asp-route-id="@exam.Id" class="btn btn-primary mt-auto">
                            <i class="fa-solid fa-play me-2"></i>Take Exam
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
