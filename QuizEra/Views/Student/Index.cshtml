@{
    ViewData["Title"] = "Student Home";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="row justify-content-center my-4">
    <div class="col-md-9 col-lg-8">
        <div class="card dashboard-card p-5 text-center">
            <div class="card-body">
                <div class="mb-4">
                    <div class="icon-shape bg-primary bg-opacity-10 text-primary mx-auto" style="width: 80px; height: 80px; font-size: 2.5rem; border-radius: 50%;">
                        <i class="fa-solid fa-graduation-cap"></i>
                    </div>
                </div>

                <h2 class="fw-bold text-dark mb-2">Welcome to QuizEra!</h2>
                <span class="badge bg-primary bg-opacity-10 text-primary fs-6 px-3 py-2 rounded-pill mb-3">Student Portal</span>

                <p class="text-muted fs-5 mb-4">
                    Explore your courses, take exams, and track your academic progress with ease.
                </p>

            </div>
        </div>
    </div>
</div>