@model IEnumerable<QuizEra.BLL.ModelVM.StudentExamAttempt.StudentExamAttemptVM>

@{
    ViewData["Title"] = "My Results";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    var attempts = Model ?? Enumerable.Empty<QuizEra.BLL.ModelVM.StudentExamAttempt.StudentExamAttemptVM>();
    var completedCount = attempts.Count(a => a.EndTime.HasValue);
}

<!-- Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">My Results & Performance</h3>
        <p class="text-muted small mb-0">Track your completed exam scores and resume active attempts.</p>
    </div>
</div>

<!-- Stat Cards Overview -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6">
        <div class="card dashboard-card p-3 border-0">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted extra-small text-uppercase fw-bold">Total Attempts</span>
                    <h3 class="fw-bold text-dark mb-0 mt-1">@attempts.Count()</h3>
                </div>
                <div class="icon-shape bg-primary bg-opacity-10 text-primary p-3 rounded-3">
                    <i class="fa-solid fa-layer-group fs-4"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6">
        <div class="card dashboard-card p-3 border-0">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <span class="text-muted extra-small text-uppercase fw-bold">Completed</span>
                    <h3 class="fw-bold text-success mb-0 mt-1">@completedCount</h3>
                </div>
                <div class="icon-shape bg-success bg-opacity-10 text-success p-3 rounded-3">
                    <i class="fa-solid fa-circle-check fs-4"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Results Table / Empty State -->
@if (!attempts.Any())
{
    <div class="card dashboard-card border-0 p-5 text-center shadow-sm">
        <div class="icon-shape bg-light text-secondary rounded-circle mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
            <i class="fa-solid fa-square-poll-vertical"></i>
        </div>
        <h5 class="fw-bold text-dark mb-1">No Results Available</h5>
        <p class="text-muted small mb-0">You haven't attempted any exams yet. Your performance metrics will show up here.</p>
    </div>
}
else
{
    <div class="card dashboard-card border-0 overflow-hidden shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="bg-light border-bottom">
                    <tr>
                        <th class="ps-4 py-3 text-secondary extra-small text-uppercase fw-bold">Exam</th>
                        <th class="py-3 text-secondary extra-small text-uppercase fw-bold">Started Date</th>
                        <th class="py-3 text-secondary extra-small text-uppercase fw-bold">Status</th>
                        <th class="text-end pe-4 py-3 text-secondary extra-small text-uppercase fw-bold">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var attempt in attempts)
                    {
                        var isCompleted = attempt.EndTime.HasValue;

                        <tr>
                            <!-- Exam ID / Name -->
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-3 p-2 fw-bold small">
                                        <i class="fa-solid fa-file-lines"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark">Exam #@attempt.ExamId</div>
                                        <small class="text-muted extra-small">Attempt ID: @attempt.AttemptId</small>
                                    </div>
                                </div>
                            </td>

                            <!-- Start Time -->
                            <td class="text-muted small fw-medium">
                                <i class="fa-regular fa-clock me-1 text-primary"></i>
                                @attempt.StartTime.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                            </td>

                            <!-- Status Badge -->
                            <td>
                                @if (isCompleted)
                                {
                                    <span class="badge bg-success-subtle text-success fw-semibold px-2.5 py-1.5 rounded-2">
                                        <i class="fa-solid fa-circle-check me-1"></i>Completed
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis fw-semibold px-2.5 py-1.5 rounded-2">
                                        <i class="fa-solid fa-spinner fa-spin me-1"></i>In Progress
                                    </span>
                                }
                            </td>

                            <!-- Action Button -->
                            <td class="text-end pe-4">
                                @if (isCompleted)
                                {
                                    <a asp-controller="TakeExam" asp-action="Result" asp-route-examId="@attempt.ExamId" class="btn btn-sm btn-outline-primary fw-semibold px-3 rounded-2">
                                        <i class="fa-solid fa-chart-pie me-1"></i>Details
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="TakeExam" asp-action="StartExam" asp-route-id="@attempt.ExamId" class="btn btn-sm btn-primary fw-semibold px-3 rounded-2">
                                        <i class="fa-solid fa-arrow-right-to-bracket me-1"></i>Continue
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}