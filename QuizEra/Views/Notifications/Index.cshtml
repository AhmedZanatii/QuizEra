@model IEnumerable<QuizEra.BLL.ModelVM.Notification.NotificationVM>

@{
    ViewData["Title"] = "My Notifications";
    Layout = "_StudentLayout";
}

<style>
    .btn-qe-primary {
        background-color: var(--qe-primary-purple);
        border-color: var(--qe-primary-purple);
        color: #ffffff;
    }

        .btn-qe-primary:hover {
            background-color: var(--qe-active-bg);
            border-color: var(--qe-active-bg);
            color: #ffffff;
        }

    .icon-qe-purple {
        background-color: var(--qe-primary-soft);
        color: var(--qe-primary-purple);
    }

    .text-qe-purple {
        color: var(--qe-primary-purple) !important;
    }

    .notification-item {
        transition: all 0.2s ease-in-out;
        border-left: 4px solid transparent;
    }

        .notification-item:hover {
            background-color: var(--qe-primary-soft);
            border-left-color: var(--qe-primary-purple);
        }
</style>

<div class="container-fluid py-2">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark m-0">Notifications</h3>
            <p class="text-muted small mb-0">Stay updated with course announcements, new exams, and system activity.</p>
        </div>
        @if (Model != null && Model.Any())
        {
            <span class="badge bg-primary bg-opacity-10 text-primary rounded-pill px-3 py-2 fw-semibold fs-6">
                <i class="fa-solid fa-bell me-1"></i> @Model.Count() Notifications
            </span>
        }
    </div>

    <div class="row">
        <div class="col-lg-10 col-xl-9 mx-auto">
            @if (Model == null || !Model.Any())
            {
                <div class="card dashboard-card border-0 text-center py-5 shadow-sm rounded-4">
                    <div class="card-body">
                        <div class="icon-shape icon-qe-purple rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem;">
                            <i class="fa-solid fa-bell-slash"></i>
                        </div>
                        <h5 class="fw-bold text-dark mb-1">No notifications yet</h5>
                        <p class="text-muted small mb-0">When exams or updates are posted, they will appear here.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="card dashboard-card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="list-group list-group-flush">
                        @foreach (var item in Model)
                        {
                            <!-- Re-routed to Student's Available Exams Action -->
                            <a asp-controller="Student" asp-action="Exams"
                               class="list-group-item list-group-item-action p-3.5 border-bottom notification-item d-flex align-items-start justify-content-between text-decoration-none">

                                <div class="d-flex align-items-start gap-3">
                                    <div class="icon-shape icon-qe-purple p-3 rounded-3 flex-shrink-0 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                        <i class="fa-solid fa-bell fs-5"></i>
                                    </div>
                                    <div>
                                        <h6 class="fw-bold text-dark mb-1">@item.Title</h6>
                                        <p class="text-secondary small mb-1">@item.Message</p>
                                        <small class="text-muted extra-small">
                                            <i class="fa-regular fa-clock me-1 text-qe-purple"></i>@item.TimeAgo
                                        </small>
                                    </div>
                                </div>

                                <div class="text-muted small ms-2 my-auto">
                                    <i class="fa-solid fa-chevron-right text-secondary opacity-50"></i>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>