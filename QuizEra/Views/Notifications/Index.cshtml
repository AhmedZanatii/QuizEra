@model IEnumerable<QuizEra.BLL.ModelVM.Notification.NotificationVM>

@{
    ViewData["Title"] = "My Notifications";
    Layout = "_StudentLayout";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-bell-fill text-primary me-2"></i>Notifications</h2>
            <p class="text-muted small mb-0">Stay updated with course announcements and new exams</p>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-10 mx-auto">
            @if (!Model.Any())
            {
                <div class="card shadow-sm border-0 text-center py-5">
                    <div class="card-body">
                        <i class="bi bi-bell-slash text-muted display-4"></i>
                        <h5 class="mt-3 text-secondary">No notifications yet</h5>
                        <p class="text-muted small">When exams or updates are posted, they will appear here.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="list-group shadow-sm border-0">
                    @foreach (var item in Model)
                    {
                        <a href="@(item.ExamId.HasValue ? Url.Action("Details", "Exam", new { id = item.ExamId }) : "#")"
                           class="list-group-item list-group-item-action p-3 border-start-0 border-end-0 border-top-0 border-bottom d-flex align-items-start justify-content-between )">

                            <div class="d-flex align-items-start">
                                <div class="badge rounded-circle bg-primary-subtle text-primary p-2 me-3 mt-1">
                                    <i class="bi bi-journal-text fs-5"></i>
                                </div>
                                <div>
                                    <h6 class="mb-1 text-dark">@item.Title</h6>
                                    <p class="mb-1 text-secondary fw-normal small">@item.Message</p>
                                    <small class="text-muted fw-normal extra-small">
                                        <i class="bi bi-clock me-1"></i>@item.TimeAgo
                                    </small>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }
        </div>
    </div>
</div>
