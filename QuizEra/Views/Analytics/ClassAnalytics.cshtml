@model QuizEra.BLL.ModelVM.Analytics.ClassAnalyticsVM

@{
    ViewData["Title"] = "Class Analytics";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<div class="container-fluid py-4 px-md-4">
    @if (Model == null)
    {
        <!-- EMPTY STATE -->
        <div class="card border-0 shadow-sm rounded-4 bg-light text-center py-5">
            <div class="card-body">
                <div class="icon-shape bg-purple-subtle text-purple mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 70px; height: 70px;">
                    <i class="fa-solid fa-chart-pie fs-3"></i>
                </div>
                <h4 class="fw-bold text-dark">No Class Data Found</h4>
                <p class="text-muted mb-4">
                    We couldn't find any performance data for this exam. Please select a valid exam to view analytics.
                </p>
                <a asp-controller="Instructor" asp-action="Index" class="btn btn-purple-solid fw-semibold px-4 shadow-sm rounded-3">
                    <i class="fa-solid fa-arrow-left me-2"></i>Return to Dashboard
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- PAGE HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <div class="mb-2">
                    <a asp-controller="Instructor" asp-action="Index" class="text-decoration-none text-muted small fw-medium">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
                    </a>
                </div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-purple-subtle text-purple border border-purple-subtle rounded-pill px-3 py-1.5 fw-semibold">
                        <i class="fa-solid fa-chart-line me-1"></i> Class Performance
                    </span>
                </div>
                <h2 class="fw-bold text-dark m-0">@Model.ExamTitle</h2>
            </div>
        </div>

        <!-- TOP STATS CARDS -->
        <div class="row g-3 mb-4">
            <!-- Average Score -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-2">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted text-uppercase fw-bold fs-7 tracking-wider d-block mb-1">Average Score</span>
                            <h2 class="display-6 fw-extrabold text-purple mb-0">@Model.AverageScore.ToString("0.0")</h2>
                        </div>
                        <div class="rounded-4 p-3 d-flex align-items-center justify-content-center bg-purple-subtle text-purple icon-shape">
                            <i class="fa-solid fa-calculator fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Highest Score -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-2">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted text-uppercase fw-bold fs-7 tracking-wider d-block mb-1">Highest Score</span>
                            <h2 class="display-6 fw-extrabold text-dark mb-0">@Model.HighestScore</h2>
                        </div>
                        <div class="rounded-4 p-3 d-flex align-items-center justify-content-center bg-purple-subtle text-purple icon-shape">
                            <i class="fa-solid fa-trophy fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Lowest Score -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-2">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted text-uppercase fw-bold fs-7 tracking-wider d-block mb-1">Lowest Score</span>
                            <h2 class="display-6 fw-extrabold text-muted mb-0">@Model.LowestScore</h2>
                        </div>
                        <div class="rounded-4 p-3 d-flex align-items-center justify-content-center bg-light text-secondary icon-shape border">
                            <i class="fa-solid fa-arrow-down-wide-short fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- STUDENT RANKINGS TABLE -->
            <div class="col-lg-8">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h4 class="fw-bold text-dark m-0"><i class="fa-solid fa-ranking-star text-purple me-2"></i>Student Rankings</h4>
                </div>
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light border-bottom">
                                    <tr>
                                        <th class="ps-4 py-3 text-muted text-uppercase fs-7 fw-bold" style="width: 100px;">Rank</th>
                                        <th class="py-3 text-muted text-uppercase fs-7 fw-bold">Student Name</th>
                                        <th class="pe-4 py-3 text-end text-muted text-uppercase fs-7 fw-bold">Score</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var student in Model.StudentRankings.OrderBy(s => s.Rank))
                                    {
                                        <tr>
                                            <td class="ps-4 py-3">
                                                @if (student.Rank == 1)
                                                {
                                                    <span class="badge bg-purple text-white rounded-circle p-2 d-inline-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                                                        <i class="fa-solid fa-crown fs-7"></i>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="fw-bold text-purple fs-6">#@student.Rank</span>
                                                }
                                            </td>
                                            <td class="py-3 fw-semibold text-dark">
                                                @student.StudentName
                                            </td>
                                            <td class="pe-4 py-3 text-end">
                                                <span class="badge bg-purple-subtle text-purple border border-purple-subtle rounded-pill px-3 py-1.5 fw-bold">
                                                    @student.Score Marks
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN: MISSED QUESTIONS & GRADE DISTRIBUTION -->
            <div class="col-lg-4">
                <!-- FREQUENTLY MISSED QUESTIONS -->
                <h4 class="fw-bold text-dark mb-3"><i class="fa-solid fa-triangle-exclamation text-purple me-2"></i>Toughest Questions</h4>
                <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @foreach (var mq in Model.FrequentlyMissedQuestions.OrderByDescending(m => m.MissCount).Take(5))
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center py-3 px-3 border-bottom-subtle">
                                    <div class="text-truncate me-2" style="max-width: 220px;" title="@mq.QuestionText">
                                        <span class="fw-medium text-dark small d-block text-truncate">@mq.QuestionText</span>
                                    </div>
                                    <span class="badge bg-purple-subtle text-purple border border-purple-subtle rounded-pill px-2.5 py-1 small fw-semibold flex-shrink-0">
                                        @mq.MissCount missed
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- GRADE DISTRIBUTION -->
                <h4 class="fw-bold text-dark mb-3"><i class="fa-solid fa-chart-column text-purple me-2"></i>Grade Distribution</h4>
                <div class="card border-0 shadow-sm rounded-4 p-3">
                    <div class="card-body p-2">
                        @foreach (var grade in Model.GradeDistribution)
                        {
                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                <span class="fw-bold text-dark">@grade.Key</span>
                                <span class="badge bg-light text-dark border px-2.5 py-1 rounded-2">
                                    @grade.Value Student@(grade.Value == 1 ? "" : "s")
                                </span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .fs-7 {
        font-size: 0.75rem;
    }

    .tracking-wider {
        letter-spacing: 0.08em;
    }

    .fw-extrabold {
        font-weight: 800;
    }

    .icon-shape {
        width: 56px;
        height: 56px;
    }

    .bg-purple-subtle {
        background-color: rgba(111, 66, 193, 0.1) !important;
    }

    .border-purple-subtle {
        border-color: rgba(111, 66, 193, 0.2) !important;
    }

    .text-purple {
        color: #6f42c1 !important;
    }

    .bg-purple {
        background-color: #6f42c1 !important;
    }

    .btn-purple-solid {
        background-color: #6f42c1;
        color: #ffffff;
        border: none;
        transition: all 0.2s ease;
    }

        .btn-purple-solid:hover {
            background-color: #5a2898;
            color: #ffffff;
        }
</style>