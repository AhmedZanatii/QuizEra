@model QuizEra.BLL.ModelVM.Analytics.ClassAnalyticsVM

@{
    ViewData["Title"] = "Class Analytics";
}

<div class="container mt-4 mb-5">
    @if (Model == null)
    {
        <!-- Empty State -->
        <div class="empty-questions text-center py-5 bg-white border rounded-4 mt-4 shadow-sm">
            <div class="empty-icon-container mb-3" style="width: 70px; height: 70px; margin: auto; border-radius: 50%; background: #f1f5f9; color: #94a3b8; display: flex; align-items: center; justify-content: center; font-size: 30px;">
                <i class="bi bi-bar-chart-line"></i>
            </div>
            <h5 class="mt-3 fw-bold">No Class Data Found</h5>
            <p class="text-muted mb-4">
                We couldn't find any performance data for this exam. Please select a valid exam to view analytics.
            </p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-arrow-left me-1"></i> Return Home
            </a>
        </div>
    }
    else
    {
        <!-- Header -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4 p-md-5">
                <span class="badge bg-light text-primary mb-3 px-3 py-2 rounded-pill">
                    <i class="bi bi-bar-chart-fill me-1"></i> Class Performance
                </span>
                <h1 class="fw-bold mb-0">@Model.ExamTitle</h1>
            </div>
        </div>

        <!-- Top Stats -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 p-4 text-center">
                    <h5 class="text-muted mb-2">Average Score</h5>
                    <h2 class="fw-bold text-primary mb-0">@Model.AverageScore.ToString("0.0")</h2>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 p-4 text-center">
                    <h5 class="text-muted mb-2">Highest Score</h5>
                    <h2 class="fw-bold text-success mb-0">@Model.HighestScore</h2>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100 p-4 text-center">
                    <h5 class="text-muted mb-2">Lowest Score</h5>
                    <h2 class="fw-bold text-danger mb-0">@Model.LowestScore</h2>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Student Rankings -->
            <div class="col-lg-8 mb-4">
                <h4 class="fw-bold mb-3">Student Rankings</h4>
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead class="bg-light">
                                <tr>
                                    <th class="ps-4 py-3">Rank</th>
                                    <th class="py-3">Student Name</th>
                                    <th class="pe-4 py-3 text-end">Score</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var student in Model.StudentRankings.OrderBy(s => s.Rank))
                                {
                                    <tr>
                                        <td class="ps-4 py-3 fw-bold text-primary">#@student.Rank</td>
                                        <td class="py-3">@student.StudentName</td>
                                        <td class="pe-4 py-3 text-end fw-bold">@student.Score</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Right Column: Missed Questions & Grades -->
            <div class="col-lg-4 mb-4">
                <!-- Frequently Missed Questions -->
                <h4 class="fw-bold mb-3">Toughest Questions</h4>
                <div class="card border-0 shadow-sm mb-4">
                    <ul class="list-group list-group-flush rounded-3">
                        @foreach (var mq in Model.FrequentlyMissedQuestions.OrderByDescending(m => m.MissCount).Take(5))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3">
                                <div class="ms-2 me-auto">
                                    <div class="text-truncate" style="max-width: 200px;" title="@mq.QuestionText">
                                        @mq.QuestionText
                                    </div>
                                </div>
                                <span class="badge bg-danger rounded-pill">@mq.MissCount missed</span>
                            </li>
                        }
                    </ul>
                </div>

                <!-- Grade Distribution -->
                <h4 class="fw-bold mb-3">Grade Distribution</h4>
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        @foreach (var grade in Model.GradeDistribution)
                        {
                            <div class="d-flex justify-content-between mb-2 border-bottom pb-2">
                                <span class="fw-bold">@grade.Key</span>
                                <span class="text-muted">@grade.Value Student@(grade.Value == 1 ? "" : "s")</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>