@model QuizEra.BLL.ModelVM.Analytics.StudentAnalyticsVM

@{
    ViewData["Title"] = "Exam Results";
}

<div class="container mt-4 mb-5">

    @if (Model == null)
    {
        <!-- Empty State -->
        <div class="empty-questions text-center py-5 bg-white border rounded-4 mt-4 shadow-sm">
            <div class="empty-icon-container mb-3" style="width: 70px; height: 70px; margin: auto; border-radius: 50%; background: #f1f5f9; color: #94a3b8; display: flex; align-items: center; justify-content: center; font-size: 30px;">
                <i class="bi bi-clipboard-x"></i>
            </div>
            <h5 class="mt-3 fw-bold">No Results Found</h5>
            <p class="text-muted mb-4">
                We couldn't find any data for this exam attempt. Please select a valid exam from your history.
            </p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-arrow-left me-1"></i> Return Home
            </a>
        </div>
    }
    else
    {
        <!-- Header -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4 p-md-5 d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-light text-primary mb-3 px-3 py-2 rounded-pill">
                        <i class="bi bi-person-badge me-1"></i> @Model.StudentName
                    </span>
                    <h1 class="fw-bold mb-1">@Model.ExamTitle</h1>
                </div>
                <div class="text-end">
                    @if (Model.IsPassed)
                    {
                        <h2 class="text-success fw-bold"><i class="bi bi-check-circle-fill me-2"></i>Pass</h2>
                    }
                    else
                    {
                        <h2 class="text-danger fw-bold"><i class="bi bi-x-circle-fill me-2"></i>Fail</h2>
                    }
                    <h4 class="text-muted">@Model.Percentage.ToString("0.0")%</h4>
                </div>
            </div>
        </div>

        <!-- Stats Grid -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 p-3 text-center">
                    <h6 class="text-muted">Total Score</h6>
                    <h3 class="fw-bold text-primary">@Model.TotalScore</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 p-3 text-center">
                    <h6 class="text-muted">Completion Time</h6>
                    <h3 class="fw-bold">@(Model.CompletionTime?.ToString(@"hh\:mm\:ss") ?? "N/A")</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 p-3 text-center">
                    <h6 class="text-muted">Correct</h6>
                    <h3 class="fw-bold text-success">@Model.CorrectAnswersCount</h3>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm h-100 p-3 text-center">
                    <h6 class="text-muted">Incorrect</h6>
                    <h3 class="fw-bold text-danger">@Model.IncorrectAnswersCount</h3>
                </div>
            </div>
        </div>

        <!-- Question Breakdown -->
        <h3 class="fw-bold mb-3">Question Breakdown</h3>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3">Question</th>
                            <th class="py-3">Time Spent</th>
                            <th class="pe-4 py-3 text-end">Result</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in Model.QuestionBreakdown)
                        {
                            <tr>
                                <td class="ps-4 py-3">@q.QuestionText</td>
                                <td class="py-3">@q.TimeSpent.ToString(@"mm\:ss")</td>
                                <td class="pe-4 py-3 text-end">
                                    @if (q.IsCorrect)
                                    {
                                        <span class="badge bg-success px-3 py-2 rounded-pill">Correct</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger px-3 py-2 rounded-pill">Incorrect</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>