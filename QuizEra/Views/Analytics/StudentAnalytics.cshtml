@model QuizEra.BLL.ModelVM.Analytics.StudentAnalyticsVM

@{
    ViewData["Title"] = "Exam Results";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<div class="container-fluid py-4 px-md-4">

    @if (Model == null)
    {
        <!-- EMPTY STATE -->
        <div class="card border-0 shadow-sm rounded-4 bg-light text-center py-5">
            <div class="card-body">
                <div class="icon-shape bg-purple-subtle text-purple mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle" style="width: 70px; height: 70px;">
                    <i class="fa-solid fa-file-circle-xmark fs-3"></i>
                </div>
                <h4 class="fw-bold text-dark">No Results Found</h4>
                <p class="text-muted mb-4">
                    We couldn't find any data for this exam attempt. Please select a valid exam from your history.
                </p>
                <a asp-controller="Instructor" asp-action="Index" class="btn btn-purple-solid fw-semibold px-4 shadow-sm rounded-3">
                    <i class="fa-solid fa-arrow-left me-2"></i>Return to Dashboard
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- HEADER -->
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <div class="mb-2">
                    <a asp-controller="Exam" asp-action="Results" class="text-decoration-none text-muted small fw-medium">
                        <i class="fa-solid fa-arrow-left me-1"></i> Back to All Results
                    </a>
                </div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="badge bg-purple-subtle text-purple border border-purple-subtle rounded-pill px-3 py-1.5 fw-semibold">
                        <i class="fa-solid fa-id-card me-1"></i> @Model.StudentName
                    </span>
                </div>
                <h2 class="fw-bold text-dark m-0">@Model.ExamTitle</h2>
            </div>

            <!-- RESULT STATUS BADGE -->
            <div class="text-end">
                @if (Model.IsPassed)
                {
                    <span class="badge bg-purple text-white px-3 py-2 rounded-pill fs-6 fw-bold mb-1 d-inline-flex align-items-center gap-1">
                        <i class="fa-solid fa-circle-check"></i> Passed
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary text-white px-3 py-2 rounded-pill fs-6 fw-bold mb-1 d-inline-flex align-items-center gap-1">
                        <i class="fa-solid fa-circle-xmark"></i> Failed
                    </span>
                }
                <h4 class="fw-bold text-purple mb-0">@Model.Percentage.ToString("0.0")%</h4>
            </div>
        </div>

        <!-- STATS GRID CARDS -->
        <div class="row g-3 mb-4">
            <!-- Total Score -->
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-2">
                    <div class="card-body text-center">
                        <span class="text-muted text-uppercase fw-bold fs-7 tracking-wider d-block mb-1">Total Score</span>
                        <h3 class="fw-extrabold text-purple mb-0">@Model.TotalScore</h3>
                    </div>
                </div>
            </div>

            <!-- Completion Time -->
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-2">
                    <div class="card-body text-center">
                        <span class="text-muted text-uppercase fw-bold fs-7 tracking-wider d-block mb-1">Completion Time</span>
                        <h3 class="fw-extrabold text-dark mb-0">@(Model.CompletionTime?.ToString(@"hh\:mm\:ss") ?? "N/A")</h3>
                    </div>
                </div>
            </div>

            <!-- Correct Answers -->
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-2">
                    <div class="card-body text-center">
                        <span class="text-muted text-uppercase fw-bold fs-7 tracking-wider d-block mb-1">Correct Answers</span>
                        <h3 class="fw-extrabold text-dark mb-0">@Model.CorrectAnswersCount</h3>
                    </div>
                </div>
            </div>

            <!-- Incorrect Answers -->
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100 p-2">
                    <div class="card-body text-center">
                        <span class="text-muted text-uppercase fw-bold fs-7 tracking-wider d-block mb-1">Incorrect Answers</span>
                        <h3 class="fw-extrabold text-muted mb-0">@Model.IncorrectAnswersCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- QUESTION BREAKDOWN TABLE -->
        <h4 class="fw-bold text-dark mb-3"><i class="fa-solid fa-list-check text-purple me-2"></i>Question Breakdown</h4>
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light border-bottom">
                            <tr>
                                <th class="ps-4 py-3 text-muted text-uppercase fs-7 fw-bold">Question</th>
                                <th class="py-3 text-muted text-uppercase fs-7 fw-bold">Time Spent</th>
                                <th class="pe-4 py-3 text-end text-muted text-uppercase fs-7 fw-bold">Result</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in Model.QuestionBreakdown)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-medium text-dark">
                                        @q.QuestionText
                                    </td>
                                    <td class="py-3 text-muted">
                                        <i class="fa-regular fa-clock me-1 text-purple"></i>@q.TimeSpent.ToString(@"mm\:ss")
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        @if (q.IsCorrect)
                                        {
                                            <span class="badge bg-purple-subtle text-purple border border-purple-subtle px-3 py-1.5 rounded-pill fw-semibold">
                                                <i class="fa-solid fa-check me-1"></i>Correct
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-secondary border px-3 py-1.5 rounded-pill fw-normal">
                                                <i class="fa-solid fa-xmark me-1"></i>Incorrect
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .fs-7 {
        font-size: 0.75rem;
    }

    .tracking-wider {
        letter-spacing: 0.08em;
    }

    .fw-extrabold {
        font-weight: 800;
    }

    .icon-shape {
        width: 56px;
        height: 56px;
    }

    .bg-purple-subtle {
        background-color: rgba(111, 66, 193, 0.1) !important;
    }

    .border-purple-subtle {
        border-color: rgba(111, 66, 193, 0.2) !important;
    }

    .text-purple {
        color: #6f42c1 !important;
    }

    .bg-purple {
        background-color: #6f42c1 !important;
    }

    .btn-purple-solid {
        background-color: #6f42c1;
        color: #ffffff;
        border: none;
        transition: all 0.2s ease;
    }

        .btn-purple-solid:hover {
            background-color: #5a2898;
            color: #ffffff;
        }
</style>