@model QuizEra.BLL.ModelVM.Questions.QuestionVM

@{
    ViewData["Title"] = "Edit Question";
}

<style>
    .question-page {
        min-height: calc(100vh - 56px);
        background: #f8f9fa;
        padding: 40px 20px;
    }

    .question-container {
        max-width: 900px;
        margin: auto;
    }

    .question-card {
        background: white;
        border-radius: 12px;
        border: none;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
    }

    .question-header {
        background: #f8f9fa;
        border-bottom: 1px solid #dee2e6;
        padding: 22px 25px;
    }

    .question-title {
        font-weight: 700;
        color: #212529;
        margin-bottom: 5px;
    }

    .question-subtitle {
        color: #6c757d;
        margin-bottom: 0;
    }

    .question-body {
        padding: 25px;
    }

    .form-label {
        font-weight: 600;
        color: #343a40;
    }

    .form-control,
    .form-select {
        border-radius: 8px;
        padding: 11px 13px;
    }

        .form-control:focus,
        .form-select:focus {
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
        }

    .question-content {
        min-height: 150px;
        resize: vertical;
    }

    .options-container {
        border: 1px solid #dee2e6;
        border-radius: 10px;
        padding: 18px;
        margin-top: 25px;
    }

    .options-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }

    .options-title {
        font-weight: 600;
        margin: 0;
    }

    .option-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
    }

    .option-letter {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #f1f3f5;
        display: flex;
        justify-content: center;
        align-items: center;
        font-weight: 700;
        flex-shrink: 0;
    }

    .correct-option {
        width: 18px;
        height: 18px;
        cursor: pointer;
        flex-shrink: 0;
    }

    .delete-option {
        border: none;
        background: transparent;
        color: #6c757d;
        padding: 6px;
        cursor: pointer;
    }

        .delete-option:hover {
            color: #dc3545;
        }

    .add-option {
        border: none;
        background: transparent;
        color: #0d6efd;
        font-weight: 600;
        padding: 5px 0;
        cursor: pointer;
    }

        .add-option:hover {
            text-decoration: underline;
        }

    .validation-error {
        color: #dc3545;
        font-size: 0.85rem;
        display: block;
        margin-top: 4px;
    }

    .question-footer {
        border-top: 1px solid #dee2e6;
        padding: 18px 25px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        background: white;
    }
</style>


<div class="question-page">

    <div class="question-container">

        <div class="question-card">

            <!-- Header -->
            <div class="question-header">

                <h1 class="question-title">
                    Edit Question
                </h1>

                <p class="question-subtitle">
                    Update the question and its options.
                </p>

            </div>


            <!-- Form -->
            <form asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post">

                <!-- Important -->
                <input type="hidden"
                       asp-for="Id" />


                <div class="question-body">

                    <!-- Topic + Difficulty -->
                    <div class="row g-3">

                        <div class="col-md-6">

                            <label asp-for="TopicID"
                                   class="form-label">
                                Topic
                            </label>

                            <select asp-for="TopicID"
                                    class="form-select">

                                <option value="">
                                    Select Topic
                                </option>

                                @foreach (var topic in ViewBag.Topics)
                                {
                                    <option value="@topic.Id">
                                        @topic.Name
                                    </option>
                                }

                            </select>

                            <span asp-validation-for="TopicID"
                                  class="validation-error">
                            </span>

                        </div>


                        <div class="col-md-6">

                            <label asp-for="DifficultyLevel"
                                   class="form-label">
                                Difficulty Level
                            </label>

                            <select asp-for="DifficultyLevel"
                                    class="form-select">

                                <option value="Easy">
                                    Easy
                                </option>

                                <option value="Intermediate">
                                    Intermediate
                                </option>

                                <option value="Hard">
                                    Hard
                                </option>

                            </select>

                            <span asp-validation-for="DifficultyLevel"
                                  class="validation-error">
                            </span>

                        </div>

                    </div>


                    <!-- Question Format -->
                    <div class="mt-4">

                        <label asp-for="QuestionFormat"
                               class="form-label">
                            Question Type
                        </label>

                        <select asp-for="QuestionFormat"
                                class="form-select"
                                id="questionFormat">

                            <option value="MCQ">
                                Multiple Choice (MCQ)
                            </option>

                            <option value="TrueFalse">
                                True / False
                            </option>

                            <option value="Essay">
                                Essay
                            </option>

                        </select>

                        <span asp-validation-for="QuestionFormat"
                              class="validation-error">
                        </span>

                    </div>


                    <!-- Question Text -->
                    <div class="mt-4">

                        <label asp-for="QuestionText"
                               class="form-label">
                            Question Content
                        </label>

                        <textarea asp-for="QuestionText"
                                  class="form-control question-content"
                                  placeholder="Enter your question here...">
                        </textarea>

                        <span asp-validation-for="QuestionText"
                              class="validation-error">
                        </span>

                    </div>


                    <!-- Essay Answer -->
                    <div id="essayAnswerSection"
                         class="mt-4">

                        <label asp-for="QuestionAnswer"
                               class="form-label">
                            Model Answer
                        </label>

                        <textarea asp-for="QuestionAnswer"
                                  class="form-control"
                                  rows="5"
                                  placeholder="Enter the reference answer for the essay...">
                        </textarea>

                    </div>


                    <!-- Options -->
                    <div id="optionsSection"
                         class="options-container">

                        <div class="options-header">

                            <h6 class="options-title">
                                Answer Options
                            </h6>

                            <small class="text-muted">
                                Select the correct answer
                            </small>

                        </div>


                        <div id="optionsList">

                            @{
                                int index = 0;
                            }

                            @foreach (var option in Model.Options)
                            {
                                <div class="option-row">

                                    <input type="hidden"
                                           name="Options[@index].Id"
                                           value="@option.Id" />

                                    <input type="radio"
                                           name="CorrectOption"
                                           value="@index"
                                           class="correct-option"
                                    @(option.IsCorrect ? "checked" : "") />

                                    <span class="option-letter">
                                        @((char)('A' + index))
                                    </span>

                                    <input type="text"
                                           name="Options[@index].OptionText"
                                           value="@option.OptionText"
                                           class="form-control"
                                           placeholder="Option @((char)('A' + index)) text..." />

                                    <button type="button"
                                            class="delete-option"
                                            onclick="removeOption(this)">

                                        <i class="fas fa-trash"></i>

                                    </button>

                                </div>

                                index++;
                            }

                        </div>


                        <button type="button"
                                class="add-option"
                                onclick="addOption()">

                            <i class="fas fa-plus"></i>
                            Add Option

                        </button>

                    </div>

                </div>


                <!-- Footer -->
                <div class="question-footer">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        Save Changes
                        <i class="fas fa-check ms-1"></i>

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        let optionIndex =
            document.querySelectorAll(".option-row").length;


        function addOption() {

            const optionsList =
                document.getElementById("optionsList");

            const letter =
                String.fromCharCode(65 + optionIndex);

            const row =
                document.createElement("div");

            row.className = "option-row";

            row.innerHTML = `
                        <input type="hidden"
                               name="Options[${optionIndex}].Id"
                               value="0" />

                        <input type="radio"
                               name="CorrectOption"
                               value="${optionIndex}"
                               class="correct-option" />

                        <span class="option-letter">
                            ${letter}
                        </span>

                        <input type="text"
                               name="Options[${optionIndex}].OptionText"
                               class="form-control"
                               placeholder="Option ${letter} text..." />

                        <button type="button"
                                class="delete-option"
                                onclick="removeOption(this)">

                            <i class="fas fa-trash"></i>

                        </button>
                    `;

            optionsList.appendChild(row);

            optionIndex++;
        }


        function removeOption(button) {

            const optionsList =
                document.getElementById("optionsList");

            if (optionsList.children.length <= 2) {

                alert(
                    "A question must have at least 2 options."
                );

                return;
            }

            button.closest(".option-row").remove();

            updateIndexes();
        }


        function updateIndexes() {

            const rows =
                document.querySelectorAll(".option-row");

            rows.forEach((row, index) => {

                const letter =
                    String.fromCharCode(65 + index);

                row.querySelector(
                    ".option-letter"
                ).textContent = letter;

                const textInput =
                    row.querySelector(
                        "input[type='text']"
                    );

                textInput.name =
                    `Options[${index}].OptionText`;

                textInput.placeholder =
                    `Option ${letter} text...`;

                const hiddenInput =
                    row.querySelector(
                        "input[type='hidden']"
                    );

                hiddenInput.name =
                    `Options[${index}].Id`;

                const radio =
                    row.querySelector(
                        "input[type='radio']"
                    );

                radio.value = index;

            });

            optionIndex = rows.length;
        }


        function updateQuestionFormat() {

            const format =
                document.getElementById(
                    "questionFormat"
                ).value;

            const optionsSection =
                document.getElementById(
                    "optionsSection"
                );

            const essaySection =
                document.getElementById(
                    "essayAnswerSection"
                );


            if (format === "Essay") {

                optionsSection.style.display = "none";

                essaySection.style.display = "block";

            }
            else {

                optionsSection.style.display = "block";

                essaySection.style.display = "none";

            }
        }


        document
            .getElementById("questionFormat")
            .addEventListener(
                "change",
                updateQuestionFormat
            );


        updateQuestionFormat();

    </script>
}