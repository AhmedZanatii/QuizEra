@model QuizEra.BLL.ModelVM.Questions.QuestionVM

@{
    ViewData["Title"] = "Question Details";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">

            <div class="card shadow-sm border-0 rounded-3">

                <!-- Header -->
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <div>
                        <h4 class="fw-bold mb-1 text-dark">Question Details</h4>
                        <p class="text-muted small mb-0">View full information for this question.</p>
                    </div>
                    <div class="d-flex gap-2">
                        <a asp-controller="Questions" asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm fw-semibold px-3">
                            <i class="fa-solid fa-pen me-1"></i> Edit Question
                        </a>
                        <a asp-controller="Questions" asp-action="Index" class="btn btn-outline-secondary btn-sm fw-semibold px-3">
                            <i class="fa-solid fa-arrow-left me-1"></i> Back to List
                        </a>
                    </div>
                </div>

                <!-- Body -->
                <div class="card-body p-4">

                    <!-- Basic Info Badges -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border">
                                <span class="text-muted small d-block fw-semibold text-uppercase">Topic</span>
                                <span class="fw-bold text-dark fs-6">
                                    <i class="fa-solid fa-folder text-primary me-2"></i>@(string.IsNullOrEmpty(Model.TopicName) ? "N/A" : Model.TopicName)
                                </span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border">
                                <span class="text-muted small d-block fw-semibold text-uppercase">Question Type</span>
                                <span class="badge bg-primary bg-opacity-10 text-primary fw-semibold fs-6 px-3 py-1 mt-1">
                                    @Model.QuestionFormat
                                </span>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="p-3 bg-light rounded-3 border">
                                <span class="text-muted small d-block fw-semibold text-uppercase">Difficulty Level</span>
                                <span class="badge bg-secondary bg-opacity-10 text-secondary fw-semibold fs-6 px-3 py-1 mt-1">
                                    @Model.DifficultyLevel
                                </span>
                            </div>
                        </div>
                    </div>

                    <!-- Question Content -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-dark mb-2">Question Content</h6>
                        <div class="p-3 border rounded-3 bg-white text-dark fs-6 shadow-sm">
                            @Model.QuestionText
                        </div>
                    </div>

                    <!-- Essay Model Answer -->
                    @if (Model.QuestionFormat.ToString() == "Essay")
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark mb-2">Model Answer</h6>
                            <div class="p-3 border rounded-3 bg-light text-dark">
                                @(string.IsNullOrEmpty(Model.QuestionAnswer) ? "No reference answer provided." : Model.QuestionAnswer)
                            </div>
                        </div>
                    }

                    <!-- Multiple Choice Options -->
                    @if (Model.Options != null && Model.Options.Any())
                    {
                        <div class="border rounded-3 p-3 bg-light">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="fw-bold text-dark m-0">Answer Options</h6>
                                <span class="badge bg-success bg-opacity-10 text-success fw-semibold">
                                    Total Options: @Model.Options.Count
                                </span>
                            </div>

                            <div class="row g-3">
                                @{
                                    int optionNumber = 0;
                                }
                                @foreach (var option in Model.Options)
                                {
                                    var letter = (char)('A' + optionNumber);
                                    <div class="col-12">
                                        <div class="p-3 border rounded-3 bg-white d-flex align-items-center justify-content-between @(option.IsCorrect ? "border-success bg-success bg-opacity-10" : "") shadow-sm">
                                            <div class="d-flex align-items-center gap-3">
                                                <span class="badge @(option.IsCorrect ? "bg-success" : "bg-secondary") rounded-circle d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                                    @letter
                                                </span>
                                                <span class="fw-medium text-dark">@option.OptionText</span>
                                            </div>

                                            @if (option.IsCorrect)
                                            {
                                                <span class="badge bg-success fw-bold px-3 py-2">
                                                    <i class="fa-solid fa-circle-check me-1"></i> Correct Answer
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    optionNumber++;
                                }
                            </div>
                        </div>
                    }

                </div>

                <!-- Footer -->
                <div class="card-footer bg-white py-3 border-top d-flex justify-content-between align-items-center">
                    <form asp-controller="Questions" asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this question?');">
                        <button type="submit" class="btn btn-outline-danger fw-semibold">
                            <i class="fa-solid fa-trash me-1"></i> Delete Question
                        </button>
                    </form>

                    <a asp-controller="Questions" asp-action="Index" class="btn btn-secondary px-4 fw-semibold">
                        Back to List
                    </a>
                </div>

            </div>

        </div>
    </div>
</div>