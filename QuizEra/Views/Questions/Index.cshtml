@model IEnumerable<QuizEra.BLL.ModelVM.Questions.QuestionVM>

@{
    ViewData["Title"] = "Question Bank";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";

    var allQuestions = Model ?? Enumerable.Empty<QuizEra.BLL.ModelVM.Questions.QuestionVM>();
    var activeQuestions = allQuestions.Where(q => !q.IsDeleted);
    var deletedQuestions = allQuestions.Where(q => q.IsDeleted);
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <div class="mb-2">
                <a asp-controller="Instructor"
                   asp-action="Index"
                   class="text-decoration-none text-muted small">
                    <i class="fa-solid fa-arrow-left me-1"></i>
                    Back to Dashboard
                </a>
            </div>

            <h2 class="fw-bold text-dark m-0">Question Bank</h2>

            <p class="text-muted small m-0">
                Manage and organize your system questions by topic.
            </p>
        </div>

        <a asp-controller="Questions"
           asp-action="Create"
           class="btn btn-primary fw-semibold">

            <i class="fa-solid fa-plus me-1"></i>
            Add Question

        </a>

    </div>


    <!-- ========================= -->
    <!-- Active Questions -->
    <!-- ========================= -->
    @if (activeQuestions.Any())
    {
        @foreach (var topicGroup in activeQuestions.GroupBy(q => q.TopicName))
        {
            <div class="d-flex justify-content-between align-items-center mt-4 mb-3 pb-2 border-bottom">

                <h4 class="fw-bold text-dark m-0">

                    <i class="fa-solid fa-folder-open text-primary me-2"></i>

                    @(string.IsNullOrEmpty(topicGroup.Key)
                        ? "General Topics"
                        : topicGroup.Key)

                </h4>

                <span class="badge bg-light text-dark border fw-medium px-3 py-2">

                    @topicGroup.Count()
                    @(topicGroup.Count() == 1 ? "Question" : "Questions")

                </span>

            </div>


            @foreach (var question in topicGroup)
            {
                <div class="card shadow-sm border-0 mb-3 rounded-3">

                    <div class="card-body p-4">

                        <!-- Question Header -->

                        <div class="d-flex justify-content-between align-items-start gap-3">

                            <div class="flex-grow-1">

                                <h5 class="fw-bold text-dark mb-3">
                                    @question.QuestionText
                                </h5>

                            </div>


                            <!-- Actions -->

                            <div class="d-flex gap-2 flex-shrink-0">

                                <a asp-controller="Questions"
                                   asp-action="Edit"
                                   asp-route-id="@question.Id"
                                   class="btn btn-sm btn-outline-primary fw-semibold">

                                    <i class="fa-solid fa-pen me-1"></i>
                                    Edit

                                </a>


                                <form asp-controller="Questions"
                                      asp-action="Delete"
                                      asp-route-id="@question.Id"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this question?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger fw-semibold">

                                        <i class="fa-solid fa-trash me-1"></i>
                                        Delete

                                    </button>

                                </form>

                            </div>

                        </div>


                        <!-- Options -->
                        @if (question.Options != null && question.Options.Any())
                        {
                            <div class="row g-2 mb-3">

                                @{
                                    int optionNumber = 0;
                                }

                                @foreach (var option in question.Options)
                                {
                                    var letter = (char)('A' + optionNumber);

                                    <div class="col-md-6">

                                        <div class="p-2 border rounded-3 d-flex align-items-center justify-content-between
                                            @(option.IsCorrect
                                                ? "border-success bg-success bg-opacity-10"
                                                : "bg-light")">

                                            <div>

                                                <strong class="me-2">
                                                    @letter.
                                                </strong>

                                                <span>
                                                    @option.OptionText
                                                </span>

                                            </div>

                                            @if (option.IsCorrect)
                                            {
                                                <span class="badge bg-success small">
                                                    Correct
                                                </span>
                                            }

                                        </div>

                                    </div>

                                    optionNumber++;
                                }

                            </div>
                        }
                        else if (question.QuestionFormat.ToString() == "Essay")
                        {
                            <div class="alert alert-light border small mb-3">

                                <i class="fa-solid fa-pen-to-square me-2 text-primary"></i>

                                <strong>Essay Question</strong>

                                - Model Answer:

                                @(string.IsNullOrEmpty(question.QuestionAnswer)
                                    ? "N/A"
                                    : question.QuestionAnswer)

                            </div>
                        }


                        <!-- Metadata -->

                        <div class="d-flex gap-2">

                            <span class="badge bg-primary bg-opacity-10 text-primary fw-semibold">

                                Format:
                                @question.QuestionFormat

                            </span>

                            <span class="badge bg-secondary bg-opacity-10 text-secondary fw-semibold">

                                Level:
                                @question.DifficultyLevel

                            </span>

                            <span class="badge bg-success bg-opacity-10 text-success fw-semibold">

                                <i class="fa-solid fa-circle-check me-1"></i>
                                Active

                            </span>

                        </div>

                    </div>

                </div>
            }
        }
    }
    else
    {
        <!-- Empty Active State -->

        <div class="card border-0 shadow-sm text-center py-5 rounded-3">

            <div class="card-body">

                <i class="fa-solid fa-folder-open text-muted fs-1 mb-3"></i>

                <h4 class="fw-bold">
                    No Active Questions
                </h4>

                <p class="text-muted">
                    Your question bank currently has no active questions.
                </p>

                <a asp-controller="Questions"
                   asp-action="Create"
                   class="btn btn-primary fw-semibold">

                    <i class="fa-solid fa-plus me-1"></i>
                    Add Question

                </a>

            </div>

        </div>
    }


    <!-- ========================= -->
    <!-- Deleted Questions -->
    <!-- ========================= -->
    @if (deletedQuestions.Any())
    {
        <div class="mt-5">

            <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">

                <h4 class="fw-bold text-danger m-0">

                    <i class="fa-solid fa-trash-can me-2"></i>
                    Deleted Questions

                </h4>

                <span class="badge bg-danger bg-opacity-10 text-danger border">

                    @deletedQuestions.Count()

                </span>

            </div>


            <div class="alert alert-warning small">

                <i class="fa-solid fa-circle-info me-2"></i>

                Deleted questions are kept in the system and can be restored at any time.

            </div>


            @foreach (var question in deletedQuestions)
            {
                <div class="card border-danger border-opacity-25 shadow-sm mb-3 rounded-3">

                    <div class="card-body p-4">

                        <div class="d-flex justify-content-between align-items-center gap-3">

                            <div class="flex-grow-1">

                                <h5 class="fw-bold text-muted mb-2">

                                    @question.QuestionText

                                </h5>

                                <div class="d-flex gap-2 flex-wrap">

                                    <span class="badge bg-light text-secondary border">

                                        <i class="fa-solid fa-folder me-1"></i>

                                        @(string.IsNullOrEmpty(question.TopicName)
                                            ? "General"
                                            : question.TopicName)

                                    </span>


                                    <span class="badge bg-secondary bg-opacity-10 text-secondary">

                                        Format:
                                        @question.QuestionFormat

                                    </span>


                                    <span class="badge bg-secondary bg-opacity-10 text-secondary">

                                        Level:
                                        @question.DifficultyLevel

                                    </span>


                                    <span class="badge bg-danger bg-opacity-10 text-danger">

                                        <i class="fa-solid fa-trash-can me-1"></i>
                                        Deleted

                                    </span>

                                </div>

                            </div>


                            <!-- Restore -->

                            <form asp-controller="Questions"
                                  asp-action="Restore"
                                  asp-route-id="@question.Id"
                                  method="post"
                                  onsubmit="return confirm('Restore this question?');">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-outline-success fw-semibold">

                                    <i class="fa-solid fa-rotate-left me-1"></i>
                                    Restore

                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>