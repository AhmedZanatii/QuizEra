@model IEnumerable<QuizEra.BLL.ModelVM.Questions.QuestionVM>

@{
    ViewData["Title"] = "Question Bank";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";

    var allQuestions = Model ?? Enumerable.Empty<QuizEra.BLL.ModelVM.Questions.QuestionVM>();
    var activeQuestions = allQuestions.Where(q => !q.IsDeleted);
    var deletedQuestions = allQuestions.Where(q => q.IsDeleted);
}

<div class="container-fluid py-4 px-md-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="mb-2">
                <a asp-controller="Instructor" asp-action="Index" class="text-decoration-none text-muted small fw-medium">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
                </a>
            </div>
            <h2 class="fw-bold text-dark m-0">Question Bank</h2>
            <p class="text-muted small m-0">
                Manage and organize your system questions by topic.
            </p>
        </div>

        <a asp-controller="Questions" asp-action="Create" class="btn btn-purple-solid fw-semibold px-3 shadow-sm rounded-3">
            <i class="fa-solid fa-plus me-1"></i> Add Question
        </a>
    </div>

    <!-- ACTIVE QUESTIONS -->
    @if (activeQuestions.Any())
    {
        @foreach (var topicGroup in activeQuestions.GroupBy(q => q.TopicName))
        {
            <div class="d-flex justify-content-between align-items-center mt-4 mb-3 pb-2 border-bottom">
                <h4 class="fw-bold text-dark m-0">
                    <i class="fa-solid fa-folder-open text-purple me-2"></i>
                    @(string.IsNullOrEmpty(topicGroup.Key) ? "General Topics" : topicGroup.Key)
                </h4>

                <span class="badge bg-purple-subtle text-purple border border-purple-subtle fw-semibold px-3 py-2 rounded-pill">
                    @topicGroup.Count() @(topicGroup.Count() == 1 ? "Question" : "Questions")
                </span>
            </div>

            @foreach (var question in topicGroup)
            {
                <div class="card shadow-sm border-0 mb-3 rounded-4">
                    <div class="card-body p-4">

                        <!-- Question Header & Actions -->
                        <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                            <div class="flex-grow-1">
                                <h5 class="fw-bold text-dark m-0 lh-base">
                                    <a asp-controller="Questions" asp-action="Details" asp-route-id="@question.Id" class="text-decoration-none text-dark link-purple">
                                        @question.QuestionText
                                    </a>
                                </h5>
                            </div>

                            <div class="d-flex gap-2 flex-shrink-0">
                                <a asp-controller="Questions" asp-action="Details" asp-route-id="@question.Id" class="btn btn-sm btn-purple-soft fw-semibold rounded-3">
                                    <i class="fa-solid fa-eye me-1"></i> View
                                </a>
                                <a asp-controller="Questions" asp-action="Edit" asp-route-id="@question.Id" class="btn btn-sm btn-purple-soft fw-semibold rounded-3">
                                    <i class="fa-solid fa-pen me-1"></i> Edit
                                </a>
                                <a asp-controller="Questions" asp-action="Delete" asp-route-id="@question.Id" class="btn btn-sm btn-outline-danger fw-semibold rounded-3">
                                    <i class="fa-solid fa-trash me-1"></i> Delete
                                </a>
                            </div>
                        </div>

                        <!-- Question Options -->
                        @if (question.Options != null && question.Options.Any())
                        {
                            <div class="row g-2 mb-3">
                                @{
                                    int optionNumber = 0;
                                }
                                @foreach (var option in question.Options)
                                {
                                    var letter = (char)('A' + optionNumber);
                                    <div class="col-md-6">
                                        <div class="p-2 px-3 border rounded-3 d-flex align-items-center justify-content-between @(option.IsCorrect ? "border-purple bg-purple-subtle text-purple" : "bg-light border-light-subtle")">
                                            <div class="d-flex align-items-center">
                                                <span class="badge @(option.IsCorrect ? "bg-purple text-white" : "bg-secondary-subtle text-secondary border") rounded-circle me-2 d-flex align-items-center justify-content-center fw-bold" style="width:26px; height:26px; font-size: 0.75rem;">
                                                    @letter
                                                </span>
                                                <span class="fw-medium text-dark">@option.OptionText</span>
                                            </div>
                                            @if (option.IsCorrect)
                                            {
                                                <span class="badge bg-purple text-white px-2 py-1 small rounded-pill">
                                                    <i class="fa-solid fa-check me-1"></i>Correct
                                                </span>
                                            }
                                        </div>
                                    </div>
                                    optionNumber++;
                                }
                            </div>
                        }
                        else if (question.QuestionFormat.ToString() == "Essay")
                        {
                            <div class="alert bg-purple-subtle border border-purple-subtle text-purple small mb-3 rounded-3">
                                <i class="fa-solid fa-pen-to-square me-2"></i>
                                <strong>Essay Question</strong> - Model Answer:
                                @(string.IsNullOrEmpty(question.QuestionAnswer) ? "N/A" : question.QuestionAnswer)
                            </div>
                        }

                        <!-- Question Metadata -->
                        <div class="d-flex gap-2 flex-wrap align-items-center">
                            <span class="badge bg-purple-subtle text-purple border border-purple-subtle fw-semibold">
                                Format: @question.QuestionFormat
                            </span>
                            <span class="badge bg-purple-subtle text-purple border border-purple-subtle fw-semibold">
                                Level: @question.DifficultyLevel
                            </span>
                            <span class="badge bg-purple text-white fw-semibold">
                                <i class="fa-solid fa-circle-check me-1"></i> Active
                            </span>
                        </div>

                    </div>
                </div>
            }
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm text-center py-5 rounded-4 bg-light">
            <div class="card-body">
                <i class="fa-solid fa-folder-open text-purple opacity-50 fs-1 mb-3"></i>
                <h4 class="fw-bold text-dark">No Active Questions</h4>
                <p class="text-muted">Your question bank currently has no active questions.</p>
                <a asp-controller="Questions" asp-action="Create" class="btn btn-purple-solid fw-semibold px-4 shadow-sm rounded-3">
                    <i class="fa-solid fa-plus me-1"></i> Add Question
                </a>
            </div>
        </div>
    }

    <!-- DELETED QUESTIONS -->
    @if (deletedQuestions.Any())
    {
        <div class="mt-5 pt-3">
            <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                <h4 class="fw-bold text-muted m-0">
                    <i class="fa-solid fa-trash-can me-2"></i> Deleted Questions
                </h4>
                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5">
                    @deletedQuestions.Count()
                </span>
            </div>

            @foreach (var question in deletedQuestions)
            {
                <div class="card border-0 bg-light shadow-sm mb-3 rounded-4 opacity-75">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center gap-3">
                            <div class="flex-grow-1">
                                <h5 class="fw-bold text-secondary mb-2">@question.QuestionText</h5>
                                <div class="d-flex gap-2 flex-wrap">
                                    <span class="badge bg-body-secondary text-secondary border">
                                        @(string.IsNullOrEmpty(question.TopicName) ? "General" : question.TopicName)
                                    </span>
                                    <span class="badge bg-secondary-subtle text-secondary">
                                        Format: @question.QuestionFormat
                                    </span>
                                </div>
                            </div>

                            <form asp-controller="Questions" asp-action="Restore" asp-route-id="@question.Id" method="post" onsubmit="return confirm('Restore this question?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-purple-soft fw-semibold rounded-3">
                                    <i class="fa-solid fa-rotate-left me-1"></i> Restore
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>

<style>
    .bg-purple-subtle {
        background-color: rgba(111, 66, 193, 0.1) !important;
    }

    .border-purple-subtle {
        border-color: rgba(111, 66, 193, 0.2) !important;
    }

    .border-purple {
        border-color: #6f42c1 !important;
    }

    .text-purple {
        color: #6f42c1 !important;
    }

    .bg-purple {
        background-color: #6f42c1 !important;
    }

    .link-purple:hover {
        color: #6f42c1 !important;
    }

    .btn-purple-solid {
        background-color: #6f42c1;
        color: #fff;
        border: none;
    }

        .btn-purple-solid:hover {
            background-color: #5a2898;
            color: #fff;
        }

    .btn-purple-soft {
        background-color: rgba(111, 66, 193, 0.08);
        color: #6f42c1;
        border: 1px solid rgba(111, 66, 193, 0.18);
    }

        .btn-purple-soft:hover {
            background-color: #6f42c1;
            color: #fff;
        }
</style>