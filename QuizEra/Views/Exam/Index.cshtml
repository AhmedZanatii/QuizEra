@model IEnumerable<QuizEra.BLL.ModelVM.Exam.ExamVM>

@{
    ViewData["Title"] = "Exam Management";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h2 class="fw-bold text-dark mb-1">
            Exam Management
        </h2>

        <p class="text-muted mb-0">
            Manage your exams and their questions.
        </p>
    </div>

    <a asp-controller="Exam"
       asp-action="Create"
       class="btn btn-success">

        <i class="fa-solid fa-plus me-2"></i>
        Create Exam

    </a>

</div>


@if (Model == null || !Model.Any())
{
    <div class="card dashboard-card">

        <div class="card-body text-center py-5">

            <div class="icon-shape bg-success bg-opacity-10 text-success mx-auto mb-3"
                 style="width:70px; height:70px; border-radius:50%;">

                <i class="fa-solid fa-file-signature fs-3"></i>

            </div>

            <h4 class="fw-bold">
                No exams found
            </h4>

            <p class="text-muted mb-4">
                You haven't created any exams yet.
            </p>

            <a asp-controller="Exam"
               asp-action="Create"
               class="btn btn-success">

                <i class="fa-solid fa-plus me-2"></i>
                Create Your First Exam

            </a>

        </div>

    </div>
}
else
{
    <div class="card dashboard-card">

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th class="ps-4">
                                Exam
                            </th>

                            <th>
                                Course
                            </th>

                            <th>
                                Topics
                            </th>

                            <th>
                                Duration
                            </th>

                            <th>
                                Total Marks
                            </th>

                            <th>
                                Start Date
                            </th>

                            <th>
                                End Date
                            </th>

                            <th>
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var exam in Model)
                        {
                            <tr>

                                <!-- Exam -->
                                <td class="ps-4">

                                    <strong class="text-dark">
                                        @exam.Title
                                    </strong>

                                </td>


                                <!-- Course -->
                                <td>

                                    <span class="text-muted">
                                        @(exam.CourseName ?? "N/A")
                                    </span>

                                </td>


                                <!-- Topics -->
                                <td>

                                    @if (exam.TopicNames != null && exam.TopicNames.Any())
                                    {
                                        <div class="d-flex flex-wrap gap-1">

                                            @foreach (var topicName in exam.TopicNames)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success">
                                                    @topicName
                                                </span>
                                            }

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            N/A
                                        </span>
                                    }

                                </td>


                                <!-- Duration -->
                                <td>

                                    <span>
                                        @exam.Duration min
                                    </span>

                                </td>


                                <!-- Total Marks -->
                                <td>

                                    <span class="badge bg-success">
                                        @exam.TotalMarks.ToString("0.##")
                                    </span>

                                </td>


                                <!-- Start Date -->
                                <td>

                                    <small class="text-muted">
                                        @exam.StartDate.ToString("dd/MM/yyyy HH:mm")
                                    </small>

                                </td>


                                <!-- End Date -->
                                <td>

                                    <small class="text-muted">
                                        @exam.EndDate.ToString("dd/MM/yyyy HH:mm")
                                    </small>

                                </td>


                                <!-- Actions -->
                                <td>

                                    <div class="btn-group"
                                         role="group">

                                        <!-- Details -->
                                        <a asp-controller="Exam"
                                           asp-action="Details"
                                           asp-route-id="@exam.Id"
                                           class="btn btn-sm btn-outline-info">

                                            <i class="fa-solid fa-eye"></i>

                                        </a>


                                        <!-- Edit -->
                                        <a asp-controller="Exam"
                                           asp-action="Edit"
                                           asp-route-id="@exam.Id"
                                           class="btn btn-sm btn-outline-primary">

                                            <i class="fa-solid fa-pen"></i>

                                        </a>


                                        <!-- Delete -->
                                        <form asp-controller="Exam"
                                              asp-action="Delete"
                                              asp-route-id="@exam.Id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Are you sure you want to delete this exam?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger">

                                                <i class="fa-solid fa-trash"></i>

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>
}