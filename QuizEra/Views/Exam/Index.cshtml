@model IEnumerable<QuizEra.BLL.ModelVM.Exam.ExamVM>

@{
    ViewData["Title"] = "Exams";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Exams</h2>
            <p class="text-muted mb-0">
                Manage your exams and their questions.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Create Exam
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            <h5>No exams found.</h5>
            <p class="mb-0">
                You haven't created any exams yet.
            </p>
        </div>
    }
    else
    {
        <div class="card shadow-sm">

            <div class="card-body p-0">

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>
                                <th>Exam</th>
                                <th>Course</th>
                                <th>Topic</th>
                                <th>Duration</th>
                                <th>Total Marks</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Actions</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var exam in Model)
                            {
                                <tr>

                                    <!-- Exam -->
                                    <td>
                                        <strong>
                                            @exam.Title
                                        </strong>
                                    </td>


                                    <!-- Course -->
                                    <td>
                                        @(exam.CourseName ?? "N/A")
                                    </td>


                                    <!-- Topic -->
                                    <td>
                                        @(exam.TopicName ?? "N/A")
                                    </td>


                                    <!-- Duration -->
                                    <td>
                                        @exam.Duration min
                                    </td>


                                    <!-- Total Marks -->
                                    <td>
                                        <span class="badge bg-primary">
                                            @exam.TotalMarks.ToString("0.##")
                                        </span>
                                    </td>


                                    <!-- Start Date -->
                                    <td>
                                        @exam.StartDate.ToString("dd/MM/yyyy HH:mm")
                                    </td>


                                    <!-- End Date -->
                                    <td>
                                        @exam.EndDate.ToString("dd/MM/yyyy HH:mm")
                                    </td>


                                    <!-- Actions -->
                                    <td>

                                        <div class="btn-group"
                                             role="group">

                                            <!-- Details -->
                                            <a asp-action="Details"
                                               asp-route-id="@exam.Id"
                                               class="btn btn-sm btn-outline-info">
                                                Details
                                            </a>


                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@exam.Id"
                                               class="btn btn-sm btn-outline-primary">
                                                Edit
                                            </a>


                                            <!-- Delete -->
                                            <form asp-action="Delete"
                                                  asp-route-id="@exam.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this exam?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

</div>