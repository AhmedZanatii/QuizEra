@model IEnumerable<QuizEra.BLL.ModelVM.Exam.ExamVM>

@{
    ViewData["Title"] = "Exam Management";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<div class="container-fluid py-4 px-md-4">
    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <div class="mb-2">
                <a asp-controller="Instructor" asp-action="Index" class="text-decoration-none text-muted small fw-medium">
                    <i class="fa-solid fa-arrow-left me-1"></i> Back to Dashboard
                </a>
            </div>
            <h2 class="fw-bold text-dark m-0">Exam Management</h2>
            <p class="text-muted small m-0">
                Manage your exams, assigned topics, and question configurations.
            </p>
        </div>

        <a asp-controller="Exam" asp-action="Create" class="btn btn-purple-solid fw-semibold px-4 shadow-sm rounded-3">
            <i class="fa-solid fa-plus me-2"></i>Create Exam
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- EMPTY STATE CARD -->
        <div class="card border-0 shadow-sm rounded-4 bg-light text-center py-5">
            <div class="card-body">
                <div class="icon-shape bg-purple-subtle text-purple mx-auto mb-3 d-flex align-items-center justify-content-center rounded-circle"
                     style="width: 70px; height: 70px;">
                    <i class="fa-solid fa-file-signature fs-3"></i>
                </div>
                <h4 class="fw-bold text-dark">No exams found</h4>
                <p class="text-muted mb-4">You haven't created any exams yet for your courses.</p>
                <a asp-controller="Exam" asp-action="Create" class="btn btn-purple-solid fw-semibold px-4 shadow-sm rounded-3">
                    <i class="fa-solid fa-plus me-2"></i>Create Your First Exam
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- EXAMS TABLE CARD -->
        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light border-bottom">
                            <tr>
                                <th class="ps-4 py-3 text-muted text-uppercase fs-7 fw-bold">Exam</th>
                                <th class="py-3 text-muted text-uppercase fs-7 fw-bold">Course</th>
                                <th class="py-3 text-muted text-uppercase fs-7 fw-bold">Topics</th>
                                <th class="py-3 text-muted text-uppercase fs-7 fw-bold">Duration</th>
                                <th class="py-3 text-muted text-uppercase fs-7 fw-bold">Total Marks</th>
                                <th class="py-3 text-muted text-uppercase fs-7 fw-bold">Schedule</th>
                                <th class="pe-4 py-3 text-end text-muted text-uppercase fs-7 fw-bold">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var exam in Model)
                            {
                                <tr>
                                    <!-- TITLE -->
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center">
                                            <div class="rounded-circle bg-purple-subtle text-purple p-2 me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                                <i class="fa-solid fa-pen-nib"></i>
                                            </div>
                                            <div>
                                                <h6 class="fw-bold text-dark mb-0">@exam.Title</h6>
                                                <small class="text-muted">ID: #@exam.Id</small>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- COURSE -->
                                    <td>
                                        <span class="fw-medium text-dark">
                                            <i class="fa-solid fa-book-open me-1 text-purple opacity-75"></i>
                                            @(exam.CourseName ?? "N/A")
                                        </span>
                                    </td>

                                    <!-- TOPICS -->
                                    <td>
                                        @if (exam.TopicNames != null && exam.TopicNames.Any())
                                        {
                                            <div class="d-flex flex-wrap gap-1" style="max-width: 220px;">
                                                @foreach (var topicName in exam.TopicNames)
                                                {
                                                    <span class="badge bg-purple-subtle text-purple border border-purple-subtle rounded-pill px-2.5 py-1 fw-normal">
                                                        @topicName
                                                    </span>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">N/A</span>
                                        }
                                    </td>

                                    <!-- DURATION -->
                                    <td>
                                        <span class="badge bg-light text-dark border px-2.5 py-1.5 fw-normal rounded-2">
                                            <i class="fa-regular fa-clock me-1 text-purple"></i>@exam.Duration mins
                                        </span>
                                    </td>

                                    <!-- TOTAL MARKS -->
                                    <td>
                                        <span class="badge bg-purple-subtle text-purple border border-purple-subtle rounded-pill px-3 py-1.5 fw-bold">
                                            @exam.TotalMarks.ToString("0.##") Marks
                                        </span>
                                    </td>

                                    <!-- SCHEDULE (START & END) -->
                                    <td>
                                        <div class="d-flex flex-column small">
                                            <span class="text-dark fw-medium">
                                                <i class="fa-regular fa-calendar-check me-1 text-purple"></i>@exam.StartDate.ToString("dd MMM, yyyy - hh:mm tt")
                                            </span>
                                            <span class="text-muted fw-normal mt-1">
                                                <i class="fa-regular fa-calendar-xmark me-1 text-secondary"></i>@exam.EndDate.ToString("dd MMM, yyyy - hh:mm tt")
                                            </span>
                                        </div>
                                    </td>

                                    <!-- ACTIONS -->
                                    <td class="pe-4 text-end">
                                        <div class="d-inline-flex gap-1">
                                            <a asp-controller="Exam" asp-action="Details" asp-route-id="@exam.Id" class="btn btn-sm btn-purple-soft rounded-3" title="View Details">
                                                <i class="fa-solid fa-eye"></i>
                                            </a>
                                            <a asp-controller="Exam" asp-action="Edit" asp-route-id="@exam.Id" class="btn btn-sm btn-purple-soft rounded-3" title="Edit Exam">
                                                <i class="fa-solid fa-pen"></i>
                                            </a>
                                            <a asp-controller="Analytics" asp-action="ClassAnalytics" asp-route-examId="@exam.Id" class="btn btn-sm btn-purple-soft rounded-3" title="View Analytics">
                                                <i class="fa-solid fa-chart-bar"></i>
                                            </a>
                                            <form asp-controller="Exam" asp-action="Delete" asp-route-id="@exam.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this exam?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Delete Exam">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .fs-7 {
        font-size: 0.75rem;
    }

    .bg-purple-subtle {
        background-color: rgba(111, 66, 193, 0.1) !important;
    }

    .border-purple-subtle {
        border-color: rgba(111, 66, 193, 0.2) !important;
    }

    .text-purple {
        color: #6f42c1 !important;
    }

    .bg-purple {
        background-color: #6f42c1 !important;
    }

    /* Solid Primary Purple Button */
    .btn-purple-solid {
        background-color: #6f42c1;
        color: #ffffff;
        border: none;
        transition: all 0.2s ease;
    }

        .btn-purple-solid:hover {
            background-color: #5a2898;
            color: #ffffff;
        }

    /* Soft Purple Secondary Buttons */
    .btn-purple-soft {
        background-color: rgba(111, 66, 193, 0.08);
        color: #6f42c1;
        border: 1px solid rgba(111, 66, 193, 0.18);
        transition: all 0.2s ease;
    }

        .btn-purple-soft:hover {
            background-color: #6f42c1;
            color: #ffffff;
            border-color: #6f42c1;
        }
</style>