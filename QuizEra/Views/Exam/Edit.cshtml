@using QuizEra.DAL.Entities
@model QuizEra.BLL.ModelVM.Exam.UpdateExamVM

@{
    ViewData["Title"] = "Edit Exam";

    var courses = ViewBag.Courses as List<Course> ?? new List<Course>();
    var topics = ViewBag.Topics as List<Topic> ?? new List<Topic>();
    var questions = ViewBag.Questions as List<Question> ?? new List<Question>();

    var selectedQuestions = Model.Questions
        .Where(q => q.IsSelected)
        .ToDictionary(q => q.QuestionId);
}

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header">
            <h2 class="mb-0">Edit Exam</h2>
        </div>

        <div class="card-body">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- ========================= -->
                <!-- Course -->
                <!-- ========================= -->

                <div class="mb-3">

                    <label asp-for="CourseId"
                           class="form-label">
                        Course
                    </label>

                    <select asp-for="CourseId"
                            class="form-select"
                            id="courseSelect">

                        <option value="">
                            -- Select Course --
                        </option>

                        @foreach (var course in courses)
                        {
                            <option value="@course.Id">
                                @course.CourseName
                            </option>
                        }

                    </select>

                    <span asp-validation-for="CourseId"
                          class="text-danger">
                    </span>

                </div>


                <!-- ========================= -->
                <!-- Topic -->
                <!-- ========================= -->

                <div class="mb-3">

                    <label asp-for="TopicId"
                           class="form-label">
                        Topic
                    </label>

                    <select asp-for="TopicId"
                            class="form-select"
                            id="topicSelect">

                        <option value="">
                            -- Select Topic --
                        </option>

                        @foreach (var topic in topics)
                        {
                            <option value="@topic.Id">
                                @topic.Name
                            </option>
                        }

                    </select>

                    <span asp-validation-for="TopicId"
                          class="text-danger">
                    </span>

                </div>


                <!-- ========================= -->
                <!-- Exam Title -->
                <!-- ========================= -->

                <div class="mb-3">

                    <label asp-for="Title"
                           class="form-label">
                        Exam Title
                    </label>

                    <input asp-for="Title"
                           class="form-control"
                           placeholder="Enter exam title" />

                    <span asp-validation-for="Title"
                          class="text-danger">
                    </span>

                </div>


                <!-- ========================= -->
                <!-- Duration -->
                <!-- ========================= -->

                <div class="mb-3">

                    <label asp-for="Duration"
                           class="form-label">
                        Duration (minutes)
                    </label>

                    <input asp-for="Duration"
                           type="number"
                           min="1"
                           max="200"
                           class="form-control" />

                    <span asp-validation-for="Duration"
                          class="text-danger">
                    </span>

                </div>


                <!-- ========================= -->
                <!-- Dates -->
                <!-- ========================= -->

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="StartDate"
                               class="form-label">
                            Start Date
                        </label>

                        <input asp-for="StartDate"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="StartDate"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="col-md-6 mb-3">

                        <label asp-for="EndDate"
                               class="form-label">
                            End Date
                        </label>

                        <input asp-for="EndDate"
                               type="datetime-local"
                               class="form-control" />

                        <span asp-validation-for="EndDate"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- ========================= -->
                <!-- Question Bank -->
                <!-- ========================= -->

                <hr class="my-4" />

                <h4>Question Bank</h4>

                <p class="text-muted">
                    Select or remove questions and update their marks.
                </p>

                <div id="questionContainer">

                    @if (!questions.Any())
                    {
                        <div class="alert alert-warning">
                            No questions found for this topic.
                        </div>
                    }
                    else
                    {
                        @for (int i = 0; i < questions.Count; i++)
                        {
                            var question = questions[i];

                            var selected =
                                selectedQuestions.TryGetValue(
                                    question.Id,
                                    out var selectedQuestion);

                            <div class="card mb-3 question-card">

                                <div class="card-body">

                                    <div class="form-check mb-2">

                                        <input type="hidden"
                                               name="Questions[@i].QuestionId"
                                               value="@question.Id" />

                                        <input type="hidden"
                                               name="Questions[@i].IsSelected"
                                               value="false" />

                                        <input class="form-check-input question-checkbox"
                                               type="checkbox"
                                               name="Questions[@i].IsSelected"
                                               value="true"
                                               data-index="@i"
                                        @(selected ? "checked" : "") />

                                        <label class="form-check-label fw-bold">

                                            @question.QuestionText

                                        </label>

                                    </div>


                                    <div class="mb-2">

                                        <span class="badge bg-secondary">

                                            @question.QuestionFormat

                                        </span>

                                    </div>


                                    <div class="row question-details"
                                         style="display:@(selected ? "flex" : "none");">

                                        <div class="col-md-6">

                                            <label class="form-label">
                                                Actual Mark
                                            </label>

                                            <input type="number"
                                                   step="0.5"
                                                   min="0"
                                                   class="form-control actual-mark"
                                                   name="Questions[@i].ActualMark"
                                                   value="@(selected ? selectedQuestion!.ActualMark : 0)"
                                            @(selected ? "" : "disabled") />

                                        </div>


                                        <div class="col-md-6">

                                            <label class="form-label">
                                                Bonus Mark
                                            </label>

                                            <input type="number"
                                                   step="0.5"
                                                   min="0"
                                                   class="form-control bonus-mark"
                                                   name="Questions[@i].BonusMark"
                                                   value="@(selected ? selectedQuestion!.BonusMark : 0)"
                                            @(selected ? "" : "disabled") />

                                        </div>

                                    </div>

                                </div>

                            </div>
                        }
                    }

                </div>


                <!-- ========================= -->
                <!-- Total Marks -->
                <!-- ========================= -->

                <div class="mt-4 p-3 bg-light rounded">

                    <strong>
                        Total Marks:
                    </strong>

                    <span id="totalMarks">
                        0
                    </span>

                </div>


                <!-- ========================= -->
                <!-- Buttons -->
                <!-- ========================= -->

                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">
                        Save Changes
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const courseSelect =
            document.getElementById("courseSelect");

        const topicSelect =
            document.getElementById("topicSelect");

        const questionContainer =
            document.getElementById("questionContainer");

        const totalMarksElement =
            document.getElementById("totalMarks");


        // ==========================================
        // Calculate Total Marks
        // ==========================================

        function calculateTotalMarks() {

            let total = 0;

            document
                .querySelectorAll(".question-checkbox:checked")
                .forEach(function(checkbox) {

                    const card =
                        checkbox.closest(".question-card");

                    const actualMark =
                        card.querySelector(".actual-mark");

                    total +=
                        parseFloat(actualMark.value) || 0;
                });

            totalMarksElement.textContent =
                total.toFixed(2);
        }


        // ==========================================
        // Enable / Disable Question Details
        // ==========================================

        function setupQuestionCheckbox(checkbox) {

            checkbox.addEventListener("change", function() {

                const card =
                    this.closest(".question-card");

                const details =
                    card.querySelector(".question-details");

                const actualMark =
                    card.querySelector(".actual-mark");

                const bonusMark =
                    card.querySelector(".bonus-mark");


                details.style.display =
                    this.checked ? "flex" : "none";

                actualMark.disabled =
                    !this.checked;

                bonusMark.disabled =
                    !this.checked;


                calculateTotalMarks();
            });
        }


        document
            .querySelectorAll(".question-checkbox")
            .forEach(setupQuestionCheckbox);


        document
            .querySelectorAll(".actual-mark")
            .forEach(function(input) {

                input.addEventListener(
                    "input",
                    calculateTotalMarks
                );

            });


        // Initial calculation
        calculateTotalMarks();


        // ==========================================
        // Course → Topics
        // ==========================================

        courseSelect.addEventListener("change", async function() {

            const courseId = this.value;

            topicSelect.innerHTML =
                '<option value="">-- Select Topic --</option>';

            questionContainer.innerHTML =
                '<div class="alert alert-info">' +
                'Select a topic to display its questions.' +
                '</div>';

            totalMarksElement.textContent = "0";


            if (!courseId)
                return;


            try {

                const response =
                    await fetch(
                        `/Exam/GetTopicsByCourse?courseId=${courseId}`
                    );

                if (!response.ok)
                    throw new Error("Failed to load topics.");

                const topics =
                    await response.json();


                topics.forEach(function(topic) {

                    const option =
                        document.createElement("option");

                    option.value =
                        topic.id;

                    option.textContent =
                        topic.name;

                    topicSelect.appendChild(option);

                });

            }
            catch (error) {

                console.error(error);

                questionContainer.innerHTML =
                    '<div class="alert alert-danger">' +
                    'Unable to load topics.' +
                    '</div>';
            }

        });


        // ==========================================
        // Topic → Questions
        // ==========================================

        topicSelect.addEventListener("change", async function() {

            const topicId = this.value;

            questionContainer.innerHTML = "";

            totalMarksElement.textContent = "0";


            if (!topicId)
                return;


            try {

                const response =
                    await fetch(
                        `/Exam/GetQuestionsByTopic?topicId=${topicId}`
                    );

                if (!response.ok)
                    throw new Error("Failed to load questions.");

                const questions =
                    await response.json();


                if (questions.length === 0) {

                    questionContainer.innerHTML =
                        '<div class="alert alert-warning">' +
                        'No questions found for this topic.' +
                        '</div>';

                    return;
                }


                questions.forEach(function(question, index) {

                    createQuestionRow(
                        question,
                        index
                    );

                });

            }
            catch (error) {

                console.error(error);

                questionContainer.innerHTML =
                    '<div class="alert alert-danger">' +
                    'Unable to load questions.' +
                    '</div>';
            }

        });


        // ==========================================
        // Create New Question Row
        // ==========================================

        function createQuestionRow(question, index) {

            const wrapper =
                document.createElement("div");

            wrapper.className =
                "card mb-3 question-card";


            wrapper.innerHTML = `

                        <div class="card-body">

                            <div class="form-check mb-2">

                                <input
                                    type="hidden"
                                    name="Questions[${index}].QuestionId"
                                    value="${question.id}"
                                />

                                <input
                                    type="hidden"
                                    name="Questions[${index}].IsSelected"
                                    value="false"
                                />

                                <input
                                    class="form-check-input question-checkbox"
                                    type="checkbox"
                                    name="Questions[${index}].IsSelected"
                                    value="true"
                                    data-index="${index}"
                                />

                                <label class="form-check-label fw-bold">

                                    ${escapeHtml(question.questionText)}

                                </label>

                            </div>

                            <div class="mb-2">

                                <span class="badge bg-secondary">

                                    ${question.questionFormat}

                                </span>

                            </div>

                            <div class="row question-details"
                                 style="display:none;">

                                <div class="col-md-6">

                                    <label class="form-label">
                                        Actual Mark
                                    </label>

                                    <input
                                        type="number"
                                        step="0.5"
                                        min="0"
                                        class="form-control actual-mark"
                                        name="Questions[${index}].ActualMark"
                                        value="0"
                                        disabled
                                    />

                                </div>

                                <div class="col-md-6">

                                    <label class="form-label">
                                        Bonus Mark
                                    </label>

                                    <input
                                        type="number"
                                        step="0.5"
                                        min="0"
                                        class="form-control bonus-mark"
                                        name="Questions[${index}].BonusMark"
                                        value="0"
                                        disabled
                                    />

                                </div>

                            </div>

                        </div>
                    `;


            questionContainer.appendChild(wrapper);


            const checkbox =
                wrapper.querySelector(".question-checkbox");

            setupQuestionCheckbox(checkbox);

        }


        // ==========================================
        // Escape HTML
        // ==========================================

        function escapeHtml(text) {

            const div =
                document.createElement("div");

            div.textContent =
                text;

            return div.innerHTML;
        }

    </script>
}