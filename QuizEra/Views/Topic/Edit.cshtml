@model QuizEra.BLL.ModelVM.Topic.UpdateTopicVM

@{
    ViewData["Title"] = "Edit Topic";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<div class="row justify-content-center mb-5">
    <div class="col-lg-8 col-xl-6">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CourseId" />

            <!-- Header Section -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
                <div>
                    <!-- Back Link -->
                    <div class="mb-2">
                        <a asp-controller="Topic"
                           asp-action="Details"
                           asp-route-id="@Model.Id"
                           class="text-decoration-none text-muted small">
                            <i class="fa-solid fa-arrow-left me-1"></i> Back to Details
                        </a>
                    </div>
                    <h3 class="fw-bold text-dark m-0">Edit Topic</h3>
                    <p class="text-muted small mb-0">Update information for this topic.</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Topic"
                       asp-action="Details"
                       asp-route-id="@Model.Id"
                       class="btn btn-light text-secondary border px-4 fw-semibold btn-sm d-inline-flex align-items-center rounded-3">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-purple px-4 fw-semibold btn-sm d-inline-flex align-items-center rounded-3 shadow-sm">
                        <i class="fa-solid fa-check me-1.5"></i> Save Changes
                    </button>
                </div>
            </div>

            <!-- Topic Details Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <div class="d-flex align-items-center gap-2 mb-4 pb-2 border-bottom">
                    <span class="badge bg-purple-subtle text-purple rounded-circle p-2">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </span>
                    <h5 class="fw-bold text-dark mb-0">Topic Details</h5>
                </div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold text-dark small">
                        Topic Name <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Name" class="form-control form-control-lg fs-6 py-2 rounded-3" placeholder="e.g. Introduction to Software Engineering" />
                    <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}