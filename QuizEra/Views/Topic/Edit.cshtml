@model QuizEra.BLL.ModelVM.Topic.UpdateTopicVM

@{
    ViewData["Title"] = "Edit Topic";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-6">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CourseId" />

            <!-- Header Section -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
                <div>
                    <h3 class="fw-bold text-dark m-0">Edit Topic</h3>
                    <p class="text-muted small mb-0">Update information for this topic.</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Topic" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-4 fw-medium">Cancel</a>
                    <button type="submit" class="btn btn-warning text-white px-4 fw-medium">
                        <i class="fa-solid fa-check me-1"></i> Save Changes
                    </button>
                </div>
            </div>

            <!-- Topic Details Card -->
            <div class="card dashboard-card p-4">
                <h5 class="fw-bold text-dark mb-4 pb-2 border-bottom">Topic Details</h5>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label fw-semibold text-secondary small">
                        Topic Name <span class="text-danger">*</span>
                    </label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Introduction to Software Engineering" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}