@model QuizEra.BLL.ModelVM.Topic.TopicDetailsVM

@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";

    var allQuestions = Model.Questions?.ToList()
        ?? new List<QuizEra.BLL.ModelVM.Questions.QuestionVM>();

    var activeQuestions = allQuestions
        .Where(q => !q.IsDeleted)
        .ToList();

    var deletedQuestions = allQuestions
        .Where(q => q.IsDeleted)
        .ToList();
}

<div class="container-fluid py-4 px-md-4">

    <div class="mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small text-uppercase tracking-wide fw-semibold">
                    <li class="breadcrumb-item">
                        <a asp-controller="Course" asp-action="Details" asp-route-id="@Model.CourseId" class="text-decoration-none text-muted">
                            <i class="fa-solid fa-book me-1"></i> Course Details
                        </a>
                    </li>
                    <li class="breadcrumb-item active text-purple" aria-current="page">Topic Details</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark m-0">@Model.Name</h2>
        </div>

        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Questions"
               asp-action="Create"
               asp-route-topicId="@Model.Id"
               class="btn btn-purple px-3 fw-semibold rounded-3 d-inline-flex align-items-center gap-2 shadow-sm">
                <i class="fa-solid fa-plus fs-7"></i>
                <span>Add Question</span>
            </a>

            <div class="dropdown">
                <button class="btn btn-light border rounded-3 shadow-sm px-2 py-1.5"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false">
                    <i class="fa-solid fa-ellipsis-vertical text-secondary px-1"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm rounded-3">
                    <li>
                        <a class="dropdown-item py-2"
                           asp-action="Edit"
                           asp-route-id="@Model.Id">
                            <i class="fa-solid fa-pen-to-square me-2 text-primary"></i> Edit Topic
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <button type="button"
                                class="dropdown-item py-2 text-danger"
                                data-bs-toggle="modal"
                                data-bs-target="#deleteTopicModal">
                            <i class="fa-solid fa-trash-can me-2"></i> Delete Topic
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-4 p-3 d-flex align-items-center justify-content-center" style="background-color: rgba(111, 66, 193, 0.1); width: 56px; height: 56px;">
                    <i class="fa-solid fa-folder-open fs-3" style="color: #6f42c1;"></i>
                </div>
                <div>
                    <span class="badge bg-purple-subtle text-purple fw-semibold rounded-pill px-3 py-1 mb-1">Active Topic</span>
                    <p class="text-muted small mb-0 d-flex align-items-center gap-2">
                        <span><i class="fa-solid fa-circle-question me-1 text-purple"></i> @activeQuestions.Count Total Questions</span>
                        <span>•</span>
                        <span><i class="fa-solid fa-trash-can me-1 text-danger"></i> @deletedQuestions.Count Soft Deleted</span>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <h5 class="fw-bold text-dark m-0">Questions List</h5>
        <p class="text-muted small">Manage questions assigned to this specific topic.</p>
    </div>

    @if (!activeQuestions.Any())
    {
        <div class="card border-dashed p-5 text-center rounded-4 mb-4 bg-light bg-opacity-50">
            <div class="text-muted mb-3">
                <i class="fa-solid fa-file-circle-question fs-1 text-purple opacity-50"></i>
            </div>
            <h5 class="fw-bold text-dark mb-1">No Active Questions</h5>
            <p class="text-muted small mb-3">There are no active questions created in this topic yet.</p>
            <div>
                <a asp-controller="Questions"
                   asp-action="Create"
                   asp-route-topicId="@Model.Id"
                   class="btn btn-purple btn-sm px-4 fw-semibold rounded-3">
                    <i class="fa-solid fa-plus me-1"></i> Add Question Now
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2 mb-4">
            @for (int i = 0; i < activeQuestions.Count; i++)
            {
                var q = activeQuestions[i];

                <div class="card border-0 shadow-sm question-card p-3 rounded-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-3 fw-bold flex-shrink-0 d-flex align-items-center justify-content-center"
                             style="background-color: rgba(111, 66, 193, 0.08); color: #6f42c1; width: 42px; height: 42px; font-size: 0.95rem;">
                            #@(i + 1)
                        </div>

                        <div class="flex-grow-1 min-w-0">
                            <h6 class="fw-semibold text-dark mb-2 text-truncate">
                                @q.QuestionText
                            </h6>

                            <div class="d-flex gap-2 flex-wrap align-items-center">
                                <span class="badge bg-light text-secondary border fw-normal">
                                    <i class="fa-solid fa-tag me-1 text-muted"></i> @q.QuestionFormat
                                </span>

                                @{
                                    var (diffBg, diffText) = q.DifficultyLevel.ToString().ToLower() switch
                                    {
                                        "easy" => ("#e8f5e9", "#2e7d32"),
                                        "medium" => ("#fff8e1", "#f57f17"),
                                        "hard" => ("#ffebee", "#c62828"),
                                        _ => ("#f5f5f5", "#616161")
                                    };
                                }

                                <span class="badge fw-medium" style="background-color: @diffBg; color: @diffText;">
                                    <i class="fa-solid fa-gauge-high me-1"></i> @q.DifficultyLevel
                                </span>

                                <span class="badge bg-success-subtle text-success border border-success-subtle">
                                    <i class="fa-solid fa-circle-check me-1"></i> Active
                                </span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 flex-shrink-0">
                            <a asp-controller="Questions"
                               asp-action="Edit"
                               asp-route-id="@q.Id"
                               class="btn btn-sm btn-light text-secondary border rounded-3"
                               title="Edit Question">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>

                            <button type="button"
                                    class="btn btn-sm btn-light text-danger border rounded-3"
                                    title="Delete Question"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteQuestionModal-@q.Id">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (deletedQuestions.Any())
    {
        <div class="mt-5 mb-4">
            <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                <h6 class="fw-bold text-danger mb-0 d-flex align-items-center gap-2">
                    <i class="fa-solid fa-trash-can"></i> Deleted Questions
                </h6>
                <span class="badge bg-danger-subtle text-danger rounded-pill px-2.5">
                    @deletedQuestions.Count
                </span>
            </div>

            <div class="d-flex flex-column gap-2">
                @foreach (var q in deletedQuestions)
                {
                    <div class="card border-0 shadow-sm p-3 rounded-4 bg-light bg-opacity-50">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-3 bg-danger bg-opacity-10 text-danger fw-bold flex-shrink-0 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="fa-solid fa-trash-can fs-6"></i>
                            </div>

                            <div class="flex-grow-1 min-w-0">
                                <h6 class="fw-medium text-muted mb-1 text-truncate text-decoration-line-through">
                                    @q.QuestionText
                                </h6>
                                <div class="d-flex gap-2 flex-wrap">
                                    <span class="badge bg-light text-muted border">@q.QuestionFormat</span>
                                    <span class="badge bg-light text-muted border">@q.DifficultyLevel</span>
                                </div>
                            </div>

                            <form asp-controller="Questions"
                                  asp-action="Restore"
                                  asp-route-id="@q.Id"
                                  method="post"
                                  onsubmit="return confirm('Restore this question?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-success fw-semibold rounded-3 px-3">
                                    <i class="fa-solid fa-rotate-left me-1"></i> Restore
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
        <a asp-controller="Course"
           asp-action="Details"
           asp-route-id="@Model.CourseId"
           class="btn btn-outline-secondary btn-sm px-3 rounded-3 fw-semibold">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Course
        </a>

        <a asp-controller="Questions"
           asp-action="Index"
           asp-route-topicId="@Model.Id"
           class="btn btn-action-purple btn-sm px-3 rounded-3 fw-semibold">
            <i class="fa-solid fa-list me-1"></i> Question Bank
        </a>
    </div>

</div>

<div class="modal fade" id="deleteTopicModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> Delete Topic
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body py-3">
                <p class="mb-1">Are you sure you want to delete topic <strong>@Model.Name</strong>?</p>
                <p class="text-muted small mb-0">This action cannot be undone and will hide associated questions.</p>
            </div>

            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>

                <form asp-action="Delete" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger rounded-3">Delete Topic</button>
                </form>
            </div>
        </div>
    </div>
</div>

@foreach (var q in activeQuestions)
{
    <div class="modal fade" id="deleteQuestionModal-@q.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i> Delete Question
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="modal-body py-3">
                    <p class="mb-0">Are you sure you want to delete this question?</p>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>

                    <form asp-controller="Questions" asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@q.Id" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger rounded-3">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .text-purple {
        color: #6f42c1 !important;
    }

    .bg-purple-subtle {
        background-color: rgba(111, 66, 193, 0.1) !important;
    }

    .btn-purple {
        background-color: #6f42c1;
        color: #fff;
        border: none;
    }

        .btn-purple:hover {
            background-color: #5a2898;
            color: #fff;
        }

    .btn-action-purple {
        background-color: rgba(111, 66, 193, 0.1);
        color: #6f42c1;
        border: 1px solid rgba(111, 66, 193, 0.2);
    }

        .btn-action-purple:hover {
            background-color: #6f42c1;
            color: #fff;
        }

    .border-dashed {
        border: 2px dashed #dee2e6 !important;
    }

    .question-card {
        transition: all 0.2s ease;
        border: 1px solid #f0f0f0 !important;
    }

        .question-card:hover {
            border-color: #6f42c1 !important;
            box-shadow: 0 4px 14px rgba(111, 66, 193, 0.08) !important;
        }
</style>