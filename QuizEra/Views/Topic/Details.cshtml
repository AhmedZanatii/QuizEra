@model QuizEra.BLL.ModelVM.Topic.TopicDetailsVM

@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<div class="mb-5">
    <!-- Topic Header Card -->
    <div class="card dashboard-card p-4 p-md-5 mb-4 position-relative">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fs-7 fw-semibold mb-3">
                    <i class="fa-solid fa-folder-open me-1"></i> Topic
                </span>
                <h2 class="fw-bold text-dark mb-2">@Model.Name</h2>
                <p class="text-muted small mb-0">
                    <i class="fa-solid fa-circle-question me-1 text-success"></i>
                    @Model.Questions.Count() question@(Model.Questions.Count() == 1 ? "" : "s")
                </p>
            </div>

            <!-- Topic Menu Dropdown -->
            <div class="dropdown">
                <button class="btn btn-light rounded-circle shadow-sm p-0 d-flex align-items-center justify-content-center"
                        type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 40px; height: 40px;">
                    <i class="fa-solid fa-ellipsis-vertical text-secondary"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm">
                    <li>
                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@Model.Id">
                            <i class="fa-solid fa-pen-to-square me-2 text-primary"></i> Edit Topic
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteTopicModal">
                            <i class="fa-solid fa-trash-can me-2"></i> Delete Topic
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Questions Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-dark mb-1">Questions</h4>
            <p class="text-muted small mb-0">Manage the questions that belong to this topic.</p>
        </div>
        <a asp-controller="Question" asp-action="Create" asp-route-topicId="@Model.Id" class="btn btn-success btn-sm px-3">
            <i class="fa-solid fa-plus me-1"></i> Add Question
        </a>
    </div>

    <!-- Questions List -->
    @if (!Model.Questions.Any())
    {
        <div class="card dashboard-card p-5 text-center border-dashed mb-4">
            <div class="text-muted mb-3">
                <i class="fa-solid fa-file-circle-question fs-1 text-secondary opacity-50"></i>
            </div>
            <h5 class="fw-bold text-dark">No Questions Yet</h5>
            <p class="text-muted small mb-3">There are no questions in this topic yet.</p>
            <div>
                <a asp-controller="Question" asp-action="Create" asp-route-topicId="@Model.Id" class="btn btn-success btn-sm px-4">
                    <i class="fa-solid fa-plus me-1"></i> Add First Question
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2 mb-4">
            @{
                var questions = Model.Questions.ToList();
            }
            @for (int i = 0; i < questions.Count; i++)
            {
                var q = questions[i];
                <div class="card dashboard-card question-card p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-shape bg-success bg-opacity-10 text-success fw-bold rounded-3 flex-shrink-0">
                            @(i + 1)
                        </div>

                        <div class="flex-grow-1 min-w-0">
                            <h6 class="fw-semibold text-dark mb-2 text-truncate">@q.QuestionText</h6>
                            <div class="d-flex gap-2 flex-wrap">
                                <span class="badge bg-light text-secondary border fw-normal">
                                    <i class="fa-solid fa-tag me-1"></i>@q.QuestionType
                                </span>
                                @{
                                    var diffClass = q.Difficulty.ToString().ToLower() switch
                                    {
                                        "easy" => "bg-success bg-opacity-10 text-success",
                                        "medium" => "bg-warning bg-opacity-10 text-warning",
                                        "hard" => "bg-danger bg-opacity-10 text-danger",
                                        _ => "bg-secondary bg-opacity-10 text-secondary"
                                    };
                                }
                                <span class="badge @diffClass fw-medium">
                                    <i class="fa-solid fa-gauge-high me-1"></i>@q.Difficulty
                                </span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 flex-shrink-0">
                            <a asp-controller="Question" asp-action="Edit" asp-route-id="@q.Id" class="btn btn-sm btn-light text-secondary" title="Edit">
                                <i class="fa-solid fa-pen-to-square"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-light text-danger" title="Delete" data-bs-toggle="modal" data-bs-target="#deleteQuestionModal-@q.Id">
                                <i class="fa-solid fa-trash-can"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Back Button -->
    <div>
        <a asp-controller="Course" asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary btn-sm px-3">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Course
        </a>
    </div>
</div>

<!-- Modals -->
<!-- Delete Topic Modal -->
<div class="modal fade" id="deleteTopicModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> Delete Topic
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <p class="mb-1">Are you sure you want to delete topic <strong>@Model.Name</strong>?</p>
                <p class="text-muted small mb-0">This action cannot be undone and will remove all questions inside it.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete Topic</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Delete Question Modals -->
@foreach (var q in Model.Questions)
{
    <div class="modal fade" id="deleteQuestionModal-@q.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title fw-bold text-danger">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i> Delete Question
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="mb-0">Are you sure you want to delete this question?</p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <form asp-controller="Question" asp-action="Delete" method="post">
                        <input type="hidden" name="id" value="@q.Id" />
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .border-dashed {
        border: 2px dashed #e9ecef !important;
    }

    .question-card {
        transition: border-color 0.2s ease;
        border: 1px solid #e9ecef !important;
    }

        .question-card:hover {
            border-color: #198754 !important;
        }
</style>