@model QuizEra.BLL.ModelVM.Feedback.FeedbackVM

@{
    ViewData["Title"] = "Course Feedback";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="card dashboard-card border-0">
    <div class="card-body p-4 p-lg-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <a asp-controller="Course" asp-action="CourseDetailsForStud" asp-route-id="@Model.CourseID" class="text-decoration-none text-muted small">
                    <i class="fa-solid fa-arrow-left me-1"></i>Back to Course
                </a>
                <h3 class="fw-bold text-dark mt-2 mb-1">Leave a Review</h3>
            </div>
        </div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="CourseID" type="hidden" />
            <input asp-for="StudentID" type="hidden" />

            <div class="mb-4">
                <label class="form-label fw-semibold text-secondary">Your Rating</label>
                <div class="d-flex flex-wrap gap-3 mt-2">
                    @for (int i = 5; i >= 1; i--)
                    {
                        <div class="form-check form-check-inline m-0">
                            <input class="form-check-input" type="radio" asp-for="Rate" value="@i" id="rating-@i" />
                            <label class="form-check-label fw-semibold text-warning" for="rating-@i">
                                <i class="fa-solid fa-star"></i> @i
                            </label>
                        </div>
                    }
                </div>
                <span asp-validation-for="Rate" class="text-danger small d-block mt-2"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Comment" class="form-label fw-semibold text-secondary">Review</label>
                <textarea asp-for="Comment" class="form-control" rows="6" placeholder="Share what you liked about this course and how it could improve..."></textarea>
                <span asp-validation-for="Comment" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-controller="Course" asp-action="CourseDetailsForStud" asp-route-id="@Model.CourseID" class="btn btn-light">Cancel</a>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="fa-solid fa-paper-plane me-2"></i>Submit Feedback
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
