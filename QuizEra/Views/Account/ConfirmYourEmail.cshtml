@{
    ViewData["Title"] = "Confirm Your Email";
    Layout = "AuthLayout";
}

<div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="row justify-content-center w-100">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-body text-center p-4 p-md-5">

                    <!-- Icon -->
                    <div class="mx-auto mb-4 rounded-circle bg-primary bg-opacity-10
                        d-flex align-items-center justify-content-center"
                         style="width: 80px; height: 80px;">

                        <i class="bi bi-envelope-check-fill text-primary fs-1"></i>

                    </div>

                    <!-- Title -->
                    <h2 class="fw-bold mb-3">
                        Check Your Email
                    </h2>

                    <!-- Description -->
                    <p class="text-secondary mb-4">
                        We've sent a confirmation link to your email address.
                        Please check your inbox and click the link to activate
                        your QuizEra account.
                    </p>

                    <!-- Info -->
                    <div class="alert alert-primary border-0 rounded-3 text-start">
                        <div class="d-flex">
                            <i class="bi bi-info-circle-fill me-2"></i>

                            <small>
                                If you don't see the email, check your
                                <strong>Spam</strong> or
                                <strong>Junk</strong> folder.
                            </small>
                        </div>
                    </div>

                    <!-- Divider -->
                    <hr class="my-4">

                    <!-- Login -->
                    <p class="text-secondary mb-2">
                        Already confirmed your email?
                    </p>

                    <a asp-action="Login"
                       class="btn btn-primary rounded-3 px-4">
                        Go to Login
                    </a>

                </div>
            </div>

            <!-- Footer -->
            <div class="text-center mt-4">
                <small class="text-secondary">
                    © 2026 QuizEra
                </small>
            </div>

        </div>
    </div>
</div>