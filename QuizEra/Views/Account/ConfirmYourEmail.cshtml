@{
    ViewData["Title"] = "Confirm Your Email";
    Layout = "AuthLayout";
}

<style>
    /* Base Variables */
    :root {
        --qz-purple-btn: #4D2197;
        --qz-dark-text: #1B2559;
        --qz-sub-text: #707EAE;
        --qz-bg-gradient: radial-gradient(circle at 50% 50%, #F5F7FD 0%, #E9EFFC 100%);
    }

    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        background: var(--qz-bg-gradient) !important;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    /* Screen Flex Wrapper */
    .qz-screen-wrapper {
        min-height: 100vh;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        padding: 40px 20px 20px 20px;
        box-sizing: border-box;
    }

    /* Main Container */
    .qz-main-container {
        width: 100%;
        max-width: 480px;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: auto;
    }

    /* Logo Header OUTSIDE Card */
    .qz-outer-logo {
        max-width: 220px;
        height: auto;
        margin-bottom: 25px;
    }

    /* White Card */
    .qz-card {
        background: #FFFFFF;
        border-radius: 20px;
        padding: 40px 30px;
        width: 100%;
        text-align: center;
        box-sizing: border-box;
        box-shadow: 0px 15px 45px rgba(112, 144, 176, 0.18);
    }

    .qz-icon-badge {
        width: 75px;
        height: 75px;
        background-color: rgba(77, 33, 151, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px auto;
        color: var(--qz-purple-btn);
        font-size: 2rem;
    }

    .qz-title {
        color: var(--qz-dark-text);
        font-size: 1.5rem;
        font-weight: 800;
        margin: 0 0 10px 0;
    }

    .qz-description {
        color: var(--qz-sub-text);
        font-size: 0.875rem;
        line-height: 1.5;
        margin-bottom: 20px;
    }

    /* Info Box */
    .qz-info-box {
        background-color: #F4F7FE;
        border-radius: 12px;
        padding: 12px 16px;
        font-size: 0.8rem;
        color: var(--qz-dark-text);
        text-align: left;
        margin-bottom: 25px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
    }

        .qz-info-box i {
            color: var(--qz-purple-btn);
            font-size: 1rem;
            margin-top: 2px;
        }

    .qz-divider {
        border: 0;
        border-top: 1px solid #E9EFFC;
        margin: 20px 0;
    }

    .qz-secondary-text {
        color: var(--qz-sub-text);
        font-size: 0.85rem;
        margin-bottom: 12px;
    }

    /* Primary Button */
    .qz-btn-primary {
        display: inline-block;
        width: 100%;
        padding: 13px;
        background: var(--qz-purple-btn);
        color: #FFFFFF;
        border: none;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        box-shadow: 0 8px 16px rgba(77, 33, 151, 0.2);
        transition: opacity 0.2s, transform 0.2s;
        box-sizing: border-box;
    }

        .qz-btn-primary:hover {
            opacity: 0.95;
            color: #FFFFFF;
            transform: translateY(-1px);
        }

    /* Footer */
    .qz-footer {
        color: var(--qz-sub-text);
        font-size: 0.8rem;
        text-align: center;
        margin-top: 20px;
    }
</style>

<div class="qz-screen-wrapper">
    <div class="qz-main-container">

        <!-- Outer Header Logo -->
        <img src="~/images/logo-header.png" class="qz-outer-logo" alt="QuizEra Header Logo" />

        <!-- Confirm Email Card -->
        <div class="qz-card">

            <!-- Icon Badge -->
            <div class="qz-icon-badge">
                <i class="bi bi-envelope-check-fill"></i>
            </div>

            <!-- Title -->
            <h1 class="qz-title">Check Your Email</h1>

            <!-- Description -->
            <p class="qz-description">
                We've sent a confirmation link to your email address.
                Please check your inbox and click the link to activate your QuizEra account.
            </p>

            <!-- Info Alert -->
            <div class="qz-info-box">
                <i class="bi bi-info-circle-fill"></i>
                <div>
                    If you don't see the email, please check your <strong>Spam</strong> or <strong>Junk</strong> folder.
                </div>
            </div>

            <hr class="qz-divider" />

            <!-- Action Link -->
            <p class="qz-secondary-text">Already confirmed your email?</p>

            <a asp-action="Login" class="qz-btn-primary">
                Go to Login
            </a>

        </div>
    </div>

    <!-- Page Footer -->
    <div class="qz-footer">
        © 2026 QuizEra. All rights reserved.
    </div>
</div>