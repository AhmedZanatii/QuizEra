@model QuizEra.BLL.ModelVM.Auth.ResetPasswordVM

@{
    ViewData["Title"] = "Reset Password";
    Layout = "AuthLayout";

}

<div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="row justify-content-center w-100">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-body p-4 p-md-5">

                    <!-- Icon -->
                    <div class="text-center mb-4">

                        <div class="mx-auto rounded-circle bg-primary bg-opacity-10
                                    d-flex align-items-center justify-content-center"
                             style="width: 80px; height: 80px;">

                            <i class="bi bi-shield-lock-fill text-primary fs-1"></i>

                        </div>

                    </div>

                    <div class="text-center">

                        <h2 class="fw-bold mb-2">
                            Reset Your Password
                        </h2>

                        <p class="text-secondary mb-4">
                            Create a new password for your QuizEra account.
                        </p>

                    </div>

                    <form asp-action="ResetPassword" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger rounded-3">
                        </div>

                        <input asp-for="UserId" type="hidden" />
                        <input asp-for="Token" type="hidden" />

                        <!-- Password -->
                        <div class="mb-3">

                            <label asp-for="Password"
                                   class="form-label fw-semibold">
                                New Password
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-lock text-secondary"></i>
                                </span>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control border-start-0 bg-light"
                                       placeholder="Enter new password" />

                            </div>

                            <span asp-validation-for="Password"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- Confirm Password -->
                        <div class="mb-4">

                            <label asp-for="ConfirmPassword"
                                   class="form-label fw-semibold">
                                Confirm Password
                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light border-end-0">
                                    <i class="bi bi-lock-fill text-secondary"></i>
                                </span>

                                <input asp-for="ConfirmPassword"
                                       type="password"
                                       class="form-control border-start-0 bg-light"
                                       placeholder="Confirm new password" />

                            </div>

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger small">
                            </span>

                        </div>

                        <button type="submit"
                                class="btn btn-primary w-100 py-2 rounded-3 fw-semibold">

                            <i class="bi bi-check-circle me-2"></i>
                            Reset Password

                        </button>

                    </form>

                </div>
            </div>

            <div class="text-center mt-4">
                <small class="text-secondary">
                    © 2026 QuizEra
                </small>
            </div>

        </div>
    </div>
</div>