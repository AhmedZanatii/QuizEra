@model QuizEra.BLL.ModelVM.Auth.ResetPasswordVM

@{
    ViewData["Title"] = "Reset Password";
    Layout = "AuthLayout";
}

<style>
    /* Base Variables */
    :root {
        --qz-purple-btn: #4D2197;
        --qz-dark-text: #1B2559;
        --qz-sub-text: #707EAE;
        --qz-bg-gradient: radial-gradient(circle at 50% 50%, #F5F7FD 0%, #E9EFFC 100%);
        --qz-border-color: #B8C7E0;
        --qz-error-red: #EE5D50;
    }

    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        background: var(--qz-bg-gradient) !important;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    /* Screen Flex Wrapper */
    .qz-screen-wrapper {
        min-height: 100vh;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        padding: 40px 20px 20px 20px;
        box-sizing: border-box;
    }

    /* Main Container */
    .qz-main-container {
        width: 100%;
        max-width: 480px;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: auto;
    }

    /* Logo Header OUTSIDE Card */
    .qz-outer-logo {
        max-width: 220px;
        height: auto;
        margin-bottom: 25px;
    }

    /* White Card */
    .qz-card {
        background: #FFFFFF;
        border-radius: 20px;
        padding: 40px 30px;
        width: 100%;
        box-sizing: border-box;
        box-shadow: 0px 15px 45px rgba(112, 144, 176, 0.18);
    }

    /* Icon Badge */
    .qz-icon-badge {
        width: 75px;
        height: 75px;
        background-color: rgba(77, 33, 151, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px auto;
        color: var(--qz-purple-btn);
        font-size: 2rem;
    }

    .qz-title-container {
        text-align: center;
        margin-bottom: 25px;
    }

    .qz-title {
        color: var(--qz-dark-text);
        font-size: 1.5rem;
        font-weight: 800;
        margin: 0 0 8px 0;
    }

    .qz-subtitle {
        color: var(--qz-sub-text);
        font-size: 0.875rem;
        line-height: 1.5;
        margin: 0;
    }

    /* Form & Input Styling */
    .qz-form-group {
        margin-bottom: 18px;
        text-align: left;
    }

    .qz-label {
        display: block;
        color: var(--qz-dark-text);
        font-weight: 700;
        font-size: 0.85rem;
        margin-bottom: 6px;
    }

    .qz-input {
        width: 100%;
        padding: 12px 14px;
        border-radius: 10px;
        border: 1.5px solid var(--qz-border-color);
        background-color: #FFFFFF;
        font-size: 0.875rem;
        color: var(--qz-dark-text);
        box-sizing: border-box;
        outline: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

        .qz-input:focus {
            border-color: var(--qz-purple-btn);
        }

        .qz-input::placeholder {
            color: #A3AED0;
        }

        .qz-input.input-validation-error {
            border-color: var(--qz-error-red) !important;
            background-color: #FFF8F8;
        }

    /* Errors Styling */
    .qz-error-msg {
        color: var(--qz-error-red);
        font-size: 0.775rem;
        font-weight: 600;
        margin-top: 5px;
        display: block;
    }

    .qz-alert-error {
        color: var(--qz-error-red);
        background-color: #FFF0F0;
        border: 1px solid #FFD0D0;
        padding: 10px 12px;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 600;
        margin-bottom: 15px;
        text-align: center;
    }

    /* Primary Button */
    .qz-btn-primary {
        width: 100%;
        padding: 13px;
        background: var(--qz-purple-btn);
        color: #FFFFFF;
        border: none;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        box-shadow: 0 8px 16px rgba(77, 33, 151, 0.2);
        transition: opacity 0.2s, transform 0.2s;
        box-sizing: border-box;
        margin-top: 10px;
    }

        .qz-btn-primary:hover {
            opacity: 0.95;
            color: #FFFFFF;
            transform: translateY(-1px);
        }

    /* Footer */
    .qz-footer {
        color: var(--qz-sub-text);
        font-size: 0.8rem;
        text-align: center;
        margin-top: 20px;
    }
</style>

<div class="qz-screen-wrapper">
    <div class="qz-main-container">

        <!-- Outer Header Logo -->
        <img src="~/images/logo-header.png" class="qz-outer-logo" alt="QuizEra Header Logo" />

        <!-- Card -->
        <div class="qz-card">

            <!-- Icon Badge -->
            <div class="qz-icon-badge">
                <i class="bi bi-shield-lock-fill"></i>
            </div>

            <!-- Header Titles -->
            <div class="qz-title-container">
                <h1 class="qz-title">Reset Your Password</h1>
                <p class="qz-subtitle">
                    Create a new password for your QuizEra account.
                </p>
            </div>

            <!-- Form -->
            <form asp-action="ResetPassword" method="post">

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="qz-alert-error" asp-validation-summary="ModelOnly"></div>
                }

                <input asp-for="UserId" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <!-- Password Input -->
                <div class="qz-form-group">
                    <label asp-for="Password" class="qz-label">New Password</label>
                    <input asp-for="Password" type="password" class="qz-input" placeholder="Enter new password" />
                    <span asp-validation-for="Password" class="qz-error-msg"></span>
                </div>

                <!-- Confirm Password Input -->
                <div class="qz-form-group">
                    <label asp-for="ConfirmPassword" class="qz-label">Confirm Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="qz-input" placeholder="Confirm new password" />
                    <span asp-validation-for="ConfirmPassword" class="qz-error-msg"></span>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="qz-btn-primary">
                    <i class="bi bi-check-circle me-1"></i> Reset Password
                </button>

            </form>

        </div>
    </div>

    <!-- Page Footer -->
    <div class="qz-footer">
        © 2026 QuizEra. All rights reserved.
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}