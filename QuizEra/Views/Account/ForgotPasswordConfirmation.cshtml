@{
    ViewData["Title"] = "Check Your Email";
    Layout = "AuthLayout";

}

<div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="row justify-content-center w-100">
        <div class="col-12 col-sm-10 col-md-7 col-lg-5">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-body text-center p-4 p-md-5">

                    <!-- Icon -->
                    <div class="mx-auto mb-4 rounded-circle bg-success bg-opacity-10
                        d-flex align-items-center justify-content-center"
                         style="width: 80px; height: 80px;">

                        <i class="bi bi-envelope-check-fill text-success fs-1"></i>

                    </div>

                    <h2 class="fw-bold mb-3">
                        Check Your Email
                    </h2>

                    <p class="text-secondary mb-4">
                        If an account exists with the email address
                        you provided, we've sent a password reset link.
                    </p>

                    <div class="alert alert-light border rounded-3 text-start">

                        <div class="d-flex">

                            <i class="bi bi-info-circle-fill text-primary me-2"></i>

                            <small class="text-secondary">
                                The link may take a few minutes to arrive.
                                Don't forget to check your
                                <strong>Spam</strong> or
                                <strong>Junk</strong> folder.
                            </small>

                        </div>

                    </div>

                    <hr class="my-4">

                    <a asp-action="Login"
                       class="btn btn-primary rounded-3 px-4">

                        <i class="bi bi-box-arrow-in-right me-2"></i>
                        Back to Login

                    </a>

                </div>
            </div>

            <div class="text-center mt-4">
                <small class="text-secondary">
                    © 2026 QuizEra
                </small>
            </div>

        </div>
    </div>
</div>