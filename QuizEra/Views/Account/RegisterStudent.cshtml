@model QuizEra.BLL.ModelVM.Auth.RegisterStudentVM

@{
    ViewData["Title"] = "Register as Student";
    Layout = "AuthLayout";

}

<style>
    .register-page {
        min-height: calc(100vh - 56px);
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f8f9fa;
        padding: 40px 20px;
    }

    .register-container {
        width: 100%;
        max-width: 550px;
    }

    .register-card {
        background: white;
        border-radius: 15px;
        padding: 40px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
    }

    .register-title {
        font-weight: 700;
        color: #212529;
        margin-bottom: 8px;
    }

    .register-subtitle {
        color: #6c757d;
        margin-bottom: 30px;
    }

    .form-control {
        border-radius: 8px;
        padding: 12px 15px;
    }

        .form-control:focus {
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
        }

    .register-btn {
        border-radius: 8px;
        padding: 12px;
        font-weight: 600;
    }

    .validation-error {
        color: #dc3545;
        font-size: 0.9rem;
        margin-top: 5px;
        display: block;
    }

    .register-error {
        border-radius: 8px;
    }

    .login-link {
        text-decoration: none;
        font-weight: 600;
    }

    .role-icon {
        font-size: 55px;
        margin-bottom: 10px;
    }
</style>


<div class="register-page">

    <div class="register-container">

        <div class="register-card">

            <!-- Header -->

            <div class="text-center">

                <div class="role-icon">
                    🎓
                </div>

                <h1 class="register-title">
                    Student Registration
                </h1>

                <p class="register-subtitle">
                    Create your QuizEra student account
                </p>

            </div>


            <!-- Registration Form -->

            <form asp-controller="Account"
                  asp-action="RegisterStudent"
                  method="post">

                <!-- First Name -->

                <div class="mb-3">

                    <label asp-for="FirstName"
                           class="form-label">
                        First Name
                    </label>

                    <input asp-for="FirstName"
                           class="form-control"
                           placeholder="Enter your first name" />

                    <span asp-validation-for="FirstName"
                          class="validation-error">
                    </span>

                </div>


                <!-- Last Name -->

                <div class="mb-3">

                    <label asp-for="LastName"
                           class="form-label">
                        Last Name
                    </label>

                    <input asp-for="LastName"
                           class="form-control"
                           placeholder="Enter your last name" />

                    <span asp-validation-for="LastName"
                          class="validation-error">
                    </span>

                </div>


                <!-- Email -->

                <div class="mb-3">

                    <label asp-for="Email"
                           class="form-label">
                        Email Address
                    </label>

                    <input asp-for="Email"
                           type="email"
                           class="form-control"
                           placeholder="Enter your email" />

                    <span asp-validation-for="Email"
                          class="validation-error">
                    </span>

                </div>


                <!-- Password -->

                <div class="mb-3">

                    <label asp-for="Password"
                           class="form-label">
                        Password
                    </label>

                    <input asp-for="Password"
                           type="password"
                           class="form-control"
                           placeholder="Enter your password" />

                    <span asp-validation-for="Password"
                          class="validation-error">
                    </span>

                </div>


                <!-- General Errors -->
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger register-error">

                        @foreach (var error in ViewData.ModelState.Values
                            .SelectMany(v => v.Errors))
                        {
                            <div>
                                @error.ErrorMessage
                            </div>
                        }

                    </div>
                }


                <!-- Register Button -->

                <div class="d-grid mt-4">

                    <button type="submit"
                            class="btn btn-primary btn-lg register-btn">
                        Create Student Account
                    </button>

                </div>

            </form>


            <!-- Back / Login -->

            <div class="text-center mt-4">

                <p class="mb-2">

                    Already have an account?

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="login-link">
                        Login
                    </a>

                </p>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="text-secondary text-decoration-none">
                    ← Back to account type
                </a>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}

