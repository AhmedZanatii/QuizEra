@{
    ViewData["Title"] = "Choose Your Role";
    Layout = "AuthLayout";
}

<style>
    /* Reset & Base Variables matched to Design Image */
    :root {
        --qz-purple-btn: #4D2197;
        --qz-dark-text: #1B2559;
        --qz-sub-text: #707EAE;
        --qz-bg-gradient: radial-gradient(circle at 50% 50%, #F5F7FD 0%, #E9EFFC 100%);
        --qz-border-color: #B8C7E0;
        --qz-error-red: #EE5D50;
    }

    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        background: var(--qz-bg-gradient) !important;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    /* Screen Wrapper */
    .qz-screen-wrapper {
        min-height: 100vh;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        padding: 40px 20px 20px 20px;
        box-sizing: border-box;
    }

    /* Main Container */
    .qz-main-container {
        width: 100%;
        max-width: 900px;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: auto;
    }

    /* Header Logo */
    .qz-outer-logo {
        max-width: 220px;
        height: auto;
        margin-bottom: 25px;
    }

    /* Centered Titles */
    .qz-title-container {
        text-align: center;
        margin-bottom: 30px;
    }

    .qz-title {
        color: var(--qz-dark-text);
        font-size: 1.8rem;
        font-weight: 800;
        margin: 0 0 8px 0;
    }

    .qz-subtitle {
        color: var(--qz-sub-text);
        font-size: 0.95rem;
        margin: 0;
    }

    /* Role Cards Grid Container */
    .qz-roles-grid {
        width: 100%;
        display: flex;
        gap: 25px;
        justify-content: center;
        flex-wrap: wrap;
    }

    /* Role Card */
    .qz-role-card {
        background: #FFFFFF;
        border-radius: 20px;
        padding: 35px 25px;
        flex: 1;
        min-width: 280px;
        max-width: 380px;
        text-align: center;
        box-sizing: border-box;
        box-shadow: 0px 15px 45px rgba(112, 144, 176, 0.15);
        border: 2px solid transparent;
        transition: all 0.3s ease;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .qz-role-card:hover {
            transform: translateY(-6px);
            border-color: rgba(77, 33, 151, 0.3);
            box-shadow: 0px 20px 50px rgba(112, 144, 176, 0.25);
        }

    .qz-role-icon {
        font-size: 55px;
        margin-bottom: 15px;
        line-height: 1;
    }

    .qz-role-card h3 {
        color: var(--qz-dark-text);
        font-weight: 800;
        font-size: 1.3rem;
        margin-bottom: 10px;
    }

    .qz-role-card p {
        color: var(--qz-sub-text);
        font-size: 0.875rem;
        line-height: 1.5;
        margin-bottom: 25px;
        min-height: 42px;
    }

    /* Uniform Unified Button */
    .qz-btn-primary {
        width: 100%;
        padding: 13px;
        background: var(--qz-purple-btn);
        color: #FFFFFF;
        border: none;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        box-shadow: 0 8px 16px rgba(77, 33, 151, 0.2);
        transition: all 0.2s ease;
    }

        .qz-btn-primary:hover {
            opacity: 0.92;
            color: #FFFFFF;
            transform: translateY(-1px);
        }

    /* Alert Styling */
    .qz-alert-error {
        width: 100%;
        max-width: 800px;
        color: var(--qz-error-red);
        background-color: #FFF0F0;
        border: 1px solid #FFD0D0;
        padding: 12px 16px;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 25px;
        text-align: center;
        box-sizing: border-box;
    }

    /* Footer */
    .qz-footer {
        color: var(--qz-sub-text);
        font-size: 0.8rem;
        text-align: center;
        margin-top: 20px;
    }
</style>

<div class="qz-screen-wrapper">
    <div class="qz-main-container">

        <!-- Outer Logo Header -->
        <img src="~/images/logo-header.png" class="qz-outer-logo" alt="QuizEra Header Logo" />

        <!-- Titles -->
        <div class="qz-title-container">
            <h1 class="qz-title">Welcome to QuizEra!</h1>
            <p class="qz-subtitle">How would you like to use QuizEra?</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="qz-alert-error">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <!-- Cards Container -->
        <div class="qz-roles-grid">

            <!-- Student Card -->
            <div class="qz-role-card">
                <div>
                    <div class="qz-role-icon">🎓</div>
                    <h3>Student</h3>
                    <p>Join courses, take exams and track your progress.</p>
                </div>

                <form asp-controller="Account" asp-action="ChooseRole" method="post">
                    <input type="hidden" name="role" value="Student" />
                    <button type="submit" class="qz-btn-primary">
                        Continue as Student
                    </button>
                </form>
            </div>

            <!-- Instructor Card -->
            <div class="qz-role-card">
                <div>
                    <div class="qz-role-icon">👨‍🏫</div>
                    <h3>Instructor</h3>
                    <p>Create courses, manage exams and help students learn.</p>
                </div>

                <form asp-controller="Account" asp-action="ChooseRole" method="post">
                    <input type="hidden" name="role" value="Instructor" />
                    <button type="submit" class="qz-btn-primary">
                        Continue as Instructor
                    </button>
                </form>
            </div>

        </div>

    </div>

    <!-- Footer -->
    <div class="qz-footer">
        © 2026 QuizEra. All rights reserved.
    </div>
</div>