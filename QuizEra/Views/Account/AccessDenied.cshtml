@{
    ViewData["Title"] = "Access Denied";
    Layout = "AuthLayout";
}

<style>
    /* Base Variables */
    :root {
        --qz-purple-btn: #4D2197;
        --qz-dark-text: #1B2559;
        --qz-sub-text: #707EAE;
        --qz-bg-gradient: radial-gradient(circle at 50% 50%, #F5F7FD 0%, #E9EFFC 100%);
        --qz-error-red: #EE5D50;
    }

    html, body {
        height: 100%;
        margin: 0;
        padding: 0;
        background: var(--qz-bg-gradient) !important;
        font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
    }

    /* Screen Flex Wrapper */
    .qz-screen-wrapper {
        min-height: 100vh;
        width: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
        padding: 40px 20px 20px 20px;
        box-sizing: border-box;
    }

    /* Main Container */
    .qz-main-container {
        width: 100%;
        max-width: 500px;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin: auto;
    }

    /* Logo Header OUTSIDE Card */
    .qz-outer-logo {
        max-width: 220px;
        height: auto;
        margin-bottom: 25px;
    }

    /* White Card */
    .qz-card {
        background: #FFFFFF;
        border-radius: 20px;
        padding: 40px 30px;
        width: 100%;
        text-align: center;
        box-sizing: border-box;
        box-shadow: 0px 15px 45px rgba(112, 144, 176, 0.18);
    }

    .qz-icon {
        font-size: 60px;
        margin-bottom: 10px;
        line-height: 1;
    }

    .qz-error-code {
        font-size: 3.5rem;
        font-weight: 800;
        color: var(--qz-purple-btn);
        line-height: 1;
        margin-bottom: 10px;
    }

    .qz-title {
        color: var(--qz-dark-text);
        font-size: 1.5rem;
        font-weight: 800;
        margin: 0 0 10px 0;
    }

    .qz-description {
        color: var(--qz-sub-text);
        font-size: 0.9rem;
        line-height: 1.5;
        margin-bottom: 30px;
    }

    /* Primary Button */
    .qz-btn-primary {
        display: inline-block;
        width: 100%;
        padding: 13px;
        background: var(--qz-purple-btn);
        color: #FFFFFF;
        border: none;
        border-radius: 12px;
        font-weight: 700;
        font-size: 0.95rem;
        text-decoration: none;
        box-shadow: 0 8px 16px rgba(77, 33, 151, 0.2);
        transition: opacity 0.2s, transform 0.2s;
        box-sizing: border-box;
    }

        .qz-btn-primary:hover {
            opacity: 0.95;
            color: #FFFFFF;
            transform: translateY(-1px);
        }

    /* Footer */
    .qz-footer {
        color: var(--qz-sub-text);
        font-size: 0.8rem;
        text-align: center;
        margin-top: 20px;
    }
</style>

<div class="qz-screen-wrapper">
    <div class="qz-main-container">

        <!-- Outer Header Logo -->
        <img src="~/images/logo-header.png" class="qz-outer-logo" alt="QuizEra Header Logo" />

        <!-- Access Denied Card -->
        <div class="qz-card">

            <div class="qz-icon">🔒</div>

            <div class="qz-error-code">403</div>

            <h1 class="qz-title">Access Denied</h1>

            <p class="qz-description">
                Sorry, you don't have permission to access this page.
            </p>

            <a asp-controller="Home" asp-action="Index" class="qz-btn-primary">
                Back to Home
            </a>

        </div>
    </div>

    <!-- Page Footer -->
    <div class="qz-footer">
        © 2026 QuizEra. All rights reserved.
    </div>
</div>