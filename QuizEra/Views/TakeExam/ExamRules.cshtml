@model QuizEra.BLL.ModelVM.Exam.ExamVM

@{
    ViewData["Title"] = $"Prepare for {Model.Title}";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<style>
    .btn-qe-primary {
        background-color: var(--qe-primary-purple, #6f42c1);
        border-color: var(--qe-primary-purple, #6f42c1);
        color: #ffffff;
        transition: all 0.2s ease-in-out;
    }

        .btn-qe-primary:hover:not(:disabled) {
            background-color: var(--qe-active-bg, #59319d);
            border-color: var(--qe-active-bg, #59319d);
            color: #ffffff;
            transform: translateY(-1px);
        }

        .btn-qe-primary:disabled {
            opacity: 0.65;
        }

    .card-hover-effect {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .card-hover-effect:hover {
            transform: translateY(-2px);
            box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.08) !important;
        }

    .rule-item {
        transition: background-color 0.15s ease-in-out;
    }

        .rule-item:hover {
            background-color: rgba(111, 66, 193, 0.03);
        }
</style>

<div class="container-fluid px-3 px-lg-4 py-4">
    <!-- Header Section -->
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="icon-shape bg-primary bg-opacity-10 text-primary p-3 rounded-4 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px;">
            <i class="fa-solid fa-book-open-reader fs-3"></i>
        </div>
        <div>
            <h2 class="fw-bold text-dark mb-1 h3">Review Exam Details</h2>
            <p class="text-muted mb-0 small">Please review the exam information and guidelines before starting</p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Exam Details -->
        <div class="col-12 col-lg-8">
            <!-- Exam Title Card -->
            <div class="card dashboard-card border-0 shadow-sm rounded-4 mb-4 card-hover-effect">
                <div class="card-body p-4">
                    <div class="mb-4">
                        <span class="badge bg-primary bg-opacity-10 text-primary fw-semibold px-3 py-2 rounded-3 mb-2">
                            <i class="fa-solid fa-file-pen me-2"></i>Exam Information
                        </span>
                        <h3 class="fw-bold text-dark mt-2 mb-2">@Model.Title</h3>
                        <p class="text-muted mb-0">
                            <i class="fa-solid fa-book-bookmark me-2 text-primary"></i>
                            <strong>Course:</strong> @Model.CourseName
                        </p>
                    </div>

                    <!-- Quick Stats Grid -->
                    <div class="row g-3 mt-2">
                        <div class="col-12 col-sm-4">
                            <div class="bg-light rounded-3 p-3 text-center border border-light-subtle">
                                <div class="text-muted small fw-medium mb-1">
                                    <i class="fa-regular fa-clock text-primary me-1"></i> Duration
                                </div>
                                <div class="h5 fw-bold text-dark mb-0">@Model.Duration <span class="fs-6 fw-normal text-muted">min</span></div>
                            </div>
                        </div>
                        <div class="col-6 col-sm-4">
                            <div class="bg-light rounded-3 p-3 text-center border border-light-subtle">
                                <div class="text-muted small fw-medium mb-1">
                                    <i class="fa-solid fa-star text-warning me-1"></i> Total Marks
                                </div>
                                <div class="h5 fw-bold text-dark mb-0">@Model.TotalMarks</div>
                            </div>
                        </div>
                        <div class="col-6 col-sm-4">
                            <div class="bg-light rounded-3 p-3 text-center border border-light-subtle">
                                <div class="text-muted small fw-medium mb-1">
                                    <i class="fa-solid fa-list-check text-info me-1"></i> Questions
                                </div>
                                <div class="h5 fw-bold text-dark mb-0">@Model.QuestionsCount</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Topics Card -->
            @if (Model.TopicNames?.Any() == true)
            {
                <div class="card dashboard-card border-0 shadow-sm rounded-4 mb-4 card-hover-effect">
                    <div class="card-body p-4">
                        <span class="badge bg-success bg-opacity-10 text-success fw-semibold px-3 py-2 rounded-3 mb-3">
                            <i class="fa-solid fa-layer-group me-2"></i>Topics Covered
                        </span>
                        <div class="d-flex flex-wrap gap-2 mt-2">
                            @foreach (var topic in Model.TopicNames)
                            {
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3 py-2 fw-medium">
                                    <i class="fa-solid fa-tag me-1.5 opacity-75"></i>@topic
                                </span>
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Exam Availability Card -->
            <div class="card dashboard-card border-0 shadow-sm rounded-4 mb-4 card-hover-effect">
                <div class="card-body p-4">
                    <span class="badge bg-warning bg-opacity-10 text-warning-emphasis fw-semibold px-3 py-2 rounded-3 mb-3">
                        <i class="fa-solid fa-calendar-days me-2"></i>Availability Period
                    </span>
                    <div class="row g-3 mt-1">
                        <div class="col-12 col-md-6">
                            <div class="d-flex align-items-center gap-3 p-2 rounded-3 bg-light-subtle">
                                <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                    <i class="fa-solid fa-play fs-5"></i>
                                </div>
                                <div>
                                    <div class="text-muted small fw-medium">Starts On</div>
                                    <div class="fw-bold text-dark small">@Model.StartDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6">
                            <div class="d-flex align-items-center gap-3 p-2 rounded-3 bg-light-subtle">
                                <div class="icon-shape bg-danger bg-opacity-10 text-danger rounded-3 p-2.5 d-flex align-items-center justify-content-center" style="width: 42px; height: 42px;">
                                    <i class="fa-solid fa-stop fs-5"></i>
                                </div>
                                <div>
                                    <div class="text-muted small fw-medium">Closes On</div>
                                    <div class="fw-bold text-dark small">@Model.EndDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Rules & Actions -->
        <div class="col-12 col-lg-4">
            <div class="card dashboard-card border-0 shadow-sm rounded-4 sticky-top" style="top: 24px; z-index: 10;">
                <div class="card-body p-4">
                    <span class="badge bg-danger bg-opacity-10 text-danger fw-semibold px-3 py-2 rounded-3 mb-3">
                        <i class="fa-solid fa-triangle-exclamation me-2"></i>Important Rules
                    </span>

                    <div class="mt-3 d-flex flex-column gap-2">
                        <div class="d-flex gap-3 p-2 rounded-3 rule-item">
                            <i class="fa-solid fa-circle-check text-primary mt-1 fs-6"></i>
                            <div>
                                <h6 class="fw-bold text-dark mb-1 small">Timer Starts Immediately</h6>
                                <p class="text-muted small mb-0 fs-7">Once started, your @Model.Duration minutes countdown begins.</p>
                            </div>
                        </div>

                        <div class="d-flex gap-3 p-2 rounded-3 rule-item">
                            <i class="fa-solid fa-circle-check text-primary mt-1 fs-6"></i>
                            <div>
                                <h6 class="fw-bold text-dark mb-1 small">No Tab Switching</h6>
                                <p class="text-muted small mb-0 fs-7">Leaving the window may trigger academic integrity flags.</p>
                            </div>
                        </div>

                        <div class="d-flex gap-3 p-2 rounded-3 rule-item">
                            <i class="fa-solid fa-circle-check text-primary mt-1 fs-6"></i>
                            <div>
                                <h6 class="fw-bold text-dark mb-1 small">Fullscreen Required</h6>
                                <p class="text-muted small mb-0 fs-7">Exiting fullscreen mode will be logged by proctoring.</p>
                            </div>
                        </div>

                        <div class="d-flex gap-3 p-2 rounded-3 rule-item">
                            <i class="fa-solid fa-circle-check text-primary mt-1 fs-6"></i>
                            <div>
                                <h6 class="fw-bold text-dark mb-1 small">Clipboard Disabled</h6>
                                <p class="text-muted small mb-0 fs-7">Copy, paste, and context menus are completely disabled.</p>
                            </div>
                        </div>

                        <div class="d-flex gap-3 p-2 rounded-3 rule-item">
                            <i class="fa-solid fa-circle-check text-primary mt-1 fs-6"></i>
                            <div>
                                <h6 class="fw-bold text-dark mb-1 small">DevTools Blocked</h6>
                                <p class="text-muted small mb-0 fs-7">Developer console shortcuts will trigger a violation warning.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Acknowledgement -->
                    <div class="form-check mt-3 pt-3 border-top">
                        <input class="form-check-input" type="checkbox" id="rulesAck" style="width: 1.1em; height: 1.1em; cursor: pointer;">
                        <label class="form-check-label text-secondary small user-select-none" for="rulesAck" style="cursor: pointer;">
                            I have read and agree to all rules and academic integrity policies.
                        </label>
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-grid gap-2 mt-4">
                        <button type="button" class="btn btn-qe-primary fw-bold py-2.5 rounded-3" id="startExamBtn" disabled>
                            <i class="fa-solid fa-play me-2"></i>Start Exam
                        </button>
                        <button type="button" class="btn btn-outline-secondary fw-semibold py-2 rounded-3" id="backBtn">
                            <i class="fa-solid fa-arrow-left me-2"></i>Back
                        </button>
                    </div>

                    <!-- Warning Alert -->
                    <div class="alert alert-warning border-0 bg-warning bg-opacity-10 text-warning-emphasis rounded-3 p-3 mt-3 mb-0 d-flex align-items-start gap-2" role="alert">
                        <i class="fa-solid fa-shield-halved mt-1"></i>
                        <div class="small"><strong>Notice:</strong> Violations will result in zero score assignment.</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const rulesCheckbox = document.getElementById('rulesAck');
            const startExamBtn = document.getElementById('startExamBtn');
            const backBtn = document.getElementById('backBtn');
            const examId = @Model.Id;

            backBtn.addEventListener('click', function() {
                history.back();
            });

            rulesCheckbox.addEventListener('change', function() {
                startExamBtn.disabled = !this.checked;
            });

            startExamBtn.addEventListener('click', function() {
                if (!startExamBtn.disabled) {
                    window.location.href = `/TakeExam/StartExam?id=${examId}`;
                }
            });

            window.addEventListener('beforeunload', function(e) {
                if (rulesCheckbox.checked === false && startExamBtn.disabled === false) {
                    // Only prompt if user changed state but navigating away normally
                }
            });
        });
    </script>
}