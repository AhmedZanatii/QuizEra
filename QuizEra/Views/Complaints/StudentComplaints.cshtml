@model IEnumerable<QuizEra.BLL.ModelVM.Complaint.ComplaintVM>

@{
    ViewData["Title"] = "My Complaints";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="container-fluid py-4 px-md-4">
    
    <!-- Header -->
    <div class="card dashboard-card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h3 class="fw-bold text-dark mb-1">My Complaints</h3>
                <p class="text-muted small mb-0">Track the status of your submitted question disputes.</p>
            </div>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <!-- Empty State -->
        <div class="card dashboard-card border-0 shadow-sm rounded-4 text-center py-5">
            <div class="card-body">
                <div class="icon-shape bg-primary bg-opacity-10 text-primary mx-auto mb-3 p-4 rounded-circle">
                    <i class="fa-solid fa-flag fs-1"></i>
                </div>
                <h4 class="fw-bold text-dark">No Complaints Found</h4>
                <p class="text-muted mb-4">You haven't filed any complaints for your exam questions yet.</p>
                <a asp-controller="Student" asp-action="Results" class="btn btn-qe-primary fw-semibold px-4 py-2 rounded-3">
                    View My Results
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- Complaints Table -->
        <div class="card dashboard-card border-0 shadow-sm rounded-4 overflow-hidden">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light border-bottom">
                            <tr>
                                <th class="ps-4 py-3 text-muted text-uppercase fs-7 fw-bold">Question Details</th>
                                <th class="py-3 text-muted text-uppercase fs-7 fw-bold">Your Argument</th>
                                <th class="py-3 text-center text-muted text-uppercase fs-7 fw-bold">Status</th>
                                <th class="pe-4 py-3 text-center text-muted text-uppercase fs-7 fw-bold">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var complaint in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-4" style="max-width: 300px;">
                                        <div class="fw-semibold text-dark text-truncate mb-2">@complaint.ExamQuestion?.QuestionText</div>
                                        
                                        <!-- Replaced Exam ID with a Link to the Result -->
                                        <a asp-controller="TakeExam" asp-action="Result" asp-route-examId="@complaint.ExamAttempt.ExamId" class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle text-decoration-none px-2 py-1 mt-1 hover-shadow">
                                            <i class="fa-solid fa-arrow-up-right-from-square me-1"></i>View Exam Result
                                        </a>
                                    </td>
                                    <td class="py-4 text-muted small" style="max-width: 400px; white-space: normal;">
                                        @complaint.Comment
                                    </td>
                                    <td class="py-4 text-center">
                                        @if (complaint.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill fw-semibold">
                                                <i class="fa-solid fa-clock me-1"></i>Pending
                                            </span>
                                        }
                                        else if (complaint.Status.Equals("Approved", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold">
                                                <i class="fa-solid fa-check me-1"></i>@complaint.Status
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3 py-2 rounded-pill fw-semibold">
                                                <i class="fa-solid fa-xmark me-1"></i>@complaint.Status
                                            </span>
                                        }
                                    </td>
                                    <td class="pe-4 py-4 text-center">
                                        <!-- Only allow Edit/Delete if the complaint is still Pending -->
                                        @if (complaint.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="d-flex justify-content-center gap-2">
                                                <!-- Edit Button triggers modal -->
                                                <button type="button" class="btn btn-sm btn-outline-primary rounded-3" data-bs-toggle="modal" data-bs-target="#editComplaintModal-@complaint.Id" title="Edit Complaint">
                                                    <i class="fa-solid fa-pen"></i>
                                                </button>
                                                
                                                <!-- Delete Form directly POSTs to controller -->
                                                <form asp-controller="Complaints" asp-action="DeleteComplaint" asp-route-id="@complaint.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this complaint?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-3" title="Delete Complaint">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        }
                                        else
                                        {
                                            <!-- NEW: Show Feedback Button for resolved complaints -->
                                            <button type="button" class="btn btn-sm btn-outline-info rounded-3" data-bs-toggle="modal" data-bs-target="#viewFeedbackModal-@complaint.Id" title="View Instructor Feedback">
                                                <i class="fa-solid fa-comment-dots me-1"></i>Feedback
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- MODALS MOVED OUTSIDE THE TABLE -->
        @foreach (var complaint in Model)
        {
            @if (complaint.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
            {
                <!-- Edit Complaint Modal specific to this row -->
                <div class="modal fade text-start" id="editComplaintModal-@complaint.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg rounded-4">
                            <form asp-controller="Complaints" asp-action="EditComment" method="post">
                                <div class="modal-header border-bottom p-4">
                                    <h5 class="modal-title fw-bold text-dark">Edit Complaint</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body p-4">
                                    <input type="hidden" name="id" value="@complaint.Id" />
                                    <label class="form-label text-muted small fw-semibold">Update your argument</label>
                                    <!-- The name attribute matches the 'comment' string parameter in your controller -->
                                    <textarea name="comment" class="form-control rounded-3" rows="4" required>@complaint.Comment</textarea>
                                </div>
                                <div class="modal-footer border-top p-3 px-4">
                                    <button type="button" class="btn btn-secondary px-4 fw-semibold rounded-3" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-primary px-4 fw-semibold rounded-3">Save Changes</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <!-- NEW: View Feedback Modal for resolved complaints -->
                <div class="modal fade text-start" id="viewFeedbackModal-@complaint.Id" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg rounded-4">
                            <div class="modal-header border-bottom p-4">
                                <h5 class="modal-title fw-bold text-dark">Instructor Feedback</h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body p-4">
                                <div class="mb-3">
                                    <label class="form-label text-muted small fw-bold text-uppercase">Final Status</label>
                                    <div>
                                        @if (complaint.Status.Equals("Approved", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-2 rounded-pill fw-semibold">
                                                <i class="fa-solid fa-check me-1"></i>@complaint.Status
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3 py-2 rounded-pill fw-semibold">
                                                <i class="fa-solid fa-xmark me-1"></i>@complaint.Status
                                            </span>
                                        }
                                    </div>
                                </div>
                                
                                <div>
                                    <label class="form-label text-muted small fw-bold text-uppercase">Message</label>
                                    <p class="p-3 bg-light rounded-3 text-dark mb-0 border">
                                        @(string.IsNullOrWhiteSpace(complaint.Response) ? "No additional feedback provided." : complaint.Response)
                                    </p>
                                </div>
                            </div>
                            <div class="modal-footer border-top p-3 px-4">
                                <button type="button" class="btn btn-primary px-4 fw-semibold rounded-3" data-bs-dismiss="modal">Close</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>

<style>
    .fs-7 { font-size: 0.75rem; }
    .btn-qe-primary {
        background-color: var(--qe-primary-purple, #6f42c1);
        border-color: var(--qe-primary-purple, #6f42c1);
        color: #ffffff;
        transition: all 0.2s;
    }
    .btn-qe-primary:hover {
        background-color: var(--qe-active-bg, #59319d);
        color: #ffffff;
    }
    .hover-shadow:hover {
        box-shadow: 0 .125rem .25rem rgba(0,0,0,.075)!important;
    }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}