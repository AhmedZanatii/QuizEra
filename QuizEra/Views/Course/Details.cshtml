@model QuizEra.BLL.ModelVM.Course.CourseVM

@{
    ViewData["Title"] = "Course Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">@Model.CourseName</h4>
                    <span class="badge bg-light text-dark">@Model.CourseCode</span>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-sm-3 fw-bold">Course Level:</div>
                        <div class="col-sm-9">
                            <span class="badge bg-info text-dark">@Model.CourseLevel</span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-3 fw-bold">Instructor ID:</div>
                        <div class="col-sm-9">@Model.InstructorId</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-sm-3 fw-bold">Description:</div>
                        <div class="col-sm-9">
                            <p class="card-text">
                                @(string.IsNullOrWhiteSpace(Model.CourseDescription) ? "No description provided." : Model.CourseDescription)
                            </p>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-transparent d-flex justify-content-between">
                    @if (User.IsInRole("Instructor") || User.IsInRole("Admin"))
                    {
                        <a asp-action="InstructorCourses" class="btn btn-secondary">Back to My Courses</a>
                        <div>
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
                            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Are you sure you want to delete this course?');" class="d-inline ms-1">
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <a asp-action="EnrolledCourses" class="btn btn-secondary">Back to Enrolled Courses</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>