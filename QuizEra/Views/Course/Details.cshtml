@model QuizEra.BLL.ModelVM.Course.CourseDetailsVM

@{
    ViewData["Title"] = Model.CourseName;
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";

    // Extract reviews and calculate the average rating for the instructor view
    var reviews = Model.Reviews.ToList();
    var averageRating = reviews.Any() ? Math.Round(reviews.Average(r => r.Rate), 1) : 0;
}

<style>
    .btn-qe-primary {
        background-color: var(--qe-primary-purple);
        border-color: var(--qe-primary-purple);
        color: #ffffff;
    }

        .btn-qe-primary:hover {
            background-color: var(--qe-active-bg);
            border-color: var(--qe-active-bg);
            color: #ffffff;
        }

    .btn-qe-outline {
        color: var(--qe-primary-purple);
        border-color: var(--qe-primary-purple);
        background-color: transparent;
    }

        .btn-qe-outline:hover {
            background-color: var(--qe-primary-soft);
            color: var(--qe-active-bg);
            border-color: var(--qe-primary-purple);
        }

    .badge-qe-purple {
        background-color: var(--qe-primary-soft);
        color: var(--qe-primary-purple);
    }

    .text-qe-purple {
        color: var(--qe-primary-purple) !important;
    }

    .join-code-box {
        background-color: #fcfaff;
        border-color: var(--qe-primary-soft) !important;
    }

    .border-dashed {
        border: 2px dashed #e2e8f0 !important;
    }

    .topic-card {
        transition: transform 0.2s ease, border-color 0.2s ease;
        border: 1px solid #e9ecef !important;
    }

        .topic-card:hover {
            transform: translateX(4px);
            border-color: var(--qe-primary-purple) !important;
        }

            .topic-card:hover .transition-icon {
                color: var(--qe-primary-purple) !important;
            }
</style>

<!-- Header & Join Code -->
<div class="mb-4">
    <div class="card dashboard-card border-0 shadow-sm p-4 p-md-5 mb-4 position-relative">
        <div class="d-flex justify-content-between align-items-start">
            <div class="pe-3">
                <span class="badge badge-qe-purple rounded-pill px-3 py-2 fs-7 fw-semibold mb-3">
                    @Model.CourseLevel
                </span>
                <h2 class="fw-bold text-dark mb-2">@Model.CourseName</h2>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="text-muted mb-0 max-w-800">@Model.Description</p>
                }
            </div>

            <div class="dropdown">
                <button class="btn btn-light rounded-circle shadow-sm p-0 d-flex align-items-center justify-content-center"
                        type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 40px; height: 40px;">
                    <i class="fa-solid fa-ellipsis-vertical text-secondary"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm">
                    <li>
                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@Model.Id">
                            <i class="fa-solid fa-pen-to-square me-2 text-qe-purple"></i> Edit Course
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteCourseModal">
                            <i class="fa-solid fa-trash-can me-2"></i> Delete Course
                        </button>
                    </li>
                </ul>
            </div>
        </div>

        <div class="join-code-box mt-4 p-3 rounded-3 border d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
            <div>
                <span class="text-muted small fw-semibold d-block mb-1">
                    <i class="fa-solid fa-key me-1 text-qe-purple"></i> Student Join Code
                </span>
                <span class="font-monospace fw-bold fs-5 text-qe-purple me-2">@Model.CourseCode</span>
                <small class="text-muted d-block d-sm-inline">Share this code with students to let them join.</small>
            </div>
            <button type="button" class="btn btn-qe-outline btn-sm px-3 flex-shrink-0 fw-semibold rounded-3" onclick="copyCourseCode()">
                <i class="fa-regular fa-copy me-1"></i> Copy Code
            </button>
        </div>

        <div id="copyMessage" class="text-qe-purple small mt-2 d-none fw-semibold">
            <i class="fa-solid fa-circle-check me-1"></i> Course code copied to clipboard!
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Left Column: Topics -->
    <div class="col-12 col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h4 class="fw-bold text-dark mb-1">Topics</h4>
                <p class="text-muted small mb-0">Organize the content of your course into structured topics.</p>
            </div>
            <button type="button" class="btn btn-qe-primary btn-sm px-3 fw-semibold rounded-3" data-bs-toggle="modal" data-bs-target="#addTopicModal">
                <i class="fa-solid fa-plus me-1"></i> Add Topic
            </button>
        </div>

        @if (!Model.Topics.Any())
        {
            <div class="card dashboard-card border-0 shadow-sm p-5 text-center border-dashed">
                <div class="text-muted mb-3">
                    <i class="fa-solid fa-folder-open fs-1 text-secondary opacity-50"></i>
                </div>
                <h5 class="fw-bold text-dark">No Topics Yet</h5>
                <p class="text-muted small mb-3">Start organizing your course content by adding your first topic.</p>
                <div>
                    <button type="button" class="btn btn-qe-primary btn-sm px-4 fw-semibold rounded-3" data-bs-toggle="modal" data-bs-target="#addTopicModal">
                        <i class="fa-solid fa-plus me-1"></i> Add First Topic
                    </button>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-2">
                @{
                    var topics = Model.Topics.ToList();
                }
                @for (int i = 0; i < topics.Count; i++)
                {
                    var topic = topics[i];
                    <a asp-controller="Topic" asp-action="Details" asp-route-id="@topic.Id" class="text-decoration-none">
                        <div class="card dashboard-card border-0 shadow-sm topic-card p-3 rounded-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-shape badge-qe-purple fw-bold rounded-3 p-2 px-3">
                                    @(i + 1)
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="fw-semibold text-dark mb-0">@topic.Name</h6>
                                    <span class="text-muted small">Topic @(i + 1)</span>
                                </div>
                                <i class="fa-solid fa-chevron-right text-muted transition-icon"></i>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>

    <!-- Right Column: Student Reviews -->
    <div class="col-12 col-lg-5">
        <div class="card dashboard-card border-0 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                    <div>
                        <h5 class="fw-bold mb-1 text-dark">Student Reviews</h5>
                        <p class="text-muted small mb-0">@reviews.Count reviews</p>
                    </div>
                    <div class="text-end">
                        <div class="fw-bold text-warning fs-4">@averageRating <i class="fa-solid fa-star fs-6"></i></div>
                        <div class="text-muted small">Average rating</div>
                    </div>
                </div>

                @if (!reviews.Any())
                {
                    <div class="text-center py-5 border rounded-3 bg-light">
                        <i class="fa-regular fa-comment-dots text-muted fs-2 mb-3 d-block"></i>
                        <p class="text-muted mb-0 small">No feedback provided yet.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3 overflow-auto" style="max-height: 400px;">
                        @foreach (var review in reviews)
                        {
                            <div class="border rounded-3 p-3 bg-light">
                                <div class="d-flex justify-content-between align-items-center gap-3 mb-2">
                                    <div class="fw-semibold text-dark small">
                                        Student Feedback
                                    </div>
                                    <div class="text-warning small">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= review.Rate)
                                            {
                                                <i class="fa-solid fa-star"></i>
                                            }
                                            else
                                            {
                                                <i class="fa-regular fa-star text-muted opacity-50"></i>
                                            }
                                        }
                                    </div>
                                </div>
                                <p class="text-muted small mb-0">@review.Comment</p>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modals -->
<div class="modal fade" id="deleteCourseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> Delete Course
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <p class="mb-1">Are you sure you want to delete <strong>@Model.CourseName</strong>?</p>
                <p class="text-muted small mb-0">This action cannot be undone and will remove all associated exams and topics.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger rounded-3">Delete Course</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addTopicModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="fa-solid fa-folder-plus text-qe-purple me-2"></i> Add New Topic
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Topic" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body py-0">
                    <input type="hidden" name="CourseId" value="@Model.Id" />
                    <div class="mb-3">
                        <label for="topicName" class="form-label fw-semibold text-secondary small">Topic Name</label>
                        <input type="text" id="topicName" name="Name" class="form-control rounded-3" placeholder="e.g. Introduction to Software Engineering" required maxlength="100" />
                    </div>
                </div>
                <div class="modal-footer border-top-0">
                    <button type="button" class="btn btn-light rounded-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-qe-primary rounded-3">Add Topic</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyCourseCode() {
            const courseCode = '@Model.CourseCode';
            navigator.clipboard.writeText(courseCode).then(() => {
                const message = document.getElementById("copyMessage");
                message.classList.remove("d-none");
                setTimeout(() => { message.classList.add("d-none"); }, 2500);
            });
        }
    </script>
}