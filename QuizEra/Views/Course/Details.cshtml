@model QuizEra.BLL.ModelVM.Course.CourseDetailsVM

@{
    ViewData["Title"] = Model.CourseName;
}

<div class="container mt-4 mb-5">

    <!-- Course Header -->
    <div class="card course-header border-0 shadow-sm mb-5">
        <div class="card-body p-4 p-md-5">

            <div class="d-flex justify-content-between align-items-start">

                <div class="course-info">

                    <span class="badge course-level mb-3">
                        @Model.CourseLevel
                    </span>

                    <h1 class="course-title">
                        @Model.CourseName
                    </h1>

                    @if (!string.IsNullOrWhiteSpace(Model.Description))
                    {
                        <p class="course-description">
                            @Model.Description
                        </p>
                    }

                </div>

                <!-- Course Menu -->
                <div class="dropdown">

                    <button class="btn menu-button"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false"
                            title="Course options">

                        <i class="bi bi-three-dots-vertical"></i>

                    </button>

                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">

                        <li>
                            <a class="dropdown-item"
                               asp-action="Edit"
                               asp-route-id="@Model.Id">

                                <i class="bi bi-pencil me-2"></i>
                                Edit Course

                            </a>
                        </li>

                        <li>
                            <hr class="dropdown-divider">
                        </li>

                        <li>
                            <button type="button"
                                    class="dropdown-item text-danger"
                                    data-bs-toggle="modal"
                                    data-bs-target="#deleteCourseModal">

                                <i class="bi bi-trash me-2"></i>
                                Delete Course

                            </button>
                        </li>

                    </ul>

                </div>

            </div>

            <!-- Course Join Code -->
            <div class="join-code-container mt-4">

                <div>
                    <span class="join-code-label">
                        <i class="bi bi-key me-1"></i>
                        Student Join Code
                    </span>

                    <div class="join-code">
                        @Model.CourseCode
                    </div>

                    <small class="text-muted">
                        Students can use this code to join your course.
                    </small>
                </div>

                <button type="button"
                        class="btn btn-outline-primary copy-button"
                        onclick="copyCourseCode()">

                    <i class="bi bi-copy me-1"></i>
                    Copy

                </button>

            </div>

            <!-- Copy Feedback -->
            <div id="copyMessage"
                 class="copy-message d-none">

                <i class="bi bi-check-circle-fill me-1"></i>
                Course code copied!

            </div>

        </div>
    </div>


    <!-- Topics Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <div>
            <h3 class="section-title mb-1">
                Topics
            </h3>

            <p class="text-muted mb-0">
                Organize the content of your course into topics.
            </p>
        </div>

        <button type="button"
                class="btn btn-primary add-topic-button"
                data-bs-toggle="modal"
                data-bs-target="#addTopicModal">

            <i class="bi bi-plus-lg me-1"></i>
            Add Topic

        </button>

    </div>


    <!-- Topics -->
    @if (!Model.Topics.Any())
    {
        <div class="empty-topics text-center py-5">

            <div class="empty-icon-container">
                <i class="bi bi-journal-text"></i>
            </div>

            <h5 class="mt-3 fw-bold">
                No topics yet
            </h5>

            <p class="text-muted mb-4">
                Start organizing your course by adding your first topic.
            </p>

            <button type="button"
                    class="btn btn-primary"
                    data-bs-toggle="modal"
                    data-bs-target="#addTopicModal">

                <i class="bi bi-plus-lg me-1"></i>
                Add First Topic

            </button>

        </div>
    }
    else
    {
        <div class="topics-list">

            @{
                var topics = Model.Topics.ToList();
            }

            @for (int i = 0; i < topics.Count; i++)
            {
                var topic = topics[i];

                <a asp-controller="Topic"
                   asp-action="Details"
                   asp-route-id="@topic.Id"
                   class="topic-item text-decoration-none">

                    <div class="topic-number">
                        @(i + 1)
                    </div>

                    <div class="topic-info">

                        <h5 class="mb-1">
                            @topic.Name
                        </h5>

                        <small class="text-muted">
                            Topic @(i + 1)
                        </small>

                    </div>

                    <div class="topic-arrow">
                        <i class="bi bi-chevron-right"></i>
                    </div>

                </a>
            }

        </div>
    }

</div>

<!-- Delete Course Modal -->
<div class="modal fade"
     id="deleteCourseModal"
     tabindex="-1"
     aria-labelledby="deleteCourseModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">
                <h5 class="modal-title fw-bold"
                    id="deleteCourseModalLabel">

                    <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
                    Delete Course

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <p class="mb-2">
                    Are you sure you want to delete
                    <strong>@Model.CourseName</strong>?
                </p>

                <p class="text-muted mb-0">
                    This action cannot be undone.
                </p>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-light"
                        data-bs-dismiss="modal">

                    Cancel

                </button>

                <form asp-action="Delete"
                      asp-route-id="@Model.Id"
                      method="post">

                    <button type="submit"
                            class="btn btn-danger">

                        <i class="bi bi-trash me-1"></i>
                        Delete Course

                    </button>

                </form>

            </div>

        </div>

    </div>
</div>
<!-- Add Topic Modal -->
<div class="modal fade"
     id="addTopicModal"
     tabindex="-1"
     aria-labelledby="addTopicModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 shadow">

            <div class="modal-header">

                <h5 class="modal-title fw-bold"
                    id="addTopicModalLabel">

                    <i class="bi bi-journal-plus me-2 text-primary"></i>
                    Add New Topic

                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>

            <form asp-controller="Topic"
                  asp-action="Create"
                  method="post">

                <div class="modal-body">

                    <input type="hidden"
                           name="CourseId"
                           value="@Model.Id" />

                    <div class="mb-3">

                        <label for="topicName"
                               class="form-label fw-semibold">

                            Topic Name

                        </label>

                        <input type="text"
                               id="topicName"
                               name="Name"
                               class="form-control"
                               placeholder="e.g. Introduction to Software Engineering"
                               required
                               maxlength="100" />

                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-light"
                            data-bs-dismiss="modal">

                        Cancel

                    </button>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-plus-lg me-1"></i>
                        Add Topic

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
<style>

    /* =========================
       Course Header
       ========================= */

    .course-header {
        border-radius: 20px;
        overflow: hidden;
        background: #ffffff;
    }

    .course-info {
        max-width: 85%;
    }

    .course-level {
        background: #e8f7f0;
        color: #198754;
        padding: 7px 14px;
        border-radius: 20px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .course-title {
        font-size: clamp(2rem, 4vw, 2.7rem);
        font-weight: 750;
        color: #212529;
        margin-bottom: 12px;
    }

    .course-description {
        color: #6c757d;
        font-size: 1.05rem;
        line-height: 1.7;
        max-width: 800px;
        margin-bottom: 0;
    }


    /* =========================
       Course Menu
       ========================= */

    .menu-button {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #f8f9fa;
        color: #495057;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
        border: none;
        transition: all 0.2s ease;
    }

    .menu-button:hover {
        background: #e9ecef;
        color: #212529;
    }


    /* =========================
       Join Code
       ========================= */

    .join-code-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        background: #f8faff;
        border: 1px solid #e1e9f5;
        border-radius: 14px;
        padding: 16px 18px;
    }

    .join-code-label {
        display: block;
        color: #6c757d;
        font-size: 0.85rem;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .join-code {
        font-family: monospace;
        font-size: 1.15rem;
        font-weight: 700;
        color: #0d6efd;
        letter-spacing: 0.5px;
        word-break: break-all;
    }

    .copy-button {
        flex-shrink: 0;
    }

    .copy-message {
        color: #198754;
        font-size: 0.85rem;
        margin-top: 10px;
    }


    /* =========================
       Topics
       ========================= */

    .section-title {
        font-size: 1.6rem;
        font-weight: 700;
    }

    .add-topic-button {
        white-space: nowrap;
    }

    .topics-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .topic-item {
        display: flex;
        align-items: center;
        gap: 18px;
        background: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 14px;
        padding: 17px 20px;
        color: #212529;
        transition: all 0.2s ease;
    }

    .topic-item:hover {
        border-color: #0d6efd;
        transform: translateX(4px);
        box-shadow: 0 5px 18px rgba(0, 0, 0, 0.07);
    }

    .topic-number {
        width: 44px;
        height: 44px;
        border-radius: 11px;
        background: #e9f2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        flex-shrink: 0;
    }

    .topic-info {
        flex: 1;
        min-width: 0;
    }

    .topic-info h5 {
        font-weight: 600;
        color: #212529;
        overflow-wrap: break-word;
    }

    .topic-arrow {
        color: #adb5bd;
        font-size: 18px;
        transition: all 0.2s ease;
    }

    .topic-item:hover .topic-arrow {
        color: #0d6efd;
        transform: translateX(4px);
    }


    /* =========================
       Empty State
       ========================= */

    .empty-topics {
        background: #ffffff;
        border: 2px dashed #dee2e6;
        border-radius: 16px;
    }

    .empty-icon-container {
        width: 70px;
        height: 70px;
        margin: auto;
        border-radius: 50%;
        background: #f1f5f9;
        color: #94a3b8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
    }


    /* =========================
       Responsive
       ========================= */

    @@media (max-width: 576px) {

        .course-header .card-body {
            padding: 25px !important;
        }

        .course-info {
            max-width: 80%;
        }

        .course-title {
            font-size: 1.8rem;
        }

        .join-code-container {
            align-items: flex-start;
            flex-direction: column;
        }

        .copy-button {
            width: 100%;
        }

        .add-topic-button {
            padding: 8px 12px;
        }

    }

</style>




@section Scripts {
    <script>
        function copyCourseCode() {
            const courseCode = '@Model.CourseCode';

            navigator.clipboard.writeText(courseCode)
                .then(() => {
                    const message = document.getElementById("copyMessage");

                    message.classList.remove("d-none");

                    setTimeout(() => {
                        message.classList.add("d-none");
                    }, 2000);
                })
                .catch(err => {
                    console.error("Failed to copy course code:", err);
                });
        }
    </script>
}