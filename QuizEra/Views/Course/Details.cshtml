@model QuizEra.BLL.ModelVM.Course.CourseDetailsVM

@{
    ViewData["Title"] = Model.CourseName;
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<div class="mb-4">
    <!-- Course Header Card -->
    <div class="card dashboard-card p-4 p-md-5 mb-4 position-relative">
        <div class="d-flex justify-content-between align-items-start">
            <div class="pe-3">
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fs-7 fw-semibold mb-3">
                    @Model.CourseLevel
                </span>
                <h2 class="fw-bold text-dark mb-2">@Model.CourseName</h2>

                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    <p class="text-muted mb-0 max-w-800">@Model.Description</p>
                }
            </div>

            <!-- Options Menu -->
            <div class="dropdown">
                <button class="btn btn-light rounded-circle shadow-sm p-0 d-flex align-items-center justify-content-center"
                        type="button" data-bs-toggle="dropdown" aria-expanded="false" style="width: 40px; height: 40px;">
                    <i class="fa-solid fa-ellipsis-vertical text-secondary"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm">
                    <li>
                        <a class="dropdown-item" asp-action="Edit" asp-route-id="@Model.Id">
                            <i class="fa-solid fa-pen-to-square me-2 text-primary"></i> Edit Course
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <button type="button" class="dropdown-item text-danger" data-bs-toggle="modal" data-bs-target="#deleteCourseModal">
                            <i class="fa-solid fa-trash-can me-2"></i> Delete Course
                        </button>
                    </li>
                </ul>
            </div>
        </div>

        <!-- Student Join Code Box -->
        <div class="join-code-box mt-4 p-3 rounded-3 border d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
            <div>
                <span class="text-muted small fw-semibold d-block mb-1">
                    <i class="fa-solid fa-key me-1 text-success"></i> Student Join Code
                </span>
                <span class="font-monospace fw-bold fs-5 text-success me-2">@Model.CourseCode</span>
                <small class="text-muted d-block d-sm-inline">Share this code with students to let them join.</small>
            </div>
            <button type="button" class="btn btn-outline-success btn-sm px-3 flex-shrink-0" onclick="copyCourseCode()">
                <i class="fa-regular fa-copy me-1"></i> Copy Code
            </button>
        </div>

        <div id="copyMessage" class="text-success small mt-2 d-none">
            <i class="fa-solid fa-circle-check me-1"></i> Course code copied to clipboard!
        </div>
    </div>

    <!-- Topics Header -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="fw-bold text-dark mb-1">Topics</h4>
            <p class="text-muted small mb-0">Organize the content of your course into structured topics.</p>
        </div>
        <button type="button" class="btn btn-success btn-sm px-3" data-bs-toggle="modal" data-bs-target="#addTopicModal">
            <i class="fa-solid fa-plus me-1"></i> Add Topic
        </button>
    </div>

    <!-- Topics List -->
    @if (!Model.Topics.Any())
    {
        <div class="card dashboard-card p-5 text-center border-dashed">
            <div class="text-muted mb-3">
                <i class="fa-solid fa-folder-open fs-1 text-secondary opacity-50"></i>
            </div>
            <h5 class="fw-bold text-dark">No Topics Yet</h5>
            <p class="text-muted small mb-3">Start organizing your course content by adding your first topic.</p>
            <div>
                <button type="button" class="btn btn-success btn-sm px-4" data-bs-toggle="modal" data-bs-target="#addTopicModal">
                    <i class="fa-solid fa-plus me-1"></i> Add First Topic
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex flex-column gap-2">
            @{
                var topics = Model.Topics.ToList();
            }
            @for (int i = 0; i < topics.Count; i++)
            {
                var topic = topics[i];
                <a asp-controller="Topic" asp-action="Details" asp-route-id="@topic.Id" class="text-decoration-none">
                    <div class="card dashboard-card topic-card p-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-shape bg-success bg-opacity-10 text-success fw-bold rounded-3">
                                @(i + 1)
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="fw-semibold text-dark mb-0">@topic.Name</h6>
                                <span class="text-muted small">Topic @(i + 1)</span>
                            </div>
                            <i class="fa-solid fa-chevron-right text-muted transition-icon"></i>
                        </div>
                    </div>
                </a>
            }
        </div>
    }
</div>

<!-- Modals -->
<!-- Delete Course Modal -->
<div class="modal fade" id="deleteCourseModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold text-danger">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> Delete Course
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <p class="mb-1">Are you sure you want to delete <strong>@Model.CourseName</strong>?</p>
                <p class="text-muted small mb-0">This action cannot be undone and will remove all associated exams and topics.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Delete Course</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Add Topic Modal -->
<div class="modal fade" id="addTopicModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0">
                <h5 class="modal-title fw-bold text-dark">
                    <i class="fa-solid fa-folder-plus text-success me-2"></i> Add New Topic
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-controller="Topic" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body py-0">
                    <input type="hidden" name="CourseId" value="@Model.Id" />
                    <div class="mb-3">
                        <label for="topicName" class="form-label fw-semibold text-secondary small">Topic Name</label>
                        <input type="text" id="topicName" name="Name" class="form-control" placeholder="e.g. Introduction to Software Engineering" required maxlength="100" />
                    </div>
                </div>
                <div class="modal-footer border-top-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">Add Topic</button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .join-code-box {
        background-color: #f8fdf9;
        border-color: #d1e7dd !important;
    }

    .border-dashed {
        border: 2px dashed #e9ecef !important;
    }

    .topic-card {
        transition: transform 0.2s ease, border-color 0.2s ease;
        border: 1px solid #e9ecef !important;
    }

        .topic-card:hover {
            transform: translateX(4px);
            border-color: #198754 !important;
        }

            .topic-card:hover .transition-icon {
                color: #198754 !important;
            }
</style>

@section Scripts {
    <script>
        function copyCourseCode() {
            const courseCode = '@Model.CourseCode';
            navigator.clipboard.writeText(courseCode).then(() => {
                const message = document.getElementById("copyMessage");
                message.classList.remove("d-none");
                setTimeout(() => { message.classList.add("d-none"); }, 2500);
            });
        }
    </script>
}