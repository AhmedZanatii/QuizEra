@model QuizEra.BLL.ModelVM.Course.UpdateCourseVM

@{
    ViewData["Title"] = "Edit Course";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-10 col-xl-8">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />

            <!-- Header Section -->
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
                <div>
                    <h3 class="fw-bold text-dark m-0">Edit Course</h3>
                    <p class="text-muted small mb-0">Update information and settings for your course container.</p>
                </div>
                <div class="d-flex gap-2">
                    <a asp-controller="Course" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary px-4 fw-medium">Cancel</a>
                    <button type="submit" class="btn btn-warning text-white px-4 fw-medium">
                        <i class="fa-solid fa-check me-1"></i> Save Changes
                    </button>
                </div>
            </div>

            <!-- Course Details Card -->
            <div class="card dashboard-card p-4">
                <h5 class="fw-bold text-dark mb-4 pb-2 border-bottom">Course Details</h5>

                <!-- Course Name Field -->
                <div class="mb-3">
                    <label asp-for="CourseName" class="form-label fw-semibold text-secondary small">
                        Course Name <span class="text-danger">*</span>
                    </label>
                    <input asp-for="CourseName" class="form-control" placeholder="e.g., Introduction to Advanced Calculus" />
                    <div class="form-text text-muted small">The official name of the course.</div>
                    <span asp-validation-for="CourseName" class="text-danger small"></span>
                </div>

                <!-- Course Level Field -->
                <div class="mb-3">
                    <label asp-for="CourseLevel" class="form-label fw-semibold text-secondary small">
                        Course Level <span class="text-danger">*</span>
                    </label>
                    <select asp-for="CourseLevel" class="form-select">
                        <option value="">Select Level...</option>
                        <option value="Beginner">Beginner</option>
                        <option value="Intermediate">Intermediate</option>
                        <option value="Advanced">Advanced</option>
                    </select>
                    <div class="form-text text-muted small">Difficulty classification for enrolled students.</div>
                    <span asp-validation-for="CourseLevel" class="text-danger small"></span>
                </div>

                <!-- Course Description Field -->
                <div class="mb-2">
                    <label asp-for="CourseDescription" class="form-label fw-semibold text-secondary small">Course Description</label>
                    <textarea asp-for="CourseDescription" class="form-control" rows="4" placeholder="Provide a brief overview of the course objectives and content..."></textarea>
                    <span asp-validation-for="CourseDescription" class="text-danger small"></span>
                </div>
            </div>
        </form>
    </div>
</div>