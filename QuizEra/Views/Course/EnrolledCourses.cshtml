@model IEnumerable<QuizEra.BLL.ModelVM.Course.CourseVM>

@{
    ViewData["Title"] = "My Enrolled Courses";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<style>
    .btn-qe-primary {
        background-color: var(--qe-primary-purple);
        border-color: var(--qe-primary-purple);
        color: #ffffff;
    }

        .btn-qe-primary:hover {
            background-color: var(--qe-active-bg);
            border-color: var(--qe-active-bg);
            color: #ffffff;
        }

    .badge-qe-purple {
        background-color: var(--qe-primary-soft);
        color: var(--qe-primary-purple);
    }

    .text-qe-purple {
        color: var(--qe-primary-purple) !important;
    }

    .course-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 1px solid #e9ecef !important;
    }

        .course-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(108, 92, 231, 0.12) !important;
        }

            .course-card:hover .course-title {
                color: var(--qe-primary-purple) !important;
            }

            .course-card:hover .transition-icon {
                transform: translateX(4px);
            }

    .transition-icon {
        transition: transform 0.2s ease;
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .form-control:focus {
        border-color: var(--qe-primary-purple);
        box-shadow: 0 0 0 0.25rem rgba(108, 92, 231, 0.25);
    }
</style>

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">My Enrolled Courses</h3>
        <p class="text-muted small mb-0">Courses you are currently registered in.</p>
    </div>

    <form asp-action="Join" method="post" class="d-flex gap-2">
        @Html.AntiForgeryToken()
        <div class="input-group">
            <input name="courseCode" type="text" class="form-control rounded-start-3" placeholder="Enter course code..." required />
            <button class="btn btn-qe-primary px-3 rounded-end-3" type="submit">
                <i class="fa-solid fa-plus me-1"></i> Join
            </button>
        </div>
    </form>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mb-4 rounded-3">
        <ul class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

@if (!Model.Any())
{
    <div class="card dashboard-card border-0 shadow-sm p-5 text-center">
        <div class="text-muted mb-3">
            <i class="fa-solid fa-book-open fs-1 text-secondary opacity-50"></i>
        </div>
        <h5 class="fw-bold text-dark">No Courses Found</h5>
        <p class="text-muted small mb-0">You are not enrolled in any courses yet. Enter a course code above to join one!</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var course in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <a asp-controller="Course" asp-action="CourseDetailsForStud" asp-route-id="@course.Id" class="text-decoration-none">
                    <div class="card dashboard-card border-0 shadow-sm course-card h-100 p-3 rounded-3">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="p-2 rounded-3 badge-qe-purple">
                                        <i class="fa-solid fa-book-bookmark fs-5"></i>
                                    </div>
                                    <span class="badge badge-qe-purple rounded-pill px-3 py-2 fs-7 fw-semibold">
                                        @course.CourseLevel
                                    </span>
                                </div>

                                <h5 class="fw-bold text-dark mb-2 course-title">
                                    @course.CourseName
                                </h5>

                                @if (!string.IsNullOrWhiteSpace(course.CourseDescription))
                                {
                                    <p class="text-muted small text-truncate-2 mb-0">
                                        @course.CourseDescription
                                    </p>
                                }
                            </div>

                            <div class="pt-3 mt-3 border-top d-flex justify-content-between align-items-center text-qe-purple fw-semibold small course-footer">
                                <span>View Course</span>
                                <i class="fa-solid fa-arrow-right transition-icon"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}