@model IEnumerable<QuizEra.BLL.ModelVM.Course.CourseVM>

@{
    ViewData["Title"] = "My Enrolled Courses";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2>My Enrolled Courses</h2>
        <p class="text-muted">Courses you are currently registered in.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center" role="alert">
            You are not enrolled in any courses yet.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var course in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge bg-secondary">@course.CourseCode</span>
                                <span class="badge bg-success">Enrolled</span>
                            </div>
                            <h5 class="card-title text-primary">@course.CourseName</h5>
                            <p class="card-text text-muted text-truncate" style="max-height: 4.5em;">
                                @(string.IsNullOrWhiteSpace(course.CourseDescription) ? "No description provided." : course.CourseDescription)
                            </p>
                        </div>
                        <div class="card-footer bg-transparent border-0 pb-3">
                            <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-primary w-100">
                                View Course Content
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>