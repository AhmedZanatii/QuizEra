@model IEnumerable<QuizEra.BLL.ModelVM.Course.CourseVM>

@{
    ViewData["Title"] = "My Teaching Courses";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">My Teaching Courses</h2>
            <p class="text-muted mb-0">Manage and view the courses you teach.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary px-4">
            <i class="bi bi-plus-lg me-1"></i>
            Create Course
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info text-center py-4" role="alert">
            <i class="bi bi-journal-x fs-3 d-block mb-2"></i>
            <strong>No courses yet</strong>
            <p class="mb-0 mt-1">You haven't created any courses yet.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var course in Model)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <a asp-action="Details"
                       asp-route-id="@course.Id"
                       class="text-decoration-none">

                        <div class="card course-card h-100 border-0">

                            <div class="card-body p-4">

                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="course-icon">
                                        <i class="bi bi-journal-bookmark-fill"></i>
                                    </div>

                                    <span class="badge course-level">
                                        @course.CourseLevel
                                    </span>
                                </div>

                                <h4 class="course-title mb-3">
                                    @course.CourseName
                                </h4>

                                <div class="course-footer">
                                    <span>View course</span>
                                    <i class="bi bi-arrow-right"></i>
                                </div>

                            </div>

                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

<style>
    .course-card {
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
        transition: all 0.25s ease;
        overflow: hidden;
        position: relative;
    }

        .course-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: #0d6efd;
        }

        .course-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.12);
        }

    .course-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #e9f2ff;
        color: #0d6efd;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .course-level {
        background: #e8f7f0;
        color: #198754;
        padding: 7px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .course-title {
        color: #212529;
        font-weight: 700;
        line-height: 1.3;
        transition: color 0.2s ease;
    }

    .course-card:hover .course-title {
        color: #0d6efd;
    }

    .course-footer {
        margin-top: 25px;
        padding-top: 15px;
        border-top: 1px solid #eeeeee;
        display: flex;
        justify-content: space-between;
        align-items: center;
        color: #6c757d;
        font-size: 0.9rem;
        font-weight: 500;
    }

        .course-footer i {
            transition: transform 0.2s ease;
        }

    .course-card:hover .course-footer i {
        transform: translateX(5px);
        color: #0d6efd;
    }
</style>