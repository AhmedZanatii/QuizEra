@model IEnumerable<QuizEra.BLL.ModelVM.Course.CourseVM>

@{
    ViewData["Title"] = "My Teaching Courses";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold text-dark m-0">My Teaching Courses</h3>
        <p class="text-muted small mb-0">Manage and view the courses you teach.</p>
    </div>

    <a asp-action="Create" class="btn btn-success px-4">
        <i class="fa-solid fa-plus me-1"></i> Create Course
    </a>
</div>

@if (!Model.Any())
{
    <div class="card dashboard-card p-5 text-center">
        <div class="text-muted mb-3">
            <i class="fa-solid fa-book-bookmark fs-1 text-secondary opacity-50"></i>
        </div>
        <h5 class="fw-bold text-dark">No Courses Created</h5>
        <p class="text-muted small">You haven't created any courses yet. Click the button above to create your first course!</p>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var course in Model)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <a asp-action="Details" asp-route-id="@course.Id" class="text-decoration-none">
                    <div class="card dashboard-card course-card h-100 p-3">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <div class="icon-shape bg-success bg-opacity-10 text-success">
                                        <i class="fa-solid fa-book-bookmark"></i>
                                    </div>
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-2 fs-7 fw-semibold">
                                        @course.CourseLevel
                                    </span>
                                </div>

                                <h5 class="fw-bold text-dark mb-2 course-title">
                                    @course.CourseName
                                </h5>

                                @if (!string.IsNullOrWhiteSpace(course.CourseDescription))
                                {
                                    <p class="text-muted small text-truncate-2 mb-0">
                                        @course.CourseDescription
                                    </p>
                                }
                            </div>

                            <div class="pt-3 mt-3 border-top d-flex justify-content-between align-items-center text-success fw-medium small course-footer">
                                <span>Manage Course</span>
                                <i class="fa-solid fa-arrow-right transition-icon"></i>
                            </div>
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}

<style>
    .course-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border: 1px solid #e9ecef !important;
    }

        .course-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08) !important;
        }

            .course-card:hover .course-title {
                color: #198754 !important;
            }

            .course-card:hover .transition-icon {
                transform: translateX(4px);
            }

    .transition-icon {
        transition: transform 0.2s ease;
    }

    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>