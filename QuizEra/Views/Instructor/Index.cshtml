@model QuizEra.BLL.ModelVM.Administration.InstructorDashboardVM

@{
    ViewData["Title"] = "Instructor Home";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<div class="container-fluid py-4 px-md-4">
    <!-- Header Section -->
    <div class="mb-4">
        <p class="text-muted small fw-semibold text-uppercase mb-1 tracking-wide">Pages / Dashboard</p>
        <h2 class="fw-bold text-dark m-0">Instructor Dashboard</h2>
        <p class="text-muted small mb-0 mt-1">Real-time stats and management overview for your courses.</p>
    </div>

    <!-- Stats Overview Section -->
    <div class="row g-3 mb-5">
        <!-- Assigned Courses Card -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-2">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted text-uppercase fw-bold fs-7 tracking-wider d-block mb-2">Assigned Courses</span>
                        <h2 class="display-6 fw-extrabold text-dark mb-0">@(Model?.AssignedCoursesCount ?? 0)</h2>
                    </div>
                    <div class="rounded-4 p-3 d-flex align-items-center justify-content-center bg-purple-subtle text-purple icon-shape">
                        <i class="fa-solid fa-book-open fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Exams Card -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-2">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted text-uppercase fw-bold fs-7 tracking-wider d-block mb-2">Total Exams</span>
                        <h2 class="display-6 fw-extrabold text-dark mb-0">@(Model?.TotalExamsCount ?? 0)</h2>
                    </div>
                    <div class="rounded-4 p-3 d-flex align-items-center justify-content-center bg-purple-subtle text-purple icon-shape">
                        <i class="fa-solid fa-file-pen fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Enrolled Students Card -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 p-2">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted text-uppercase fw-bold fs-7 tracking-wider d-block mb-2">Enrolled Students</span>
                        <h2 class="display-6 fw-extrabold text-dark mb-0">@(Model?.EnrolledStudentsCount ?? 0)</h2>
                    </div>
                    <div class="rounded-4 p-3 d-flex align-items-center justify-content-center bg-purple-subtle text-purple icon-shape">
                        <i class="fa-solid fa-graduation-cap fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions Section -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h4 class="fw-bold text-dark m-0">Quick Management</h4>
    </div>

    <div class="row g-4">
        <!-- Manage Courses Card -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 card-action">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-3 p-2.5 d-flex align-items-center justify-content-center bg-purple-subtle text-purple icon-box">
                                <i class="fa-solid fa-book-bookmark fs-5"></i>
                            </div>
                            <h5 class="fw-bold text-dark m-0">My Courses</h5>
                        </div>
                        <p class="text-muted small mb-4">View and manage all your assigned courses, topics, and study content.</p>
                    </div>
                    <a asp-controller="Instructor" asp-action="Courses" class="btn btn-purple-solid rounded-3 w-100 fw-semibold d-flex align-items-center justify-content-center gap-2">
                        <span>View Courses</span>
                        <i class="fa-solid fa-arrow-right fs-7"></i>
                    </a>
                </div>
            </div>
        </div>

        <!-- Manage Exams Card -->
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 h-100 card-action">
                <div class="card-body p-4 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="rounded-3 p-2.5 d-flex align-items-center justify-content-center bg-purple-subtle text-purple icon-box">
                                <i class="fa-solid fa-file-circle-plus fs-5"></i>
                            </div>
                            <h5 class="fw-bold text-dark m-0">Exam Management</h5>
                        </div>
                        <p class="text-muted small mb-4">Create, edit, setup timers, and assign exams to your course topics.</p>
                    </div>
                    <a asp-controller="Exam" asp-action="Index" class="btn btn-purple-soft rounded-3 w-100 fw-semibold d-flex align-items-center justify-content-center gap-2">
                        <span>Manage Exams</span>
                        <i class="fa-solid fa-arrow-right fs-7"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .fs-7 {
        font-size: 0.75rem;
    }

    .tracking-wide {
        letter-spacing: 0.05em;
    }

    .tracking-wider {
        letter-spacing: 0.08em;
    }

    .fw-extrabold {
        font-weight: 800;
    }

    .icon-shape {
        width: 56px;
        height: 56px;
    }

    .icon-box {
        width: 48px;
        height: 48px;
    }

    /* Unified Theme Colors */
    .bg-purple-subtle {
        background-color: rgba(111, 66, 193, 0.1) !important;
    }

    .text-purple {
        color: #6f42c1 !important;
    }

    .card-action {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .card-action:hover {
            transform: translateY(-3px);
            box-shadow: 0 0.5rem 1.2rem rgba(111, 66, 193, 0.12) !important;
        }

    /* Solid Primary Purple Button */
    .btn-purple-solid {
        background-color: #6f42c1;
        color: #ffffff;
        border: none;
        transition: all 0.2s ease;
    }

        .btn-purple-solid:hover {
            background-color: #5a2898;
            color: #ffffff;
        }

    /* Soft Purple Secondary Buttons */
    .btn-purple-soft {
        background-color: rgba(111, 66, 193, 0.08);
        color: #6f42c1;
        border: 1px solid rgba(111, 66, 193, 0.18);
        transition: all 0.2s ease;
    }

        .btn-purple-soft:hover {
            background-color: #6f42c1;
            color: #ffffff;
            border-color: #6f42c1;
        }
</style>