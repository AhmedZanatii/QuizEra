@{
    ViewData["Title"] = "Instructor Home";
    Layout = "~/Views/Shared/_InstructorLayout.cshtml";
}

<div class="row justify-content-center my-4">
    <div class="col-md-9 col-lg-8">
        <div class="card dashboard-card p-5 text-center">
            <div class="card-body">
                <div class="mb-4">
                    <div class="icon-shape bg-success bg-opacity-10 text-success mx-auto" style="width: 80px; height: 80px; font-size: 2.5rem; border-radius: 50%;">
                        <i class="fa-solid fa-chalkboard-user"></i>
                    </div>
                </div>

                <h2 class="fw-bold text-dark mb-2">Welcome to QuizEra!</h2>
                <span class="badge bg-success bg-opacity-10 text-success fs-6 px-3 py-2 rounded-pill mb-3">Instructor Portal</span>

                <p class="text-muted fs-5 mb-4">
                    Create courses, manage exams, and track student learning progress effectively.
                </p>

                
            </div>
        </div>
    </div>
</div>